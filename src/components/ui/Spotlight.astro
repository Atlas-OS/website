---
import { Icon } from 'astro-icon/components';
---

<div
  id="spotlight-backdrop"
  class="pointer-events-none fixed inset-0 z-[100] bg-black/70 opacity-0 backdrop-blur-sm"
  style="transition: opacity var(--motion-duration-normal) var(--motion-ease-out);"
  aria-hidden="true"
>
</div>

<div
  id="spotlight-modal"
  class="pointer-events-none fixed top-[20%] left-1/2 z-[101] flex w-[90vw] max-w-xl flex-col overflow-hidden rounded-2xl border border-white/[0.07] opacity-0 shadow-2xl shadow-black/50"
  role="dialog"
  aria-modal="true"
  aria-labelledby="spotlight-title"
  style="background-color: var(--bg-primary); max-height: min(520px, 80vh);"
>
  <h2 id="spotlight-title" class="sr-only">Search documentation</h2>

  <div
    id="spotlight-input-container"
    class="flex flex-shrink-0 cursor-text items-center gap-3 px-5 py-4"
  >
    <Icon name="tabler:search" class="h-[18px] w-[18px] flex-shrink-0 text-white/35" aria-hidden="true" />
    <input
      type="text"
      id="spotlight-input"
      aria-describedby="spotlight-title"
      class="flex-1 bg-transparent text-[15px] text-white/90 placeholder:text-white/30 focus:ring-0 focus:outline-none"
      placeholder="Search documentation..."
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
    />
    <label for="spotlight-input" class="sr-only">Search documentation</label>
    <kbd
      class="hidden flex-shrink-0 items-center rounded-md border border-white/[0.06] bg-white/[0.04] px-2 py-1 font-mono text-xs text-white/35 sm:inline-flex"
    >
      Esc
    </kbd>
  </div>

  <div class="h-px w-full flex-shrink-0 bg-white/[0.06]"></div>

  <div id="spotlight-results" class="min-h-0 flex-1 overflow-y-auto">

    <div id="spotlight-idle" class="flex flex-col items-center justify-center px-6 py-10 text-center">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl border border-white/[0.06] bg-white/[0.03]">
        <Icon name="tabler:book" class="h-5 w-5 text-white/25" aria-hidden="true" />
      </div>
      <p class="text-sm font-medium text-white/40">Search the docs</p>
      <p class="mt-1 text-xs text-white/20">Pages, guides, and reference</p>
    </div>

    <div id="spotlight-empty" class="hidden px-6 py-10 text-center">
      <p class="text-sm text-white/40">No results found</p>
      <p class="mt-1 text-xs text-white/20">Try a different search term</p>
    </div>

    <div id="spotlight-loading" class="hidden flex items-center justify-center gap-2.5 px-6 py-10 text-sm text-white/35">
      <span class="loading-spinner h-4 w-4 flex-shrink-0" aria-hidden="true"></span>
      <span>Searching&hellip;</span>
    </div>

    <ul id="spotlight-list" class="py-2" style="list-style: none; padding-top: 0.5rem; padding-bottom: 0.5rem; margin: 0;"></ul>
  </div>

  <div id="spotlight-footer" class="hidden flex-shrink-0 border-t border-white/[0.06] px-5 py-2.5">
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1.5 text-xs text-white/25">
        <kbd class="rounded border border-white/[0.08] bg-white/[0.04] px-1.5 py-0.5 font-mono text-[10px]">↑↓</kbd>
        Navigate
      </span>
      <span class="flex items-center gap-1.5 text-xs text-white/25">
        <kbd class="rounded border border-white/[0.08] bg-white/[0.04] px-1.5 py-0.5 font-mono text-[10px]">↵</kbd>
        Open
      </span>
      <span class="flex items-center gap-1.5 text-xs text-white/25">
        <kbd class="rounded border border-white/[0.08] bg-white/[0.04] px-1.5 py-0.5 font-mono text-[10px]">Esc</kbd>
        Close
      </span>
    </div>
  </div>
</div>

<style is:global>
  #spotlight-modal {
    transform: translate(-50%, 0) scale(0.97);
    filter: blur(6px);
    will-change: transform, opacity, filter;
    transition:
      opacity var(--motion-duration-normal) var(--motion-ease-out),
      transform var(--motion-duration-normal) var(--motion-ease-out),
      filter var(--motion-duration-normal) var(--motion-ease-out);
  }

  #spotlight-modal.open {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0) scale(1);
    filter: blur(0);
  }

  #spotlight-backdrop {
    transition: opacity var(--motion-duration-normal) var(--motion-ease-out);
  }

  #spotlight-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  #spotlight-list {
    list-style: none !important;
    padding: 0.5rem !important;
    margin: 0 !important;
  }

  #spotlight-results {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.07) transparent;
  }
  #spotlight-results::-webkit-scrollbar { width: 4px; }
  #spotlight-results::-webkit-scrollbar-track { background: transparent; }
  #spotlight-results::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 2px;
  }

  .spotlight-item {
    display: flex !important;
    align-items: center !important;
    gap: 0.75rem !important;
    padding: 0.625rem 0.875rem !important;
    border-radius: 0.625rem !important;
    cursor: pointer !important;
    list-style: none !important;
    margin: 0 !important;
    width: 100% !important;
    box-sizing: border-box !important;
    background-color: transparent !important;
    border: 1px solid transparent !important;
    transition: background-color 120ms ease, border-color 120ms ease !important;
  }

  .spotlight-item:hover {
    background-color: rgb(255 255 255 / 0.04) !important;
    border-color: rgb(255 255 255 / 0.05) !important;
  }

  .spotlight-item.selected {
    background-color: rgb(255 255 255 / 0.06) !important;
    border-color: rgb(255 255 255 / 0.07) !important;
  }

  .spotlight-item-icon {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
    width: 2rem !important;
    height: 2rem !important;
    border-radius: 0.5rem !important;
    border: 1px solid rgb(255 255 255 / 0.06) !important;
    background-color: rgb(255 255 255 / 0.03) !important;
    color: rgb(255 255 255 / 0.35) !important;
  }

  .spotlight-item.selected .spotlight-item-icon {
    border-color: var(--color-primary, #3b82f6) !important;
    background-color: color-mix(in oklch, var(--color-primary, #3b82f6) 10%, transparent) !important;
    color: var(--color-primary, #3b82f6) !important;
  }

  .spotlight-item-body {
    flex: 1 !important;
    min-width: 0 !important;
  }

  .spotlight-item-title {
    font-size: 0.8125rem !important;
    font-weight: 500 !important;
    color: rgb(255 255 255 / 0.85) !important;
    line-height: 1.4 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    margin: 0 !important;
  }

  .spotlight-item-path {
    font-size: 0.6875rem !important;
    color: rgb(255 255 255 / 0.3) !important;
    font-family: var(--font-mono, monospace) !important;
    line-height: 1.4 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    margin-top: 0.125rem !important;
    margin-bottom: 0 !important;
  }

  .spotlight-item-arrow {
    flex-shrink: 0 !important;
    color: rgb(255 255 255 / 0) !important;
    transition: color 120ms ease !important;
    width: 0.875rem !important;
    height: 0.875rem !important;
  }

  .spotlight-item.selected .spotlight-item-arrow {
    color: rgb(255 255 255 / 0.3) !important;
  }

  #spotlight-input {
    outline: none !important;
    border: none !important;
    background: transparent !important;
  }

  #spotlight-input:focus {
    outline: none !important;
    border: none !important;
    box-shadow: none !important;
  }

  #spotlight-input::placeholder {
    color: rgb(255 255 255 / 0.28);
  }

  @media (prefers-reduced-motion: reduce) {
    #spotlight-modal,
    #spotlight-backdrop {
      transition: none;
    }
  }
</style>

<script>
  interface AstroNavigation {
    navigate: (url: string) => void;
  }

  interface WindowWithAstro extends Window {
    astro?: AstroNavigation;
  }

  interface PagefindResult {
    id: string;
    data: () => Promise<PagefindResultData>;
  }

  interface PagefindResultData {
    url: string;
    content: string;
    excerpt: string;
    meta: {
      title?: string;
      image?: string;
    };
    sub_results?: Array<{
      url: string;
      title: string;
      excerpt: string;
    }>;
  }

  interface PagefindSearchResponse {
    results: PagefindResult[];
  }

  interface Pagefind {
    init: () => Promise<void>;
    search: (query: string) => Promise<PagefindSearchResponse>;
  }

  interface SearchResult {
    url: string;
    title: string;
    excerpt: string;
  }

  let pagefind: Pagefind | null = null;
  let selectedIndex = -1;
  let searchDebounceTimer: ReturnType<typeof setTimeout> | null = null;
  let currentQuery = '';

  async function loadPagefind(): Promise<Pagefind | null> {
    if (pagefind) return pagefind;

    try {
      const pagefindPath = '/pagefind/pagefind.js';
      const importPagefind = (modulePath: string): Promise<unknown> =>
        import(/* @vite-ignore */ modulePath);

      const pf = (await importPagefind(pagefindPath)) as Pagefind;
      await pf.init();
      pagefind = pf;
      return pagefind;
    } catch {
      console.warn('Pagefind not available - search index may not be built yet');
      return null;
    }
  }

  function openSpotlight() {
    const modal = document.getElementById('spotlight-modal');
    const backdrop = document.getElementById('spotlight-backdrop');
    const input = document.getElementById('spotlight-input') as HTMLInputElement;

    if (modal && backdrop && input) {
      modal.classList.add('open');
      backdrop.classList.add('open');
      backdrop.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      setTimeout(() => input.focus(), 80);
    }
  }

  function closeSpotlight() {
    const modal = document.getElementById('spotlight-modal');
    const backdrop = document.getElementById('spotlight-backdrop');
    const input = document.getElementById('spotlight-input') as HTMLInputElement;

    if (modal && backdrop && input) {
      modal.classList.remove('open');
      backdrop.classList.remove('open');
      backdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      input.value = '';
      selectedIndex = -1;
      currentQuery = '';
      renderResults([], false);
    }
  }

  function setIdleVisible(visible: boolean) {
    const idle = document.getElementById('spotlight-idle');
    if (idle) idle.classList.toggle('hidden', !visible);
  }

  function setFooterVisible(visible: boolean) {
    const footer = document.getElementById('spotlight-footer');
    if (footer) footer.classList.toggle('hidden', !visible);
  }

  function showLoading() {
    const list = document.getElementById('spotlight-list');
    const empty = document.getElementById('spotlight-empty');
    const loading = document.getElementById('spotlight-loading');

    if (list) list.innerHTML = '';
    if (empty) empty.classList.add('hidden');
    if (loading) loading.classList.remove('hidden');
    setIdleVisible(false);
    setFooterVisible(false);
  }

  function hideLoading() {
    const loading = document.getElementById('spotlight-loading');
    if (loading) loading.classList.add('hidden');
  }

  async function search(query: string) {
    currentQuery = query;

    if (!query.trim()) {
      renderResults([], false);
      return;
    }

    showLoading();

    const pf = await loadPagefind();
    if (!pf) {
      hideLoading();
      renderResults([], true);
      return;
    }

    if (query !== currentQuery) return;

    try {
      const searchResponse = await pf.search(query);

      if (query !== currentQuery) return;

      const resultsData = await Promise.all(searchResponse.results.slice(0, 10).map((r) => r.data()));

      if (query !== currentQuery) return;

      const results: SearchResult[] = resultsData.map((data) => ({
        url: data.url,
        title: data.meta?.title || extractTitleFromUrl(data.url),
        excerpt: data.excerpt || '',
      }));

      renderResults(results, true);
    } catch {
      hideLoading();
      renderResults([], true);
    }
  }

  function extractTitleFromUrl(url: string): string {
    const path = url.replace(/^\//, '').replace(/\/$/, '');
    if (!path) return 'Home';
    const segments = path.split('/');
    const last = segments[segments.length - 1] ?? '';
    if (!last) return 'Home';
    return last
      .split('-')
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');
  }

  function debouncedSearch(query: string) {
    if (searchDebounceTimer) clearTimeout(searchDebounceTimer);

    if (!query.trim()) {
      renderResults([], false);
      return;
    }

    searchDebounceTimer = setTimeout(() => search(query), 150);
  }

  const PAGE_ICON_SVG = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/></svg>`;

  const ARROW_ICON_SVG = `<svg class="spotlight-item-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 6l6 6l-6 6"/></svg>`;

  function renderResults(results: SearchResult[], hasQuery: boolean) {
    const list = document.getElementById('spotlight-list');
    const empty = document.getElementById('spotlight-empty');

    if (!list || !empty) return;

    hideLoading();

    if (results.length === 0) {
      list.innerHTML = '';
      selectedIndex = -1;
      setIdleVisible(!hasQuery);
      setFooterVisible(false);
      if (hasQuery) {
        empty.classList.remove('hidden');
      } else {
        empty.classList.add('hidden');
      }
      return;
    }

    empty.classList.add('hidden');
    setIdleVisible(false);
    setFooterVisible(true);

    list.innerHTML = results
      .map((result, index) => {
        const path = '/' + (result.url.replace(/^\//, '').replace(/\/$/, '') || '');
        return `
          <li class="spotlight-item ${index === selectedIndex ? 'selected' : ''}" data-index="${index}" data-url="${result.url}">
            <div class="spotlight-item-icon">${PAGE_ICON_SVG}</div>
            <div class="spotlight-item-body">
              <p class="spotlight-item-title">${escapeHtml(result.title)}</p>
              <p class="spotlight-item-path">${escapeHtml(path)}</p>
            </div>
            ${ARROW_ICON_SVG}
          </li>
        `;
      })
      .join('');

    list.querySelectorAll('.spotlight-item').forEach((item) => {
      const el = item as HTMLElement;
      el.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const url = el.getAttribute('data-url');
        if (url) {
          closeSpotlight();
          if ((window as WindowWithAstro).astro?.navigate) {
            (window as WindowWithAstro).astro?.navigate(url);
          } else {
            window.location.href = url;
          }
        }
      });
      el.addEventListener('mousedown', (e) => e.preventDefault());
    });
  }

  function escapeHtml(text: string): string {
    const map: Record<string, string> = {
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;',
    };
    return text.replace(/[&<>"']/g, (m) => map[m] ?? m);
  }

  function navigateResults(direction: 'up' | 'down') {
    const items = document.querySelectorAll('.spotlight-item');
    if (items.length === 0) return;

    items[selectedIndex]?.classList.remove('selected');

    if (direction === 'down') {
      selectedIndex = (selectedIndex + 1) % items.length;
    } else {
      selectedIndex = selectedIndex <= 0 ? items.length - 1 : selectedIndex - 1;
    }

    const target = items[selectedIndex];
    target?.classList.add('selected');
    target?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }

  function selectCurrentResult() {
    const items = document.querySelectorAll('.spotlight-item');
    if (selectedIndex >= 0 && selectedIndex < items.length) {
      const url = items[selectedIndex]?.getAttribute('data-url');
      if (url) {
        closeSpotlight();
        if ((window as WindowWithAstro).astro?.navigate) {
          (window as WindowWithAstro).astro?.navigate(url);
        } else {
          window.location.href = url;
        }
      }
    }
  }

  function setupSpotlight() {
    const searchButton = document.getElementById('navbar-search-button');
    const searchButtonMobile = document.getElementById('navbar-search-button-mobile');
    const input = document.getElementById('spotlight-input') as HTMLInputElement | null;
    const inputContainer = document.getElementById('spotlight-input-container');
    const backdrop = document.getElementById('spotlight-backdrop');

    searchButton?.addEventListener('click', openSpotlight);
    searchButtonMobile?.addEventListener('click', openSpotlight);

    if (inputContainer && input) {
      inputContainer.addEventListener('click', (e) => {
        if (e.target !== input) input.focus();
      });
    }

    if (input) {
      input.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        debouncedSearch(target.value);
        selectedIndex = -1;
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); navigateResults('down'); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); navigateResults('up'); }
        else if (e.key === 'Enter') { e.preventDefault(); selectCurrentResult(); }
      });
    }

    backdrop?.addEventListener('click', closeSpotlight);
  }

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      const modal = document.getElementById('spotlight-modal');
      modal?.classList.contains('open') ? closeSpotlight() : openSpotlight();
    }
    if (e.key === 'Escape') {
      const modal = document.getElementById('spotlight-modal');
      if (modal?.classList.contains('open')) closeSpotlight();
    }
  });

  document.addEventListener('astro:page-load', setupSpotlight);
  setupSpotlight();
</script>
