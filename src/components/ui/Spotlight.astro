---
import { Icon } from 'astro-icon/components';
---

<div
  id="spotlight-backdrop"
  class="pointer-events-none fixed inset-0 z-[100] bg-black/70 opacity-0 backdrop-blur-sm"
  aria-hidden="true"
></div>

<div
  id="spotlight-modal"
  class="pointer-events-none fixed top-[20%] left-1/2 z-[101] flex w-[90vw] max-w-xl flex-col overflow-hidden rounded-2xl border border-white/[0.07] bg-[var(--bg-primary)] opacity-0 shadow-2xl shadow-black/50"
  role="dialog"
  aria-modal="true"
  aria-labelledby="spotlight-title"
  aria-hidden="true"
  inert
  style="max-height: min(520px, 80vh);"
>
  <h2 id="spotlight-title" class="sr-only">
    Search documentation
  </h2>

  <div id="spotlight-input-container" class="flex flex-shrink-0 cursor-text items-center gap-3 px-5 py-4">
    <Icon name="tabler:search" class="h-[18px] w-[18px] flex-shrink-0 text-white/55" aria-hidden="true" />
    <label for="spotlight-input" class="sr-only">
      Search documentation
    </label>
    <input
      type="text"
      id="spotlight-input"
      role="combobox"
      aria-autocomplete="list"
      aria-controls="spotlight-list"
      aria-expanded="false"
      class="flex-1 border-none bg-transparent text-base text-white/90 shadow-none outline-none placeholder:text-white/45 focus:ring-0 focus:outline-none sm:text-[15px]"
      placeholder="Search documentation…"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
    />
    <kbd class="hidden flex-shrink-0 items-center rounded-md border border-white/[0.08] bg-white/[0.04] px-2 py-1 font-mono text-xs text-white/55 sm:inline-flex">
      Esc
    </kbd>
  </div>

  <div class="h-px w-full flex-shrink-0 bg-white/[0.06]"></div>

  <div id="spotlight-results" class="min-h-0 flex-1 overflow-y-auto">
    <div id="spotlight-idle" class="flex flex-col items-center justify-center px-6 py-10 text-center">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl border border-white/[0.06] bg-white/[0.03]">
        <Icon name="tabler:book" class="h-5 w-5 text-white/50" aria-hidden="true" />
      </div>
      <p class="text-sm font-medium text-white/70">Search the docs</p>
      <p class="mt-1 text-xs text-white/45">Pages, guides, and reference</p>
    </div>

    <div id="spotlight-empty" class="hidden px-6 py-10 text-center">
      <div role="status" aria-live="polite">
        <p class="text-sm text-white/70">
          No results for “<span id="spotlight-empty-query"></span>”
        </p>
        <p class="mt-1 text-xs text-white/45">Try another search term.</p>
      </div>
      <button
        type="button"
        id="spotlight-clear-search"
        class="mt-4 inline-flex min-h-10 items-center justify-center rounded-md bg-white/[0.05] px-3 text-sm font-medium text-white/70 transition-[background-color,color,scale] duration-150 hover:bg-white/[0.08] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-[0.96]"
      >
        Clear search
      </button>
    </div>

    <div
      id="spotlight-loading"
      class="hidden items-center justify-center gap-2.5 px-6 py-10 text-sm text-white/60 [&:not(.hidden)]:flex"
      role="status"
      aria-live="polite"
    >
      <span class="loading-spinner h-4 w-4 flex-shrink-0" aria-hidden="true"></span>
      <span>Searching&hellip;</span>
    </div>

    <ul id="spotlight-list" class="m-0 list-none p-2" role="listbox" aria-label="Search results"></ul>
  </div>

  <div id="spotlight-footer" class="hidden flex-shrink-0 border-t border-white/[0.06] px-5 py-2.5">
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1.5 text-xs text-white/50">
        <kbd class="rounded border border-white/[0.08] bg-white/[0.04] px-1.5 py-0.5 font-mono text-[10px]">↑↓</kbd>
        Navigate
      </span>
      <span class="flex items-center gap-1.5 text-xs text-white/50">
        <kbd class="rounded border border-white/[0.08] bg-white/[0.04] px-1.5 py-0.5 font-mono text-[10px]">↵</kbd>
        Open
      </span>
      <span class="flex items-center gap-1.5 text-xs text-white/50">
        <kbd class="rounded border border-white/[0.08] bg-white/[0.04] px-1.5 py-0.5 font-mono text-[10px]">Esc</kbd>
        Close
      </span>
    </div>
  </div>
</div>

<style is:global>
  #spotlight-modal {
    transform: translate(-50%, 0) scale(0.97);
    filter: blur(6px);
    transition:
      opacity var(--motion-duration-normal) var(--motion-ease-out),
      transform var(--motion-duration-normal) var(--motion-ease-out),
      filter var(--motion-duration-normal) var(--motion-ease-out);
  }

  #spotlight-modal.open {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0) scale(1);
    filter: blur(0);
  }

  #spotlight-backdrop {
    transition: opacity var(--motion-duration-normal) var(--motion-ease-out);
  }

  #spotlight-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  #spotlight-results {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.07) transparent;
  }

  #spotlight-results::-webkit-scrollbar {
    width: 4px;
  }

  #spotlight-results::-webkit-scrollbar-track {
    background: transparent;
  }

  #spotlight-results::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 2px;
  }

  .spotlight-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.625rem 0.875rem;
    border: 1px solid transparent;
    border-radius: 0.625rem;
    cursor: pointer;
    transition:
      background-color 120ms ease,
      border-color 120ms ease;
  }

  .spotlight-item:hover {
    background-color: rgb(255 255 255 / 0.04);
    border-color: rgb(255 255 255 / 0.05);
  }

  .spotlight-item.selected {
    background-color: rgb(255 255 255 / 0.06);
    border-color: rgb(255 255 255 / 0.07);
  }

  .spotlight-item-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.06);
    background-color: rgb(255 255 255 / 0.03);
    color: rgb(255 255 255 / 0.5);
  }

  .spotlight-item-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .spotlight-item.selected .spotlight-item-icon {
    border-color: var(--color-primary);
    background-color: color-mix(in oklch, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
  }

  .spotlight-item-body {
    flex: 1;
    min-width: 0;
  }

  .spotlight-item-title,
  .spotlight-item-path {
    margin: 0;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .spotlight-item-title {
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgb(255 255 255 / 0.85);
  }

  .spotlight-item-path {
    margin-top: 0.125rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: rgb(255 255 255 / 0.48);
  }

  .spotlight-item-arrow {
    flex-shrink: 0;
    width: 0.875rem;
    height: 0.875rem;
    color: transparent;
    transition: color 120ms ease;
  }

  .spotlight-item.selected .spotlight-item-arrow {
    color: rgb(255 255 255 / 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    #spotlight-modal,
    #spotlight-backdrop {
      transition: none;
    }
  }
</style>

<script>
  import { onPageLoad } from '@/utils/page-lifecycle';
  import { initSpotlight } from '@/utils/spotlight';

  onPageLoad(initSpotlight);
</script>
