---
import { Image as AstroImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'sync' | 'async' | 'auto';
  priority?: boolean;
  outlined?: boolean;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading: providedLoading,
  priority = false,
  fetchpriority: providedFetchpriority,
  decoding: providedDecoding,
  outlined = false,
  class: className = '',
} = Astro.props;

const isStringSrc = typeof src === 'string';
const hasDimensions = width && height;
const classes = [outlined && 'media-outline', className].filter(Boolean).join(' ');

const rawLoading = providedLoading ?? (priority ? 'eager' : 'lazy');
const rawDecoding = providedDecoding ?? (priority ? 'sync' : 'async');
const rawFetchpriority = providedFetchpriority ?? (priority || rawLoading === 'eager' ? 'high' : undefined);
const optimizedLoading = priority ? providedLoading : (providedLoading ?? 'lazy');
const optimizedDecoding = priority ? providedDecoding : (providedDecoding ?? 'async');
const optimizedFetchpriority =
  providedFetchpriority ?? (!priority && optimizedLoading === 'eager' ? 'high' : undefined);
---

{
  isStringSrc ? (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={rawLoading}
      decoding={rawDecoding}
      class={classes}
      {...(rawFetchpriority && { fetchpriority: rawFetchpriority })}
      {...(hasDimensions && { style: `aspect-ratio: ${width} / ${height}` })}
    />
  ) : (
    <AstroImage
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={optimizedLoading}
      priority={priority}
      decoding={optimizedDecoding}
      class={classes}
      {...(optimizedFetchpriority && { fetchpriority: optimizedFetchpriority })}
      {...(hasDimensions && { style: `aspect-ratio: ${width} / ${height}` })}
    />
  )
}
