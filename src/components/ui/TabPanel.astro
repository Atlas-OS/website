---
interface Props {
  group: string;
  value: string;
  label: string;
}

const { group, value, label } = Astro.props;
---

<div
  id={`${group}-panel-${value}`}
  data-tab-panel={value}
  role="tabpanel"
  aria-labelledby={`${group}-tab-${value}`}
  tabindex="0"
>
  <h4 class="tab-panel-label">{label}</h4>
  <slot />
</div>

<style>
  :global([data-enhanced]) .tab-panel-label {
    display: none;
  }
</style>
