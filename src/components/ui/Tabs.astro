---
import { stableId } from '@/utils/stable-id';

interface Props {
  items: Array<{ label: string; value: string }>;
  defaultTab?: string;
  /** Override the generated id when the same tab set appears more than once on a page. */
  id?: string;
}

const { items, defaultTab = items[0]?.value ?? '', id } = Astro.props;
const tabsId = id ?? stableId('tabs', ...items.map((item) => item.value));
---

<div class="tabs-container" data-tabs-id={tabsId} data-default-tab={defaultTab}>
  <div
    class="tabs-list mb-4 flex flex-nowrap gap-2 overflow-x-auto border-b border-[var(--docs-surface-border)]"
    role="tablist"
  >
    {items.map((item) => (
      <button
        type="button"
        role="tab"
        id={`${tabsId}-tab-${item.value}`}
        data-tab={item.value}
        aria-controls={`${tabsId}-panel-${item.value}`}
        aria-selected={item.value === defaultTab ? 'true' : 'false'}
        tabindex={item.value === defaultTab ? 0 : -1}
        class="tab-button min-h-10 shrink-0 cursor-pointer border-b-2 border-transparent px-4 py-2 text-sm font-medium text-white/60 transition-[border-color,color] duration-200 outline-none hover:text-white/85 focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-black focus-visible:outline-none aria-selected:border-primary aria-selected:text-primary"
      >
        {item.label}
      </button>
    ))}
  </div>

  <div class="tab-content">
    <slot />
  </div>
</div>

<script>
  import { onPageLoad } from '@/utils/page-lifecycle';

  function initTabs(container: HTMLElement, signal: AbortSignal) {
    const tabsId = container.dataset.tabsId;
    if (!tabsId) return;

    const tabs = [...container.querySelectorAll<HTMLButtonElement>(':scope > .tabs-list > [role="tab"]')];
    const panels = [...container.querySelectorAll<HTMLElement>(':scope > .tab-content > [data-tab-panel]')];

    for (const panel of panels) {
      const value = panel.dataset.tabPanel;
      if (!value) continue;
      panel.id = `${tabsId}-panel-${value}`;
      panel.setAttribute('aria-labelledby', `${tabsId}-tab-${value}`);
      panel.tabIndex = 0;
    }

    function select(value: string, focus = false) {
      for (const tab of tabs) {
        const isSelected = tab.dataset.tab === value;
        tab.setAttribute('aria-selected', String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;
        if (isSelected && focus) tab.focus();
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.tabPanel !== value;
      }
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => tab.dataset.tab && select(tab.dataset.tab), { signal });

      tab.addEventListener(
        'keydown',
        (event) => {
          const last = tabs.length - 1;
          const nextIndex = {
            ArrowRight: index === last ? 0 : index + 1,
            ArrowLeft: index === 0 ? last : index - 1,
            Home: 0,
            End: last,
          }[event.key];
          if (nextIndex === undefined) return;

          event.preventDefault();
          const next = tabs[nextIndex]?.dataset.tab;
          if (next) select(next, true);
        },
        { signal }
      );
    });

    select(container.dataset.defaultTab ?? tabs[0]?.dataset.tab ?? '');
  }

  onPageLoad((signal) => {
    for (const container of document.querySelectorAll<HTMLElement>('.tabs-container')) {
      initTabs(container, signal);
    }
  });
</script>

<style>
  .tabs-list {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
  }

  .tabs-list::-webkit-scrollbar {
    height: 6px;
  }

  .tabs-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .tabs-list::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
  }

  .tabs-list::-webkit-scrollbar-thumb:hover {
    background-color: rgba(255, 255, 255, 0.2);
  }
</style>
