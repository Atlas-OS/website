---
import { Icon } from 'astro-icon/components';

interface Props {
  id?: string;
  mobile?: boolean;
  class?: string;
}

const { id, mobile = false, class: className = '' } = Astro.props;
---

{mobile ? (
  <button
    id={id || 'navbar-search-button-mobile'}
    type="button"
    aria-label="Search"
    aria-expanded="false"
    aria-haspopup="dialog"
    class={`inline-flex size-10 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap text-white border border-white/[0.08] transition-[background-color,border-color,opacity,scale] duration-200 outline-none hover:bg-white/[0.04] hover:opacity-80 hover:border-white/[0.14] active:scale-[0.96] disabled:pointer-events-none disabled:opacity-50 sm:hidden ${className}`}
  >
    <Icon name="tabler:search" class="h-5 w-5" aria-hidden="true" />
  </button>
) : (
  <div class={`hidden sm:block ${className}`}>
    <div class="relative">
      <button
        id={id || 'navbar-search-button'}
        type="button"
        aria-expanded="false"
        aria-haspopup="dialog"
        class="bg-background relative min-h-10 w-64 cursor-pointer items-center rounded-md pr-4 pl-9 text-left text-sm text-white/60 border border-white/[0.08] transition-[background-color,border-color,opacity,scale] duration-200 hover:bg-white/[0.03] hover:opacity-80 hover:border-white/[0.14] focus:outline-none active:scale-[0.96]"
      >
        <Icon
          name="tabler:search"
          class="absolute top-1/2 left-3 size-[14px] -translate-y-1/2 text-white/60"
          aria-hidden="true"
        />
        <span class="mt-[1px] block max-w-full truncate text-sm text-white/70">Search docs…</span>
        <kbd class="absolute top-1/2 right-2 hidden -translate-y-1/2 items-center gap-1 rounded-md bg-white/5 px-2 py-1 font-mono text-xs text-white/65 border border-white/[0.08] xl:inline-flex">
          <span>Ctrl</span>
          <span class="text-white/30">+</span>
          <span>K</span>
        </kbd>
      </button>
    </div>
  </div>
)}
