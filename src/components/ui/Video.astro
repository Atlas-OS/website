---
interface Props {
  src: string;
  tracks?: Array<{
    src: string;
    kind?: 'subtitles' | 'captions' | 'descriptions' | 'chapters' | 'metadata';
    srclang?: string;
    label?: string;
    default?: boolean;
  }>;
  controls?: boolean;
  muted?: boolean;
  autoplay?: boolean;
  loop?: boolean;
  preload?: 'none' | 'metadata' | 'auto';
  spacing?: boolean;
  rounded?: boolean;
  class?: string;
}

const {
  src,
  tracks = [],
  controls = true,
  muted = false,
  autoplay = false,
  loop = false,
  preload = 'metadata',
  spacing = false,
  rounded = false,
  class: className = '',
} = Astro.props;

const classes = [spacing && 'my-6', rounded && 'rounded-lg', 'media-outline', className].filter(Boolean).join(' ');
---

<video
  src={src}
  controls={controls}
  muted={muted}
  autoplay={autoplay}
  loop={loop}
  class={classes}
  preload={preload}
  data-video-player
>
  {
    tracks.map((track) => (
      <track
        src={track.src}
        kind={track.kind || 'captions'}
        srclang={track.srclang}
        label={track.label}
        default={track.default}
      />
    ))
  }
</video>

<script>
  function initializeVideos(): void {
    const videos = document.querySelectorAll<HTMLVideoElement>('video[data-video-player]');

    for (const video of videos) {
      if (video.dataset.videoInitialized === 'true') continue;

      video.dataset.videoInitialized = 'true';
      video.load();
    }
  }

  document.addEventListener('astro:page-load', initializeVideos);
</script>
