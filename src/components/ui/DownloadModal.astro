---
import Button from '@/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  links: {
    faq: string;
    install: string;
  };
}

const { links } = Astro.props;
---

<dialog
  id="download-modal"
  aria-labelledby="download-modal-title"
  class="m-auto max-h-screen w-full max-w-screen border-none bg-transparent p-4 backdrop:bg-black/50 backdrop:backdrop-blur-md"
>
  <div class="relative mx-auto flex w-full max-w-xl flex-col overflow-hidden rounded-2xl border border-white/[0.07] bg-zinc-950 shadow-2xl shadow-black/60">
    <div class="flex items-center justify-between border-b border-white/[0.06] px-5 py-4">
      <div class="flex items-center gap-3">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/15 ring-1 ring-primary/20 ring-inset">
          <Icon name="tabler:download" class="text-primary" size={14} />
        </div>
        <h2 id="download-modal-title" class="text-sm font-semibold tracking-tight text-white">
          Installing AtlasOS
        </h2>
      </div>
      <button
        type="button"
        class="flex size-10 cursor-pointer items-center justify-center rounded-lg text-white/40 transition-[background-color,color,scale] duration-200 hover:bg-white/[0.06] hover:text-white/80 focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none active:scale-[0.96]"
        data-modal-close
        aria-label="Close"
      >
        <Icon name="tabler:x" size={14} />
      </button>
    </div>

    <div class="p-5">
      <div class="modal-views-wrapper relative" data-modal-views>
        <div class="modal-view modal-view-active flex flex-col gap-5" data-view="docs">
          <p class="text-sm leading-relaxed text-white/55">
            To get started, follow our installation guide. We've made it as straightforward as possible with all the
            steps to get you up and running.
          </p>

          <div class="grid grid-cols-2 gap-2.5">
            <a
              href={links.install}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col gap-3 rounded-xl bg-white/[0.025] p-4 shadow-[var(--shadow-surface)] transition-[background-color,box-shadow,scale] duration-200 hover:bg-primary/[0.06] hover:shadow-[0_0_0_1px_rgba(40,148,243,0.25)] active:scale-[0.96]"
            >
              <div class="flex items-start justify-between">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/15 ring-inset">
                  <Icon name="tabler:book" class="text-primary/80" size={16} />
                </div>
                <Icon
                  name="tabler:arrow-up-right"
                  class="text-white/20 transition-colors duration-200 group-hover:text-primary/60"
                  size={13}
                />
              </div>
              <div>
                <p class="text-sm font-medium text-white/90">Installation Guide</p>
                <p class="mt-0.5 text-xs text-white/40">Step-by-step setup</p>
              </div>
            </a>

            <a
              href={links.faq}
              class="group flex flex-col gap-3 rounded-xl bg-white/[0.025] p-4 shadow-[var(--shadow-surface)] transition-[background-color,box-shadow,scale] duration-200 hover:bg-white/[0.04] hover:shadow-[var(--shadow-surface-hover)] active:scale-[0.96]"
            >
              <div class="flex items-start justify-between">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-white/[0.06] ring-1 ring-white/[0.07] ring-inset">
                  <Icon name="tabler:help-circle" class="text-white/50" size={16} />
                </div>
                <Icon
                  name="tabler:arrow-up-right"
                  class="text-white/20 transition-colors duration-200 group-hover:text-white/50"
                  size={13}
                />
              </div>
              <div>
                <p class="text-sm font-medium text-white/90">Install FAQ</p>
                <p class="mt-0.5 text-xs text-white/40">Common questions</p>
              </div>
            </a>
          </div>

          <div class="border-t border-white/[0.05] pt-3">
            <button
              type="button"
              data-show-view="downloads"
              class="group inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm text-white/40 transition-colors duration-200 hover:text-white/70 focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none"
            >
              <span>I'm following the guide, show me the downloads</span>
              <Icon
                name="tabler:arrow-right"
                class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
              />
            </button>
          </div>
        </div>

        <div class="modal-view modal-view-exit flex flex-col gap-5" data-view="downloads">
          <div class="flex gap-3 rounded-xl border border-amber-500/15 bg-amber-500/[0.06] px-4 py-3">
            <Icon name="tabler:alert-triangle" class="mt-0.5 shrink-0 text-amber-400/80" size={15} />
            <p class="text-sm leading-relaxed text-white/60">
              <strong class="font-medium text-white/85">Only download when the guide tells you to.</strong> If you
              haven't started the guide yet, please read it first.
            </p>
          </div>

          <label
            for="confirm-guide"
            class="flex cursor-pointer items-center gap-3 rounded-xl border border-white/[0.07] bg-white/[0.025] px-4 py-3 transition-colors hover:border-white/[0.11] hover:bg-white/[0.04]"
          >
            <div class="relative flex shrink-0 items-center">
              <input type="checkbox" id="confirm-guide" class="peer sr-only" />
              <div class="h-4 w-4 rounded border border-white/20 bg-white/5 transition-colors peer-checked:border-primary peer-checked:bg-primary peer-focus:ring-2 peer-focus:ring-primary/50 peer-focus:ring-offset-1 peer-focus:ring-offset-zinc-950"></div>
              <Icon
                name="tabler:check"
                class="pointer-events-none absolute top-0 left-0 h-4 w-4 text-zinc-950 opacity-0 transition-opacity peer-checked:opacity-100"
              />
            </div>
            <p class="text-sm text-white/60">
              I confirm I am following the{' '}
              <a
                href={links.install}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary/80 underline-offset-2 hover:text-primary hover:underline"
              >
                installation guide
              </a>
              .
            </p>
          </label>

          <p data-download-count class="text-center text-xs text-white/30">
            Fetching download count...
          </p>

          <div class="flex flex-col gap-2">
            <Button
              variant="primary"
              id="playbook-dl-btn"
              icon="tabler:download"
              iconPosition="after"
              size="lg"
              fw
              disabled
            >
              Download Atlas Playbook
            </Button>
            <Button
              href="https://download.ameliorated.io/AME%20Beta.zip"
              variant="secondary"
              id="wizard-dl-btn"
              icon="tabler:download"
              iconPosition="after"
              size="lg"
              fw
            >
              Download AME Beta
            </Button>
          </div>

          <div class="border-t border-white/[0.05] pt-1">
            <button
              type="button"
              data-show-view="docs"
              class="group inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm text-white/40 transition-colors duration-200 hover:text-white/70 focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none"
            >
              <Icon
                name="tabler:arrow-left"
                class="h-3.5 w-3.5 transition-transform duration-200 group-hover:-translate-x-0.5"
              />
              <span>Back to the install guide</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { ATLAS_API_URL, ATLAS_GITHUB_LATEST_RELEASE_API_URL, ATLAS_GITHUB_LATEST_RELEASE_URL } from '@/constants';
  import { onPageLoad } from '@/utils/page-lifecycle';

  type View = 'docs' | 'downloads';

  interface GitHubRelease {
    html_url?: string;
    assets?: Array<{ name?: string; browser_download_url?: string }>;
  }

  async function fetchDownloadCount(): Promise<number | null> {
    try {
      const response = await fetch(ATLAS_API_URL);
      if (!response.ok) return null;
      const data = (await response.json()) as Array<{ version?: string; count?: number }>;
      return data.find((item) => item.version === 'atlas')?.count ?? null;
    } catch {
      return null;
    }
  }

  async function fetchLatestPlaybookUrl(): Promise<string> {
    const response = await fetch(ATLAS_GITHUB_LATEST_RELEASE_API_URL);
    if (!response.ok) throw new Error(`Release API request failed with status ${response.status}`);

    const release = (await response.json()) as GitHubRelease;
    const asset = release.assets?.find((item) => /AtlasPlaybook.*\.zip$/i.test(item.name ?? ''));
    return asset?.browser_download_url ?? release.html_url ?? ATLAS_GITHUB_LATEST_RELEASE_URL;
  }

  function incrementDownloadCount(): void {
    fetch(`${ATLAS_API_URL}atlas/increment`, { method: 'POST' }).catch((error: unknown) => {
      console.warn('Failed to increment Atlas download count.', error);
    });
  }

  function initDownloadModal(signal: AbortSignal): void {
    const modal = document.getElementById('download-modal');
    if (!(modal instanceof HTMLDialogElement)) return;

    const views = {
      docs: modal.querySelector<HTMLElement>('[data-view="docs"]'),
      downloads: modal.querySelector<HTMLElement>('[data-view="downloads"]'),
    };
    const wrapper = modal.querySelector<HTMLElement>('[data-modal-views]');
    const confirmGuide = modal.querySelector<HTMLInputElement>('#confirm-guide');
    const playbookButton = modal.querySelector<HTMLButtonElement>('#playbook-dl-btn');
    const wizardButton = modal.querySelector<HTMLAnchorElement>('#wizard-dl-btn');
    const downloadCount = modal.querySelector<HTMLElement>('[data-download-count]');
    if (!views.docs || !views.downloads || !wrapper || !confirmGuide || !playbookButton || !wizardButton) return;

    let currentView: View = 'docs';

    const syncHeight = () => {
      wrapper.style.height = `${views[currentView]!.scrollHeight}px`;
    };

    const setDownloadsEnabled = (enabled: boolean) => {
      playbookButton.disabled = !enabled;
      wizardButton.classList.toggle('disabled-link', !enabled);
      wizardButton.setAttribute('aria-disabled', String(!enabled));
    };

    const showView = (view: View) => {
      if (view === currentView) return;
      const entering = views[view]!;
      const leaving = views[currentView]!;
      currentView = view;

      syncHeight();
      leaving.classList.remove('modal-view-active', 'modal-view-enter');
      leaving.classList.add('modal-view-exit');
      entering.classList.remove('modal-view-exit');
      entering.classList.add('modal-view-enter');

      requestAnimationFrame(() => {
        entering.classList.remove('modal-view-enter');
        entering.classList.add('modal-view-active');
        syncHeight();
      });

      confirmGuide.checked = false;
      setDownloadsEnabled(false);
      if (view === 'downloads') void updateDownloadCount();
    };

    const resetViews = () => {
      views.docs!.classList.remove('modal-view-exit', 'modal-view-enter');
      views.docs!.classList.add('modal-view-active');
      views.downloads!.classList.remove('modal-view-active', 'modal-view-enter');
      views.downloads!.classList.add('modal-view-exit');
      currentView = 'docs';
      confirmGuide.checked = false;
      setDownloadsEnabled(false);
    };

    const updateDownloadCount = async () => {
      if (!downloadCount) return;
      downloadCount.textContent = 'Loading...';
      const count = await fetchDownloadCount();
      downloadCount.textContent =
        count === null
          ? 'Join the millions of Atlas users!'
          : `Atlas has been downloaded ${count.toLocaleString('en-US')} times.`;
      if (currentView === 'downloads') syncHeight();
    };

    const handlePlaybookDownload = async () => {
      if (playbookButton.disabled) return;
      const originalContent = [...playbookButton.childNodes].map((node) => node.cloneNode(true));
      playbookButton.textContent = 'Preparing download...';
      playbookButton.disabled = true;

      try {
        const url = await fetchLatestPlaybookUrl();
        const anchor = document.createElement('a');
        anchor.href = url;
        if (/\.zip($|\?)/i.test(url)) anchor.download = '';
        anchor.click();
      } catch (error) {
        console.warn('Failed to resolve latest Atlas Playbook download.', error);
        window.open(ATLAS_GITHUB_LATEST_RELEASE_URL, '_blank', 'noopener,noreferrer');
      }

      incrementDownloadCount();
      window.setTimeout(() => {
        if (!playbookButton.isConnected) return;
        playbookButton.replaceChildren(...originalContent);
        playbookButton.disabled = !confirmGuide.checked;
      }, 1000);
    };

    const open = () => {
      modal.showModal();
      document.body.classList.add('overflow-hidden');
      syncHeight();
      void updateDownloadCount();
    };

    for (const trigger of document.querySelectorAll<HTMLElement>('[data-download-modal-open]')) {
      trigger.addEventListener('click', open, { signal });
    }

    modal.addEventListener('click', (event) => event.target === modal && modal.close(), { signal });
    modal.addEventListener(
      'close',
      () => {
        document.body.classList.remove('overflow-hidden');
        resetViews();
      },
      { signal }
    );
    modal.querySelector('[data-modal-close]')?.addEventListener('click', () => modal.close(), { signal });

    for (const button of modal.querySelectorAll<HTMLElement>('[data-show-view]')) {
      button.addEventListener('click', () => showView(button.dataset.showView as View), { signal });
    }

    confirmGuide.addEventListener('change', () => setDownloadsEnabled(confirmGuide.checked), { signal });
    playbookButton.addEventListener('click', () => void handlePlaybookDownload(), { signal });
    window.addEventListener('resize', syncHeight, { signal });

    signal.addEventListener(
      'abort',
      () => {
        if (modal.open) modal.close();
        document.body.classList.remove('overflow-hidden');
      },
      { once: true }
    );

    resetViews();
  }

  onPageLoad(initDownloadModal);
</script>

<style>
  @keyframes show {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  dialog[open] {
    display: grid;
    place-items: center;
    animation: show 250ms var(--motion-ease-spring);
  }

  .modal-views-wrapper {
    contain: layout style;
    transition: height var(--motion-duration-normal) var(--motion-ease-out);
  }

  .modal-view {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    transition:
      opacity var(--motion-duration-normal) var(--motion-ease-out),
      transform var(--motion-duration-normal) var(--motion-ease-out),
      filter var(--motion-duration-normal) var(--motion-ease-out);
  }

  .modal-view-enter {
    opacity: 0;
    transform: translateY(8px);
    filter: blur(4px);
    pointer-events: none;
  }

  .modal-view-active {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    pointer-events: auto;
  }

  .modal-view-exit {
    opacity: 0;
    transform: translateY(-8px);
    filter: blur(4px);
    pointer-events: none;
  }

  .disabled-link {
    pointer-events: none;
    opacity: 0.5;
  }
</style>
