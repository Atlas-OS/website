---
import { Icon } from 'astro-icon/components';
import Button from '@/components/ui/Button.astro';

interface Props {
  links: {
    faq: string;
    install: string;
  };
}

const { links } = Astro.props;
---

<dialog
  id="download-modal"
  aria-labelledby="download-modal-title"
  class="m-auto max-h-screen w-full max-w-screen border-none bg-transparent p-4 backdrop:bg-black/50 backdrop:backdrop-blur-md"
>
  <div
    class="relative mx-auto flex w-full max-w-xl flex-col overflow-hidden rounded-2xl border border-white/[0.07] bg-zinc-950 shadow-2xl shadow-black/60"
  >
    <div class="flex items-center justify-between border-b border-white/[0.06] px-5 py-4">
      <div class="flex items-center gap-3">
        <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary/15 ring-1 ring-inset ring-primary/20">
          <Icon name="tabler:download" class="text-primary" size={14} />
        </div>
        <h2 id="download-modal-title" class="text-sm font-semibold tracking-tight text-white">Installing AtlasOS</h2>
      </div>
      <button
        class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-lg text-white/40 transition-colors hover:bg-white/[0.06] hover:text-white/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
        id="modal-close"
        aria-label="Close"
      >
        <Icon name="tabler:x" size={14} />
      </button>
    </div>

    <div class="p-5">
      <div id="modal-views-wrapper" class="modal-views-wrapper relative">

        <div id="docs-view" class="modal-view modal-view-active flex flex-col gap-5" data-view="docs">
          <p class="text-sm leading-relaxed text-white/55">
            To get started, follow our installation guide. We've made it as straightforward as possible with all the steps to get you up and running.
          </p>

          <div class="grid grid-cols-2 gap-2.5">
            <a
              href={links.install}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col gap-3 rounded-xl border border-white/[0.07] bg-white/[0.025] p-4 transition-all duration-200 hover:border-primary/25 hover:bg-primary/[0.06]"
            >
              <div class="flex items-start justify-between">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-inset ring-primary/15">
                  <Icon name="tabler:book" class="text-primary/80" size={16} />
                </div>
                <Icon name="tabler:arrow-up-right" class="text-white/20 transition-colors duration-200 group-hover:text-primary/60" size={13} />
              </div>
              <div>
                <p class="text-sm font-medium text-white/90">Installation Guide</p>
                <p class="mt-0.5 text-xs text-white/40">Step-by-step setup</p>
              </div>
            </a>

            <a
              href={links.faq}
              class="group flex flex-col gap-3 rounded-xl border border-white/[0.07] bg-white/[0.025] p-4 transition-all duration-200 hover:border-white/[0.14] hover:bg-white/[0.04]"
            >
              <div class="flex items-start justify-between">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-white/[0.06] ring-1 ring-inset ring-white/[0.07]">
                  <Icon name="tabler:help-circle" class="text-white/50" size={16} />
                </div>
                <Icon name="tabler:arrow-up-right" class="text-white/20 transition-colors duration-200 group-hover:text-white/50" size={13} />
              </div>
              <div>
                <p class="text-sm font-medium text-white/90">Install FAQ</p>
                <p class="mt-0.5 text-xs text-white/40">Common questions</p>
              </div>
            </a>
          </div>

          <div class="border-t border-white/[0.05] pt-3">
            <button
              id="show-downloads"
              class="group inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm text-white/40 transition-colors duration-200 hover:text-white/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
            >
              <span>I'm following the guide, show me the downloads</span>
              <Icon name="tabler:arrow-right" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" />
            </button>
          </div>
        </div>

        <div id="downloads-view" class="modal-view modal-view-exit flex flex-col gap-5" data-view="downloads">
          <div class="flex gap-3 rounded-xl border border-amber-500/15 bg-amber-500/[0.06] px-4 py-3">
            <Icon name="tabler:alert-triangle" class="mt-0.5 shrink-0 text-amber-400/80" size={15} />
            <p class="text-sm leading-relaxed text-white/60">
              <strong class="font-medium text-white/85">Only download when the guide tells you to.</strong>
              {' '}If you haven't started the guide yet, please read it first.
            </p>
          </div>

          <label
            for="confirm-guide"
            class="flex cursor-pointer items-center gap-3 rounded-xl border border-white/[0.07] bg-white/[0.025] px-4 py-3 transition-colors hover:border-white/[0.11] hover:bg-white/[0.04]"
          >
            <div class="relative flex shrink-0 items-center">
              <input
                type="checkbox"
                id="confirm-guide"
                class="peer sr-only"
              />
              <div
                class="peer-checked:border-primary peer-checked:bg-primary h-4 w-4 rounded border border-white/20 bg-white/5 transition-colors peer-focus:ring-2 peer-focus:ring-primary/50 peer-focus:ring-offset-1 peer-focus:ring-offset-zinc-950"
              ></div>
              <Icon
                name="tabler:check"
                class="pointer-events-none absolute top-0 left-0 h-4 w-4 text-zinc-950 opacity-0 transition-opacity peer-checked:opacity-100"
              />
            </div>
            <p class="text-sm text-white/60">
              I confirm I am following the{' '}
              <a
                href={links.install}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary/80 underline-offset-2 hover:text-primary hover:underline"
                onclick="(e) => e.stopPropagation()"
              >installation guide</a>.
            </p>
          </label>

          <p id="download-count" class="text-center text-xs text-white/30">
            Fetching download count...
          </p>

          <div class="flex flex-col gap-2">
            <Button
              variant="primary"
              id="playbook-dl-btn"
              icon="tabler:download"
              iconPosition="after"
              size="lg"
              fw
              disabled
            >
              Download Atlas Playbook
            </Button>
            <Button
              href="https://download.ameliorated.io/AME%20Beta.zip"
              variant="secondary"
              id="wizard-dl-btn"
              icon="tabler:download"
              iconPosition="after"
              size="lg"
              fw
            >
              Download AME Wizard
            </Button>
          </div>

          <div class="border-t border-white/[0.05] pt-1">
            <button
              id="show-docs"
              class="group inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm text-white/40 transition-colors duration-200 hover:text-white/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
            >
              <Icon name="tabler:arrow-left" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:-translate-x-0.5" />
              <span>Back to the install guide</span>
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>
</dialog>

<script>
  import { ATLAS_API_URL, ATLAS_VERSION } from '@/constants';

  class DownloadModal {
    private modal: HTMLDialogElement;
    private views: { docs: HTMLElement; downloads: HTMLElement };
    private buttons: {
      close: HTMLButtonElement;
      showDownloads: HTMLButtonElement;
      showDocs: HTMLButtonElement;
      playbook: HTMLButtonElement;
      wizard: HTMLButtonElement;
      confirmGuide: HTMLInputElement;
    };
    private downloadCountElement: HTMLElement;
    private viewsWrapper: HTMLElement;
    private currentView: 'docs' | 'downloads';

    constructor() {

      this.modal = this.getElement<HTMLDialogElement>('download-modal');
      this.views = {
        docs: this.getElement<HTMLElement>('docs-view'),
        downloads: this.getElement<HTMLElement>('downloads-view'),
      };
      this.buttons = {
        close: this.getElement<HTMLButtonElement>('modal-close'),
        showDownloads: this.getElement<HTMLButtonElement>('show-downloads'),
        showDocs: this.getElement<HTMLButtonElement>('show-docs'),
        playbook: this.getElement<HTMLButtonElement>('playbook-dl-btn'),
        wizard: this.getElement<HTMLButtonElement>('wizard-dl-btn'),
        confirmGuide: this.getElement<HTMLInputElement>('confirm-guide'),
      };
      this.downloadCountElement = this.getElement<HTMLElement>('download-count');
      this.viewsWrapper = this.getElement<HTMLElement>('modal-views-wrapper');
      this.currentView = 'docs';

      this.setupEventListeners();
      this.initializeViews();
    }

    private getElement<T extends HTMLElement>(id: string): T {
      const el = document.getElementById(id);
      if (!el) throw new Error(`Element with ID '${id}' not found.`);
      return el as T;
    }

    private setupEventListeners(): void {
      document.addEventListener('showModal', () => {
        this.modal.showModal();
        document.body.classList.add('overflow-hidden');
        this.syncWrapperHeight();
        this.updateDownloadCount();
      });

      this.buttons.close.addEventListener('click', () => this.closeModal());

      this.modal.addEventListener('click', (e: MouseEvent) => {
        if (e.target === this.modal) this.closeModal();
      });

      this.buttons.showDownloads.addEventListener('click', () => this.switchView('downloads'));
      this.buttons.showDocs.addEventListener('click', () => this.switchView('docs'));
      this.buttons.confirmGuide.addEventListener('change', () => this.updateConfirmState());
      this.buttons.playbook.addEventListener('click', () => this.handleDownload());
      window.addEventListener('resize', () => this.syncWrapperHeight());

      this.modal.addEventListener('close', () => {
        document.body.classList.remove('overflow-hidden');
        this.initializeViews();
      });
    }

    private closeModal(): void {
      this.modal.close();
    }

    private initializeViews(): void {
      this.setViewActive('docs');
      this.setViewInactive('downloads');
      this.currentView = 'docs';
      this.buttons.confirmGuide.checked = false;
      this.toggleDownloadButtons(false);
    }

    private setViewActive(view: 'docs' | 'downloads'): void {
      const el = this.views[view];
      el.classList.remove('modal-view-exit', 'modal-view-enter');
      el.classList.add('modal-view-active');
    }

    private setViewInactive(view: 'docs' | 'downloads'): void {
      const el = this.views[view];
      el.classList.remove('modal-view-active', 'modal-view-enter');
      el.classList.add('modal-view-exit');
    }

    private switchView(viewName: 'docs' | 'downloads'): void {
      if (this.currentView === viewName) return;

      const viewToShow = this.views[viewName];
      const viewToHide = this.views[this.currentView];

      this.syncWrapperHeight();

      viewToHide.classList.remove('modal-view-active', 'modal-view-enter');
      viewToHide.classList.add('modal-view-exit');

      viewToShow.classList.remove('modal-view-exit');
      viewToShow.classList.add('modal-view-enter');

      this.currentView = viewName;
      requestAnimationFrame(() => {
        viewToShow.classList.remove('modal-view-enter');
        viewToShow.classList.add('modal-view-active');
        this.syncWrapperHeight();
      });
      this.buttons.confirmGuide.checked = false;
      this.toggleDownloadButtons(false);

      if (viewName === 'downloads') {
        this.updateDownloadCount();
      }
    }

    private updateConfirmState(): void {
      this.toggleDownloadButtons(this.buttons.confirmGuide.checked);
    }

    private toggleDownloadButtons(enabled: boolean): void {
      this.buttons.playbook.disabled = !enabled;
      this.buttons.wizard.classList.toggle('disabled-link', !enabled);
      this.buttons.wizard.setAttribute('aria-disabled', String(!enabled));
      this.buttons.wizard.style.pointerEvents = enabled ? 'auto' : 'none';
    }

    private async updateDownloadCount(): Promise<void> {
      this.downloadCountElement.textContent = 'Loading...';
      if (this.currentView === 'downloads') this.syncWrapperHeight();
      try {
        const count = await this.fetchDownloadCount();
        this.downloadCountElement.textContent =
          count != null
            ? `Atlas has been downloaded ${count.toLocaleString('en-US')} times.`
            : 'Join the millions of Atlas users!';
      } catch {
        this.downloadCountElement.textContent = 'Could not load download count.';
      }

      if (this.currentView === 'downloads') this.syncWrapperHeight();
    }

    private syncWrapperHeight(): void {
      const activeView = this.views[this.currentView];
      this.viewsWrapper.style.height = `${activeView.scrollHeight}px`;
    }

    private async fetchDownloadCount(): Promise<number | null> {
      try {
        const response = await fetch(ATLAS_API_URL);
        if (!response.ok) throw new Error(`API request failed with status ${response.status}`);
        const data = (await response.json()) as Array<{ version?: string; count?: number }>;
        const atlasDownload = data.find((item) => item?.version === 'atlas');
        return atlasDownload?.count ?? null;
      } catch {
        return null;
      }
    }

    private async incrementDownloadCount(): Promise<void> {
      const incrementUrl = `${ATLAS_API_URL}atlas/increment`;
      try {
        const response = await fetch(incrementUrl, { method: 'POST' });
        if (!response.ok) throw new Error(`Increment request failed with status ${response.status}`);
      } catch (error) {
        console.warn('Failed to increment Atlas download count.', error);
      }
    }

    private handleDownload(): void {
      if (this.buttons.playbook.disabled) return;

      const originalContent = this.buttons.playbook.innerHTML;
      const downloadUrl = `https://cdn.jsdelivr.net/atlas/${ATLAS_VERSION}/AtlasPlaybook_v${ATLAS_VERSION}.zip`;

      this.buttons.playbook.textContent = 'Downloading...';
      this.buttons.playbook.disabled = true;

      const a = document.createElement('a');
      a.href = downloadUrl;
      a.download = '';
      a.click();

      this.incrementDownloadCount()
        .catch(() => {})
        .finally(() => {
          setTimeout(() => {
            if (document.body.contains(this.buttons.playbook)) {
              this.buttons.playbook.innerHTML = originalContent;
              this.buttons.playbook.disabled = !this.buttons.confirmGuide.checked;
            }
          }, 1000);
        });
    }
  }

  function init(): void {
    const modal = document.getElementById('download-modal');
    if (!modal || modal.dataset.initialized) return;
    modal.dataset.initialized = 'true';
    new DownloadModal();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  @keyframes show {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  dialog[open] {
    display: grid;
    place-items: center;
    animation: show 250ms var(--motion-ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .modal-views-wrapper {
    contain: layout style;
    transition: height var(--motion-duration-normal, 250ms) var(--motion-ease-out, cubic-bezier(0.33, 1, 0.68, 1));
  }

  .modal-view {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    transition:
      opacity var(--motion-duration-normal, 250ms) var(--motion-ease-out, cubic-bezier(0.33, 1, 0.68, 1)),
      transform var(--motion-duration-normal, 250ms) var(--motion-ease-out, cubic-bezier(0.33, 1, 0.68, 1)),
      filter var(--motion-duration-normal, 250ms) var(--motion-ease-out, cubic-bezier(0.33, 1, 0.68, 1));
  }

  .modal-view-enter {
    opacity: 0;
    transform: translateY(8px);
    filter: blur(4px);
    pointer-events: none;
  }

  .modal-view-active {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    pointer-events: auto;
  }

  .modal-view-exit {
    opacity: 0;
    transform: translateY(-8px);
    filter: blur(4px);
    pointer-events: none;
  }

  .disabled-link {
    pointer-events: none;
    opacity: 0.5;
  }
</style>
