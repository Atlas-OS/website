---
import { Picture as AstroPicture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  formats?: ('avif' | 'webp' | 'png' | 'jpg')[];
  fallbackFormat?: 'avif' | 'webp' | 'png' | 'jpg';
  loading?: 'lazy' | 'eager';
  layout?: 'full-width' | 'constrained' | 'fixed';
  sizes?: string;
  outlined?: boolean;
  class?: string;
  draggable?: boolean;
}

const {
  src,
  alt,
  width,
  height,
  formats = ['avif', 'webp'],
  fallbackFormat = 'webp',
  loading = 'lazy',
  layout = 'constrained',
  sizes,
  outlined = false,
  class: className = '',
  draggable = true,
} = Astro.props;

const hasDimensions = width && height;
const classes = [outlined && 'media-outline', className].filter(Boolean).join(' ');
---

<AstroPicture
  src={src}
  alt={alt}
  width={width}
  height={height}
  formats={formats}
  fallbackFormat={fallbackFormat}
  loading={loading}
  layout={layout}
  sizes={sizes}
  class={classes}
  draggable={draggable}
  {...hasDimensions && { style: `aspect-ratio: ${width} / ${height}` }}
/>
