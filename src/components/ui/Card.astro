---
interface Props {
  class?: string;
  hover?: boolean;
  clickable?: boolean;
  padding?: 'none' | 'sm' | 'md' | 'lg';
}

const { class: className = '', hover = false, clickable = false, padding = 'md' } = Astro.props;

const baseClasses = [
  'rounded-lg bg-white/5 shadow-[var(--shadow-surface)]',
  'transition-[box-shadow,opacity,scale] duration-200',
];

const paddingClasses = {
  none: '',
  sm: 'p-3',
  md: 'p-4',
  lg: 'p-6',
};

const hoverClasses = hover || clickable ? ['hover:opacity-80 hover:shadow-[var(--shadow-surface-hover)]'] : [];

const clickableClasses = clickable ? ['cursor-pointer active:scale-[0.96]'] : [];

const classes = [...baseClasses, paddingClasses[padding], ...hoverClasses, ...clickableClasses, className].join(' ');
---

<div class={`not-prose ${classes}`}>
  <slot name="header" />
  <slot />
  <slot name="footer" />
</div>
