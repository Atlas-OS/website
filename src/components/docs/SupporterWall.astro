---
import Button from '@/components/ui/Button.astro';
---

<!--
  The Ko-fi button is static; the names load from /api/supporters after the page and fill in
  below it, so nothing above them moves. With no names, or no answer, only the button shows.
-->
<div class="supporter-wall not-prose" data-supporter-wall>
  <Button href="https://ko-fi.com/atlasos" external variant="secondary" size="lg" icon="tabler:heart">
    Support Atlas on Ko-fi
  </Button>
  <noscript>
    <p class="supporter-wall__note">Supporters' names load with JavaScript.</p>
  </noscript>
</div>

<script>
  import { onPageLoad } from '@/utils/page-lifecycle';
  import { initSupporterWall } from '@/utils/supporter-wall';

  onPageLoad(initSupporterWall);
</script>

<style is:global>
  .supporter-wall {
    margin-block: 1.25rem 0.5rem;
  }

  .supporter-wall__note {
    margin-block-start: 1rem;
    font-size: 0.875rem;
    color: var(--docs-text-muted);
  }

  .supporter-wall__panel {
    display: grid;
    gap: 1.5rem;
    margin-block-start: 1.5rem;
    padding: clamp(1rem, 4vw, 1.5rem);
  }

  .supporter-wall__heading {
    margin-block-end: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--docs-text-primary);
  }

  .supporter-wall__names {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .supporter-wall__name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-inline-size: 100%;
    padding-block: 0.3125rem;
    padding-inline: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--docs-text-primary);
    background: color-mix(in oklch, var(--color-fg) 3.5%, transparent);
    border: 1px solid var(--docs-surface-border);
    border-radius: var(--docs-radius-sm);
    overflow-wrap: anywhere;
  }

  /* The tier reads as a small label, like the sidebar's badges. */
  .supporter-wall__tier {
    flex-shrink: 0;
    padding-block: 0.0625rem;
    padding-inline: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.025em;
    color: var(--color-link);
    border: 1px solid var(--docs-surface-border);
    border-radius: var(--docs-radius-sm);
  }

  @media (prefers-reduced-motion: no-preference) {
    .supporter-wall__panel {
      animation: supporter-wall-in var(--motion-duration-normal) var(--motion-ease-out);
    }
  }

  @keyframes supporter-wall-in {
    from {
      opacity: 0;
    }
  }
</style>
