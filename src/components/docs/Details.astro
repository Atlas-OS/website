---
import { Icon } from 'astro-icon/components';

interface Props {
  summary: string;
  open?: boolean;
}

const { summary, open = false } = Astro.props;
---

<details class="details docs-surface not-prose my-4 overflow-hidden" data-component="details" open={open}>
  <summary
    class="details-summary flex cursor-pointer items-center justify-between gap-3 px-4 py-3 text-sm font-medium transition-colors hover:bg-white/[0.04]"
    style="color: var(--docs-text-primary);"
  >
    <span>{summary}</span>
    <Icon
      name="tabler:chevron-down"
      class="details-summary-icon h-4 w-4 shrink-0 transition-transform duration-200"
      style="color: var(--docs-text-muted);"
      aria-hidden="true"
    />
  </summary>
  <div class="details-content px-4 py-3" style="border-top: 1px solid var(--docs-surface-border);">
    <slot />
  </div>
</details>

<style is:global>
  .details-summary {
    list-style: none;
  }

  .details-summary::-webkit-details-marker {
    display: none;
  }

  .details-summary::marker {
    display: none;
  }

  .details[open] .details-summary-icon {
    transform: rotate(180deg);
  }

  .details-content ul,
  .details-content ol {
    margin-top: 0.5rem;
    margin-bottom: 0;
    margin-left: 1.25rem;
    padding-left: 0;
  }

  .details-content li {
    margin-bottom: 0.25rem;
    color: rgb(255 255 255 / 0.9);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .details-content p {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.9);
  }

  .details-content p:last-child {
    margin-bottom: 0;
  }

  .details-content a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .details-content a:hover {
    opacity: 0.85;
  }

  .details-content code {
    background-color: var(--docs-surface-bg);
    border: 1px solid var(--docs-surface-border);
    color: var(--color-primary);
    padding: 0.125rem 0.375rem;
    border-radius: var(--docs-radius-sm);
    font-size: 0.875em;
  }
</style>
