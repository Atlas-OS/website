---
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  icon: string;
  label?: string;
  title: string;
  description: string;
  external?: boolean;
}

const { href, icon, label, title, description, external = false } = Astro.props;

const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a href={href} {...externalAttrs} class="quick-link-card docs-surface not-prose group relative block p-5">
  <div
    class="mb-3 flex items-center gap-3 text-sm"
    style="color: var(--quick-link-icon-color, var(--docs-text-muted));"
  >
    <div class="docs-link-icon">
      <Icon name={icon} class="h-5 w-5" aria-hidden="true" />
    </div>
    {label && <span>{label}</span>}
    <Icon
      name={external ? 'tabler:arrow-up-right' : 'tabler:arrow-right'}
      class="ml-auto h-4 w-4 shrink-0 text-white/45 transition-colors group-hover:text-white/75"
      aria-hidden="true"
    />
  </div>
  <span class="mb-1 block text-base font-semibold text-[var(--docs-text-primary)]">{title}</span>
  <p class="text-sm" style="color: var(--docs-text-secondary);">
    {description}
  </p>
</a>

<style is:global>
  .quick-link-card {
    z-index: 1;
  }
</style>
