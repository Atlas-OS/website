---
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  icon: string;
  label: string;
  title: string;
  description: string;
  external?: boolean;
}

const { href, icon, label, title, description, external = false } = Astro.props;

const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
  href={href}
  {...externalAttrs}
  class="quick-link-card docs-surface not-prose group relative p-5 transition-[background-color,box-shadow,scale] duration-200 active:scale-[0.96]"
>
  <div class="mb-2 flex items-center gap-3 text-sm" style="color: var(--docs-text-muted);">
    <div class="quick-link-icon-wrapper">
      <Icon name={icon} class="h-4 w-4" aria-hidden="true" />
    </div>
    <span>{label}</span>
  </div>
  <span class="mb-2 block text-lg font-semibold transition-colors duration-200 group-hover:text-white">{title}</span>
  <p class="text-sm" style="color: var(--docs-text-secondary);">{description}</p>
</a>

<style is:global>
  .quick-link-card {
    z-index: 1;
  }
</style>
