---
import Callout from '@/components/docs/Callout.astro';
import Details from '@/components/docs/Details.astro';
import CodeInline from '@/components/docs/CodeInline.astro';
import IconArrow from '@/components/ui/IconArrow.astro';
import TabPanel from '@/components/ui/TabPanel.astro';
import Tabs from '@/components/ui/Tabs.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  /** Include AME Beta as a download option (for ISO injection guide) */
  includeAmeBeta?: boolean;
}

const { includeAmeBeta = false } = Astro.props;

const msdlId = `msdl-${Math.random().toString(36).substring(2, 9)}`;

const tabItems = [
  { label: 'ISO Downloader (Recommended)', value: 'iso-downloader' },
  { label: 'Microsoft website', value: 'microsoft-site' },
  { label: 'Media Creation Tool', value: 'media-creation-tool' },
  ...(includeAmeBeta ? [{ label: 'AME Beta', value: 'ame-beta' }] : []),
];
---

<Callout type="tip" title="Which version?">
  {includeAmeBeta ? (
    <>For AMD and Intel CPUs, download the x86_64 (x64) version. For Qualcomm Snapdragon or other
    supported ARM SoCs, download the ARM64 version.{' '}
    <a href="https://www.tenforums.com/tutorials/132836-check-what-processor-cpu-windows-pc.html#option1">Check your CPU architecture</a>.</>
  ) : (
    <>Intel/AMD CPUs use x64. ARM (Snapdragon) systems use ARM64. Make sure you
    download the correct ISO for your CPU architecture.</>
  )}
</Callout>

<Tabs items={tabItems} defaultTab="iso-downloader">
  <TabPanel value="iso-downloader" default>
    <div class="msdl-widget not-prose" data-msdl-root={msdlId}>

      <!-- Step: idle — architecture selection -->
      <div data-msdl-step="idle">
        <p class="mb-3 text-[11px] font-medium uppercase tracking-widest text-white/25">Architecture</p>
        <div class="grid grid-cols-2 gap-2">
          <button
            type="button"
            data-msdl-arch-btn="x64"
            class="iso-arch-btn group relative flex cursor-pointer flex-col gap-3 rounded-lg border border-white/[0.06] bg-white/[0.02] px-4 py-4 text-left focus-visible:outline-none active:scale-[0.98]"
          >
            <Icon name="tabler:device-desktop" class="h-5 w-5 text-white/30 transition-colors duration-200 group-hover:text-primary/70" />
            <div>
              <p class="text-sm font-semibold text-white/85">x64</p>
              <p class="text-xs text-white/35">Intel &amp; AMD</p>
            </div>
          </button>
          <button
            type="button"
            data-msdl-arch-btn="arm64"
            class="iso-arch-btn group relative flex cursor-pointer flex-col gap-3 rounded-lg border border-white/[0.06] bg-white/[0.02] px-4 py-4 text-left focus-visible:outline-none active:scale-[0.98]"
          >
            <Icon name="tabler:device-laptop" class="h-5 w-5 text-white/30 transition-colors duration-200 group-hover:text-primary/70" />
            <div>
              <p class="text-sm font-semibold text-white/85">ARM64</p>
              <p class="text-xs text-white/35">Qualcomm Snapdragon</p>
            </div>
          </button>
        </div>
        <Details summary="Which should I download?">
          <p>
            Intel/AMD CPUs use x64. ARM (Snapdragon) systems use ARM64.
          </p>
          <p class="mb-0">
            To check your system: open <strong>Settings → System → About</strong> and look at <strong>System type</strong>. See <a href="https://www.tenforums.com/tutorials/132836-check-what-processor-cpu-windows-pc.html#option1">how to check your CPU architecture</a> for more detail.
          </p>
        </Details>
      </div>

      <!-- Step: loading-langs -->
      <div data-msdl-step="loading-langs" class="hidden">
        <div class="iso-loading flex flex-col items-center gap-4 py-10">
          <div class="iso-loading-spinner" aria-hidden="true"></div>
          <p class="text-sm font-medium text-white/50">
            Fetching languages<span class="iso-loading-ellipsis" aria-hidden="true"></span>
          </p>
        </div>
      </div>

      <!-- Step: select-lang -->
      <div data-msdl-step="select-lang" class="hidden">
        <div class="mb-4 flex items-center gap-1.5">
          <button
            type="button"
            data-msdl-back
            class="flex items-center gap-1 rounded text-xs text-white/35 transition-colors duration-150 hover:text-white/65 focus-visible:outline-none"
          >
            <Icon name="tabler:arrow-left" class="h-3.5 w-3.5" />
            Back
          </button>
          <span class="text-white/15">/</span>
          <span class="text-[11px] font-medium text-white/40" data-msdl-arch-label></span>
        </div>
        <div class="space-y-3">
          <div data-msdl-select-wrapper>
            <button
              type="button"
              data-msdl-select-trigger
              class="msdl-select-trigger flex w-full cursor-pointer items-center justify-between gap-2 rounded-lg border border-white/[0.07] bg-white/[0.03] px-3 py-2.5 text-sm text-left transition-colors duration-150 hover:border-white/[0.12] hover:bg-white/[0.05] focus-visible:outline-none active:scale-[0.99]"
              aria-haspopup="listbox"
              aria-expanded="false"
            >
              <span data-msdl-select-value class="text-white/30">Choose a language&hellip;</span>
              <svg
                data-msdl-select-chevron
                class="h-3.5 w-3.5 shrink-0 text-white/25 transition-transform duration-200"
                xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </button>
            <!-- Panel injected by JS -->
          </div>

          <p class="text-xs text-white/30">
            Match your Windows display language — check <strong class="font-medium text-white/45">Settings &rarr; Time &amp; language</strong>.
          </p>
          <button
            type="button"
            data-msdl-get-download
            disabled
            class="iso-get-download-btn flex w-full items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium text-white transition-all duration-150 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-35"
          >
            Get download link
            <Icon name="tabler:arrow-right" class="h-4 w-4 transition-transform duration-150" />
          </button>
        </div>
      </div>

      <!-- Step: loading-download -->
      <div data-msdl-step="loading-download" class="hidden">
        <div class="iso-loading flex flex-col items-center gap-4 py-10">
          <div class="iso-loading-spinner" aria-hidden="true"></div>
          <p class="text-sm font-medium text-white/50">
            Generating link<span class="iso-loading-ellipsis" aria-hidden="true"></span>
          </p>
        </div>
      </div>

      <!-- Step: done -->
      <div data-msdl-step="done" class="hidden">
        <div class="flex flex-col items-center py-6 text-center">
          <div class="iso-success-rings relative mb-4 flex h-14 w-14 items-center justify-center">
            <div class="iso-success-ring-outer absolute inset-0 rounded-full border border-green-500/[0.12]"></div>
            <div class="iso-success-ring-inner absolute inset-2 rounded-full border border-green-500/20 bg-green-500/[0.04]"></div>
            <Icon name="tabler:check" class="relative z-10 h-5 w-5 text-green-400" />
          </div>
          <p class="mb-1 text-sm font-semibold text-white/90">Download started</p>
          <p class="text-xs text-white/35">Your ISO file is being downloaded</p>
        </div>

        <div class="rounded-lg border border-white/[0.05] bg-white/[0.02]">
          <div class="border-b border-white/[0.04] px-3 py-2">
            <p class="text-[10px] font-semibold uppercase tracking-widest text-white/20">Didn&rsquo;t start? Download manually</p>
          </div>
          <div data-msdl-download-links class="space-y-px p-2"></div>
        </div>

        <button
          type="button"
          data-msdl-restart
          class="mt-4 flex items-center gap-1.5 text-xs text-white/25 transition-colors duration-150 hover:text-white/50 focus-visible:outline-none"
        >
          <Icon name="tabler:arrow-left" class="h-3 w-3" />
          Start over
        </button>
      </div>

      <div data-msdl-step="error" class="hidden">
        <div class="mb-4 flex items-start gap-3 rounded-lg border border-red-500/[0.12] bg-red-500/[0.03] p-3.5">
          <Icon name="tabler:alert-circle" class="mt-0.5 h-4 w-4 shrink-0 text-red-400/70" />
          <p class="text-xs leading-relaxed text-white/50" data-msdl-error-msg></p>
        </div>
        <div class="flex items-center gap-3">
          <button
            type="button"
            data-msdl-retry
            class="flex items-center gap-1.5 rounded text-xs text-white/35 transition-colors duration-150 hover:text-white/65 focus-visible:outline-none"
          >
            <Icon name="tabler:refresh" class="h-3.5 w-3.5" />
            Retry
          </button>
          <span class="h-3 w-px bg-white/10"></span>
          <button
            type="button"
            data-msdl-restart
            class="text-xs text-white/35 transition-colors duration-150 hover:text-white/65 focus-visible:outline-none"
          >
            Start over
          </button>
        </div>
      </div>

    </div>
  </TabPanel>

  <TabPanel value="microsoft-site">
    <ol>
      <li>Visit <a href="https://www.microsoft.com/software-download/windows11">Microsoft's Windows 11 download page</a></li>
      <li>Choose <strong>Download Windows 11 Disk Image (ISO) for x64 devices</strong> (or ARM64 for ARM systems)</li>
      <li>Select <strong>Windows 11 (multi-edition ISO)</strong><IconArrow /><strong>Confirm</strong></li>
      <li>Choose your language<IconArrow /><strong>Confirm</strong></li>
      <li>Click <strong>64-bit Download</strong> (or <strong>ARM64 Download</strong> for ARM) to begin</li>
    </ol>
  </TabPanel>

  <TabPanel value="media-creation-tool">
    <ol>
      <li>Download the <a href="https://go.microsoft.com/fwlink/?linkid=2156295">Windows 11 Media Creation Tool</a>, then open it</li>
      <li>Click <strong>Accept</strong> to agree to the license terms</li>
      <li>Select <strong>Create installation media (USB flash drive, DVD, or ISO file) for another PC</strong>, click <strong>Next</strong>, and choose your language and <strong>Windows 11</strong></li>
      <li>Choose the <strong>ISO file</strong> option, then choose the download location</li>
      <li>After the download completes, click <strong>Finish</strong></li>
    </ol>
  </TabPanel>

  {includeAmeBeta && (
    <TabPanel value="ame-beta">
      <ol>
        <li>Go to <a href="https://atlasos.net">atlasos.net</a>, click <strong>Get started</strong>, then <strong>Already following the guide?</strong></li>
        <li>Download <strong>Atlas Playbook</strong> and <strong>AME Beta</strong>, then extract both to your desktop</li>
        <li>Open <CodeInline text="AME Beta.exe" /> from the AME Beta folder</li>
        <li>If SmartScreen warns, see <a href="/docs/faq/ame/#ame-beta-deleted-or-closed-suddenly">AME Beta deleted</a>. Click <strong>More info</strong> and <strong>Run anyway</strong></li>
        <li>Click <strong>Updates</strong> at the top and ensure AME Beta is up to date</li>
        <li>Click <strong>More Options</strong><IconArrow /><strong>Download ISO</strong><IconArrow />Select <strong>Windows 11</strong><IconArrow /><strong>OK</strong></li>
      </ol>
      <p class="mt-4">This downloads the latest Windows 11 ISO.</p>
    </TabPanel>
  )}
</Tabs>

<style>
  .msdl-widget [data-msdl-step] {
    animation: msdl-in 220ms cubic-bezier(0.33, 1, 0.68, 1) both;
  }

  .msdl-widget [data-msdl-step].hidden {
    display: none;
  }

  /* Loading states */
  .iso-loading-spinner {
    width: 32px;
    height: 32px;
    border: 2px solid rgb(255 255 255 / 0.08);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: iso-spin 0.7s linear infinite;
  }

  .iso-loading-ellipsis::after {
    content: '...';
    animation: iso-ellipsis-pulse 1.2s ease-in-out infinite;
  }

  @keyframes iso-spin {
    to { transform: rotate(360deg); }
  }

  @keyframes iso-ellipsis-pulse {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }

  @keyframes msdl-in {
    from {
      opacity: 0;
      transform: translateY(6px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* Architecture selection cards */
  .iso-arch-btn {
    transition:
      border-color 180ms cubic-bezier(0.33, 1, 0.68, 1),
      background-color 180ms cubic-bezier(0.33, 1, 0.68, 1),
      box-shadow 180ms cubic-bezier(0.33, 1, 0.68, 1),
      transform 100ms cubic-bezier(0.33, 1, 0.68, 1);
  }

  .iso-arch-btn:hover {
    border-color: color-mix(in oklch, var(--color-primary) 35%, transparent);
    background-color: color-mix(in oklch, var(--color-primary) 5%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--color-primary) 8%, transparent),
      0 4px 16px color-mix(in oklch, var(--color-primary) 6%, transparent);
  }

  /* Get download link button */
  .iso-get-download-btn {
    background: linear-gradient(
      160deg,
      color-mix(in oklch, var(--color-primary) 90%, white 10%) 0%,
      color-mix(in oklch, var(--color-primary) 70%, black 30%) 100%
    );
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.3), 0 0 0 1px color-mix(in oklch, var(--color-primary) 40%, transparent);
  }

  .iso-get-download-btn:not(:disabled):hover {
    box-shadow: 0 2px 8px color-mix(in oklch, var(--color-primary) 25%, transparent), 0 0 0 1px color-mix(in oklch, var(--color-primary) 50%, transparent);
    transform: translateY(-1px);
  }

  .iso-get-download-btn:not(:disabled):hover svg {
    transform: translateX(2px);
  }

  .iso-get-download-btn:not(:disabled):active {
    transform: scale(0.98) translateY(0);
  }

  /* Success state rings */
  .iso-success-rings {
    animation: iso-success-pop 400ms cubic-bezier(0.32, 0.72, 0, 1) both;
  }

  .iso-success-ring-outer {
    animation: iso-ring-pulse 2.4s ease-in-out 300ms infinite;
  }

  @keyframes iso-success-pop {
    from {
      opacity: 0;
      transform: scale(0.7);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes iso-ring-pulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.08); }
  }

  /* Dropdown panel */
  .msdl-select-panel {
    transform-origin: top center;
    animation: msdl-dropdown-in 180ms cubic-bezier(0.33, 1, 0.68, 1) both;
    will-change: transform, opacity, filter;
  }

  @keyframes msdl-dropdown-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  .msdl-options-scroll {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.06) transparent;
  }
  .msdl-options-scroll::-webkit-scrollbar { width: 3px; }
  .msdl-options-scroll::-webkit-scrollbar-track { background: transparent; }
  .msdl-options-scroll::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.07);
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .msdl-widget [data-msdl-step],
    .msdl-select-panel,
    .iso-arch-btn,
    .iso-success-rings,
    .iso-success-ring-outer,
    .iso-loading-spinner,
    .iso-loading-ellipsis::after {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  const ARCH_LABELS: Record<string, string> = {
    x64: 'Windows 11 25H2 · x64',
    arm64: 'Windows 11 25H2 · ARM64',
  };

  interface SkuInfo {
    Id: string | number;
    Language: string;
    LocalizedLanguage: string;
    FriendlyFileNames?: string[];
  }

  let panelIdCounter = 0;

  function buildSelectPanel(
    wrapper: HTMLElement,
    skus: SkuInfo[],
    onSelect: (id: string | number, label: string, language: string, friendlyFileNames?: string[]) => void,
  ) {
    const trigger = wrapper.querySelector<HTMLButtonElement>('[data-msdl-select-trigger]')!;
    const chevron = wrapper.querySelector<SVGElement>('[data-msdl-select-chevron]')!;
    const valueEl = wrapper.querySelector<HTMLElement>('[data-msdl-select-value]')!;
    const panelId = `msdl-listbox-${++panelIdCounter}`;

    trigger.setAttribute('aria-controls', panelId);

    let panel: HTMLElement | null = null;
    let scroll: HTMLElement | null = null;
    let isOpen = false;

    function getOptions() {
      if (!panel) return [];
      return Array.from(panel.querySelectorAll('[role="option"]')).filter((el): el is HTMLElement => el instanceof HTMLElement);
    }

    function focusOption(el: HTMLElement) {
      el.focus();
      getOptions().forEach((o) => o.setAttribute('aria-selected', o === el ? 'true' : 'false'));
    }

    function positionPanel() {
      if (!panel) return;
      const rect = trigger.getBoundingClientRect();
      panel.style.top = `${rect.bottom + 4}px`;
      panel.style.left = `${rect.left}px`;
      panel.style.width = `${rect.width}px`;
    }

    function openPanel() {
      if (isOpen) return;
      isOpen = true;
      trigger.setAttribute('aria-expanded', 'true');
      chevron.style.transform = 'rotate(180deg)';

      panel = document.createElement('div');
      panel.id = panelId;
      panel.className = 'msdl-select-panel overflow-hidden rounded-md border border-white/[0.08]';
      panel.style.cssText = 'position: fixed; z-index: 9999; background-color: var(--bg-primary);';
      panel.setAttribute('role', 'listbox');
      panel.setAttribute('aria-label', 'Select language');

      scroll = document.createElement('div');
      scroll.className = 'msdl-options-scroll max-h-52 overflow-y-auto py-1';

      skus.forEach((sku) => {
        const opt = document.createElement('button');
        opt.type = 'button';
        opt.setAttribute('role', 'option');
        opt.setAttribute('aria-selected', 'false');
        opt.dataset.value = String(sku.Id);
        opt.textContent = sku.LocalizedLanguage;
        opt.className =
          'w-full cursor-pointer px-3 py-2.5 text-left text-sm text-white/65 transition-colors duration-100 hover:bg-white/[0.06] hover:text-white/90 focus:outline-none focus:bg-white/[0.06] focus:text-white/90';

        opt.addEventListener('click', () => selectOption(sku.Id, sku.LocalizedLanguage, sku.Language, sku.FriendlyFileNames));

        opt.addEventListener('keydown', (e) => {
          const opts = getOptions();
          const idx = opts.indexOf(opt);
          if (e.key === 'ArrowDown') { e.preventDefault(); focusOption(opts[(idx + 1) % opts.length]!); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); focusOption(opts[(idx - 1 + opts.length) % opts.length]!); }
          else if (e.key === 'Escape') { e.preventDefault(); closePanel(); trigger.focus(); }
          else if (e.key === 'Tab') { closePanel(); }
        });

        scroll!.appendChild(opt);
      });

      panel.appendChild(scroll);
      document.body.appendChild(panel);
      positionPanel();

      const firstOpt = getOptions()[0];
      if (firstOpt) requestAnimationFrame(() => focusOption(firstOpt));

      window.addEventListener('scroll', positionPanel, { passive: true });
      window.addEventListener('resize', positionPanel, { passive: true });

      setTimeout(() => {
        document.addEventListener('click', outsideClickHandler, { once: true });
      }, 0);
    }

    function selectOption(id: string | number, label: string, language: string, friendlyFileNames?: string[]) {
      valueEl.textContent = label;
      valueEl.classList.remove('text-white/35');
      valueEl.classList.add('text-white/85');
      onSelect(id, label, language, friendlyFileNames);
      closePanel();
      trigger.focus();
    }

    function closePanel() {
      if (!isOpen) return;
      isOpen = false;
      trigger.setAttribute('aria-expanded', 'false');
      chevron.style.transform = '';
      panel?.remove();
      panel = null;
      scroll = null;
      window.removeEventListener('scroll', positionPanel);
      window.removeEventListener('resize', positionPanel);
    }

    function outsideClickHandler(e: MouseEvent) {
      if (!wrapper.contains(e.target as Node) && !panel?.contains(e.target as Node)) {
        closePanel();
      }
    }

    trigger.addEventListener('click', () => {
      if (isOpen) {
        closePanel();
      } else {
        openPanel();
      }
    });

    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown') {
        e.preventDefault();
        if (!isOpen) openPanel();
      } else if (e.key === 'Escape' && isOpen) {
        e.preventDefault();
        closePanel();
      }
    });

    return {
      close: closePanel,
      reset() {
        closePanel();
        valueEl.textContent = 'Choose a language\u2026';
        valueEl.classList.remove('text-white/85');
        valueEl.classList.add('text-white/35');
      },
    };
  }

  function initMsdlWidget(root: HTMLElement) {
    let currentArch: string | null = null;
    let currentSkuId: string | number | null = null;
    let currentFriendlyFileNames: string[] | null = null;
    let currentSessionId: string | null = null;
    let retryAction: (() => void) | null = null;
    let selectControl: ReturnType<typeof buildSelectPanel> | null = null;

    function showStep(step: string) {
      root.querySelectorAll('[data-msdl-step]').forEach((el) => {
        el.classList.toggle('hidden', el.getAttribute('data-msdl-step') !== step);
      });
    }

    function showError(message: string, retry?: () => void) {
      const errorMsg = root.querySelector<HTMLElement>('[data-msdl-error-msg]');
      if (errorMsg) errorMsg.textContent = message;
      retryAction = retry ?? null;
      showStep('error');
    }

    async function fetchLanguages(arch: string) {
      currentArch = arch;
      currentSkuId = null;
      currentSessionId = crypto.randomUUID();
      showStep('loading-langs');

      try {
        const res = await fetch(`/api/ms-iso/skus?arch=${arch}&sessionId=${currentSessionId}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const skuError =
          data.Errors?.[0]?.Value ??
          data.ValidationContainer?.Errors?.[0]?.Value ??
          data.ValidationContainer?.ErrorList?.[0]?.Value;
        if (skuError) throw new Error(skuError);
        renderLanguageSelect(data, arch);
      } catch {
        showError(
          'Could not fetch languages. The download service may be temporarily unavailable — try another method below.',
          () => fetchLanguages(arch),
        );
      }
    }

    function renderLanguageSelect(
      data: { Skus?: SkuInfo[] },
      arch: string,
    ) {
      const archLabel = root.querySelector<HTMLElement>('[data-msdl-arch-label]');
      const getDownloadBtn = root.querySelector<HTMLButtonElement>('[data-msdl-get-download]');
      const wrapper = root.querySelector<HTMLElement>('[data-msdl-select-wrapper]');

      if (!archLabel || !getDownloadBtn || !wrapper) return;

      archLabel.textContent = ARCH_LABELS[arch] ?? arch;

      const skus = data.Skus ?? [];

      selectControl?.reset();

      selectControl = buildSelectPanel(wrapper, skus, (id, _label, _language, friendlyFileNames) => {
        currentSkuId = id;
        currentFriendlyFileNames = friendlyFileNames ?? null;
        getDownloadBtn.disabled = false;
      });

      currentSkuId = null;
      currentFriendlyFileNames = null;
      getDownloadBtn.disabled = true;
      showStep('select-lang');
    }

    async function fetchDownload() {
      if (!currentArch || currentSkuId === null) return;
      showStep('loading-download');

      const params = new URLSearchParams({
        arch: currentArch,
        skuId: String(currentSkuId),
        ...(currentSessionId ? { sessionId: currentSessionId } : {}),
      });
      try {
        const res = await fetch(`/api/ms-iso/links?${params}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        renderDownloads(data);
      } catch {
        showError(
          'Could not generate download links. Please retry or use the Microsoft website tab.',
          fetchDownload,
        );
      }
    }

    interface DownloadOption {
      Uri: string;
      ProductDisplayName: string;
      LocalizedLanguage: string;
    }

    interface ProxyError {
      Key?: string;
      Value?: string;
      Type?: number;
    }

    function getProxyErrorMessage(errors: ProxyError[]): string {
      const first = errors[0];
      if (!first?.Value) return 'The download service is temporarily unavailable. Please try again in a moment or use the Microsoft website tab.';
      if (first.Key === 'ErrorSettings.SentinelReject') {
        return 'The download service is temporarily unavailable. Please try again in a moment or use the Microsoft website tab.';
      }
      if (first.Key === 'ErrorSettings.BrowserRenderingFailed') {
        return 'The download service is temporarily unavailable. Please try again in a moment or use the Microsoft website tab.';
      }
      if (first.Key === 'ErrorSettings.ProductKeyValidationError') {
        return 'This language could not be retrieved from the download service. Try a different language or use the Microsoft website tab.';
      }
      return first.Value;
    }

    function renderDownloads(data: { ProductDownloadOptions?: DownloadOption[]; Errors?: ProxyError[] }) {
      const linksContainer = root.querySelector<HTMLElement>('[data-msdl-download-links]');
      if (!linksContainer) return;
      linksContainer.innerHTML = '';

      if (data.Errors?.length) {
        showError(getProxyErrorMessage(data.Errors), fetchDownload);
        return;
      }

      const options = data.ProductDownloadOptions;
      if (!options || options.length === 0) {
        showError('No download options were returned. Try a different language or use another method.');
        return;
      }

      const preferredFilename = currentFriendlyFileNames?.[0];
      let didAutoDownload = false;
      options.forEach((option, index) => {
        const uriBase = option.Uri.split('?')[0] ?? option.Uri;
        const parts = uriBase.split('/');
        const filename = preferredFilename ?? (parts[parts.length - 1] ?? 'Windows.iso');

        const link = document.createElement('a');
        link.href = option.Uri;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.className =
          'flex w-full items-center gap-2.5 rounded-md px-2.5 py-2 text-xs text-white/60 transition-colors duration-150 hover:bg-white/[0.04] hover:text-white/85';
        link.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-white/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/><path d="M7 11l5 5 5-5"/><path d="M12 4v12"/></svg><span class="truncate font-medium">${filename}</span>`;
        linksContainer.appendChild(link);

        if (!didAutoDownload && index === 0) {
          const autoLink = document.createElement('a');
          autoLink.href = option.Uri;
          autoLink.download = filename;
          document.body.appendChild(autoLink);
          autoLink.click();
          document.body.removeChild(autoLink);
          didAutoDownload = true;
        }
      });

      showStep('done');
    }

    function resetWidget() {
      selectControl?.reset();
      selectControl = null;
      currentArch = null;
      currentSkuId = null;
      currentFriendlyFileNames = null;
      currentSessionId = null;
      retryAction = null;
      showStep('idle');
    }

    root.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const archBtn = target.closest<HTMLElement>('[data-msdl-arch-btn]');
      if (archBtn?.dataset.msdlArchBtn) { fetchLanguages(archBtn.dataset.msdlArchBtn); return; }
      if (target.closest('[data-msdl-back]')) { resetWidget(); return; }
      if (target.closest('[data-msdl-get-download]')) { fetchDownload(); return; }
      if (target.closest('[data-msdl-restart]')) { resetWidget(); return; }
      if (target.closest('[data-msdl-retry]')) { retryAction?.(); return; }
    });
  }

  function initAllMsdlWidgets() {
    document.querySelectorAll('[data-msdl-root]:not([data-msdl-initialized])').forEach((el) => {
      const root = el as HTMLElement;
      root.setAttribute('data-msdl-initialized', 'true');
      initMsdlWidget(root);
    });
  }

  document.addEventListener('astro:page-load', initAllMsdlWidgets);
  initAllMsdlWidgets();
</script>
