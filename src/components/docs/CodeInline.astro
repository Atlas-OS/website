---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<span
  class="code-inline-wrapper docs-inline not-prose inline px-1.5 py-0.5 align-baseline font-mono text-sm text-[var(--color-primary)] transition-opacity duration-200 hover:opacity-80"
  data-component="code-inline">{text.trim()}</span
>
