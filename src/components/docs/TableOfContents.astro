---
import { Icon } from 'astro-icon/components';

interface Props {
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { headings = [] } = Astro.props;

const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  filteredHeadings.length > 0 && (
    <aside
      id="toc"
      data-pagefind-ignore
      class="fixed z-20 hidden overflow-y-auto px-6 py-6 xl:block"
      style="top: var(--docs-header-height); right: var(--docs-toc-inset); width: var(--docs-toc-width); height: calc(100vh - var(--docs-header-height));"
    >
      <nav class="sticky top-6 z-10 -mr-2 max-h-[calc(100vh-4rem)] overflow-y-auto px-2" aria-label="On this page">
        <div class="space-y-4">
          <h2 class="mb-4 text-sm font-semibold" style="color: var(--docs-text-muted);">
            On this page
          </h2>
          <div class="relative">
            <div
              id="toc-marker"
              class="absolute left-0 w-[2px] rounded-full bg-primary opacity-0 transition-[height,opacity,top] duration-300 ease-[cubic-bezier(0.25,0.1,0.25,1.0)]"
              style="top: 0; height: 0;"
            >
              <div class="absolute inset-0 bg-primary/50 blur-[2px]" />
            </div>

            <ul class="space-y-2">
              {filteredHeadings.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class={`toc-link block min-h-8 w-full rounded-sm py-1 text-start text-sm transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary ${
                      heading.depth === 3 ? 'pl-6' : 'pl-4'
                    } hover:text-[var(--docs-text-primary)]`}
                    style="scroll-behavior: smooth;"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="toc-utilities mt-6 flex flex-col gap-2 border-t border-white/[0.06] pt-4">
            <button
              type="button"
              id="toc-copy-link"
              class="toc-utility-link -mx-2 inline-flex min-h-9 items-center gap-2 rounded-md px-2 text-start text-sm transition-colors duration-150 hover:text-[var(--docs-text-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              style="color: var(--docs-text-muted);"
            >
              <Icon name="tabler:copy" class="h-4 w-4 shrink-0" aria-hidden="true" />
              <span data-copy-link-label>Copy link</span>
            </button>
            <a
              href="https://github.com/Atlas-OS/website/issues"
              target="_blank"
              rel="noopener noreferrer"
              class="toc-utility-link -mx-2 inline-flex min-h-9 items-center gap-2 rounded-md px-2 text-sm transition-colors duration-150 hover:text-[var(--docs-text-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              style="color: var(--docs-text-muted);"
            >
              <Icon name="tabler:message-report" class="h-4 w-4 shrink-0" aria-hidden="true" />
              <span>Share feedback</span>
            </a>
          </div>
          <span id="toc-copy-status" class="sr-only" role="status" aria-live="polite" />
        </div>
      </nav>
    </aside>
  )
}

<style>
  #toc {
    background-color: transparent;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
  }

  #toc::-webkit-scrollbar {
    width: 6px;
  }

  #toc::-webkit-scrollbar-track {
    background: transparent;
  }

  #toc::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
  }

  #toc::-webkit-scrollbar-thumb:hover {
    background-color: rgba(255, 255, 255, 0.2);
  }

  .toc-link {
    color: var(--docs-text-muted);
  }

  .toc-active {
    color: var(--color-primary);
  }
</style>

<script>
  let tableOfContentsController: AbortController | null = null;

  function setupTableOfContents(signal: AbortSignal) {
    const toc = document.querySelector('#toc');
    if (!toc) return;
    if (toc instanceof HTMLElement && toc.dataset.tocInitialized === 'true') return;
    if (toc instanceof HTMLElement) {
      toc.dataset.tocInitialized = 'true';
    }

    const tocLinks = Array.from(toc.querySelectorAll('a.toc-link'));
    const marker = toc.querySelector('#toc-marker') as HTMLElement;

    if (!tocLinks.length || !marker) return;

    const headingIds = tocLinks.map((link) => link.getAttribute('href')?.substring(1)).filter(Boolean) as string[];
    const headings = headingIds
      .map((id) => {
        const el = document.getElementById(id);
        return el ? { id, element: el } : null;
      })
      .filter((h): h is { id: string; element: HTMLElement } => h !== null);

    if (headings.length === 0) return;

    let headingOffsets: Array<{ id: string; top: number }> = [];
    let activeHeadingId: string | null = null;
    let animationFrame = 0;

    const measureHeadings = () => {
      headingOffsets = headings.map((heading) => ({
        id: heading.id,
        top: heading.element.getBoundingClientRect().top + window.scrollY,
      }));
    };

    const updateActiveLink = () => {
      animationFrame = 0;
      const scrollPosition = window.scrollY + 100;
      let nextActiveHeadingId: string | null = null;

      for (let i = headingOffsets.length - 1; i >= 0; i--) {
        const heading = headingOffsets[i];
        if (!heading) continue;
        if (scrollPosition >= heading.top) {
          nextActiveHeadingId = heading.id;
          break;
        }
      }

      if (nextActiveHeadingId === activeHeadingId) return;
      activeHeadingId = nextActiveHeadingId;

      tocLinks.forEach((link) => {
        link.classList.remove('toc-active', 'text-white');
        link.removeAttribute('aria-current');
      });

      if (activeHeadingId) {
        const activeLink = tocLinks.find((link) => link.getAttribute('href') === `#${activeHeadingId}`) as HTMLElement;

        if (activeLink) {
          activeLink.classList.add('toc-active');
          activeLink.setAttribute('aria-current', 'location');

          const linkRect = activeLink.getBoundingClientRect();
          const containerRect = marker.parentElement?.getBoundingClientRect();

          if (containerRect) {
            const top = linkRect.top - containerRect.top;
            const height = linkRect.height;

            marker.style.top = `${top}px`;
            marker.style.height = `${height}px`;
            marker.style.opacity = '1';
          }
        }
      } else {
        marker.style.opacity = '0';
      }
    };

    const scheduleUpdate = () => {
      if (!animationFrame) animationFrame = window.requestAnimationFrame(updateActiveLink);
    };
    const handleResize = () => {
      measureHeadings();
      activeHeadingId = null;
      scheduleUpdate();
    };

    measureHeadings();
    window.addEventListener('scroll', scheduleUpdate, { passive: true, signal });
    window.addEventListener('resize', handleResize, { signal });
    updateActiveLink();
  }

  function setupCopyLink() {
    const btn = document.getElementById('toc-copy-link');
    if (!btn) return;
    if (btn.dataset.copyBound === 'true') return;
    btn.dataset.copyBound = 'true';

    btn.addEventListener('click', async () => {
      const label = btn.querySelector<HTMLElement>('[data-copy-link-label]');
      const status = document.getElementById('toc-copy-status');
      const originalText = label?.textContent || 'Copy link';
      const setLabel = (text: string) => {
        if (label) {
          label.textContent = text;
        } else {
          btn.textContent = text;
        }
      };

      try {
        await navigator.clipboard.writeText(window.location.href);
        setLabel('Copied');
        if (status) status.textContent = 'Page link copied';
        setTimeout(() => {
          setLabel(originalText);
          if (status) status.textContent = '';
        }, 2000);
      } catch {
        setLabel('Unable to copy');
        if (status) status.textContent = 'Unable to copy the page link';
        setTimeout(() => {
          setLabel('Copy link');
          if (status) status.textContent = '';
        }, 2000);
      }
    });
  }

  function initTableOfContents() {
    tableOfContentsController?.abort();
    tableOfContentsController = new AbortController();
    setupTableOfContents(tableOfContentsController.signal);
    setupCopyLink();
  }

  document.addEventListener('astro:page-load', initTableOfContents);
</script>
