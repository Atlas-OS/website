---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** Imported image (`import shot from '@/assets/...'`) or a `/assets/...` path from `public/`. */
  src: ImageMetadata | string;
  /** Describes the image for readers who cannot see it. Use `""` when the caption already says it all. */
  alt: string;
  /** Visible caption rendered below the frame. */
  caption?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { src, alt, caption, width, height, loading = 'lazy', class: className = '' } = Astro.props;
const imageClass = 'block h-auto w-full rounded-[calc(var(--docs-radius-md)-1px)]';
---

<figure class:list={['docs-figure not-prose my-6', className]} data-component="figure">
  <div class="docs-figure-frame">
    {typeof src === 'string' ? (
      <img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" class={imageClass} />
    ) : (
      <Image src={src} alt={alt} width={width} height={height} loading={loading} class={imageClass} />
    )}
  </div>
  {caption && <figcaption class="mt-3 text-center text-sm text-[var(--docs-text-muted)]">{caption}</figcaption>}
</figure>

<style>
  .docs-figure-frame {
    overflow: hidden;
    border: 1px solid var(--docs-surface-border);
    border-radius: var(--docs-radius-md);
    background: var(--docs-surface-bg);
  }

  .docs-figure-frame :global(img) {
    background: var(--docs-panel-bg);
  }
</style>
