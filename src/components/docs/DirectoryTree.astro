---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class={`directory-tree docs-surface not-prose mb-6 overflow-x-auto p-5 font-mono text-sm leading-relaxed ${className}`}
  style="color: var(--docs-text-primary);"
  data-component="directory-tree"
>
  <pre class="m-0 font-mono text-sm leading-relaxed whitespace-pre"><slot /></pre>
</div>

<style>
  .directory-tree pre {
    font-family: var(--font-mono);
    color: var(--docs-text-primary);
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
  }
</style>
