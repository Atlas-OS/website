---
import { getSlugFromEntry, normalizeSlug } from '@/utils/navigation';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const docs = await getCollection('docs', entry => !entry.data.draft);
const titleBySlug = new Map<string, string>();

for (const entry of docs) {
  const slug = normalizeSlug(getSlugFromEntry(entry));
  titleBySlug.set(slug, entry.data.sidebar?.label || entry.data.title);
}

function toTitleFromSegment(segment: string): string {
  return segment
    .split('-')
    .filter(Boolean)
    .map(part => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');
}

function buildBreadcrumbs(slug: string): Array<{ title: string; href: string }> {
  const normalized = normalizeSlug(slug);
  if (!normalized.startsWith('/docs/')) {
    return [];
  }

  const withoutPrefix = normalized
    .replace(/^\/docs\/?/, '')
    .replace(/^\/+/, '')
    .replace(/\/+$/, '');

  const segments = withoutPrefix ? withoutPrefix.split('/').filter(Boolean) : [];

  const breadcrumbs: Array<{ title: string; href: string }> = [
    {
      title: titleBySlug.get('/docs/') || 'Home',
      href: '/docs/',
    },
  ];

  let currentPath = '';
  for (const segment of segments) {
    currentPath += `/${segment}`;
    const href = `/docs${currentPath}/`;

    breadcrumbs.push({
      title: titleBySlug.get(href) || toTitleFromSegment(segment),
      href,
    });
  }

  return breadcrumbs;
}

const breadcrumbs = buildBreadcrumbs(currentSlug);
const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.title,
    item: new URL(crumb.href, Astro.site || 'https://atlasos.net').href,
  })),
};
---

{
  breadcrumbs.length > 1 && (
    <nav aria-label="Breadcrumb" class="breadcrumbs-animated mb-5">
      <ol class="flex flex-wrap items-center text-sm" style="color: var(--docs-text-muted);">
        {breadcrumbs.map((crumb, index) => (
          <li class="breadcrumb-item flex items-center" style={`animation-delay: ${index * 50}ms`}>
            {index > 0 && (
              <Icon
                name="tabler:chevron-right"
                class="mx-1.5 h-4 w-4 transition-colors duration-200"
                style="color: var(--docs-text-muted);"
                aria-hidden="true"
              />
            )}
            {index === breadcrumbs.length - 1 ? (
              <span class="font-medium" style="color: var(--docs-text-secondary);">{crumb.title}</span>
            ) : (
              <a
                href={crumb.href}
                class="focus-visible:ring-primary/50 py-1 transition-opacity duration-200 hover:opacity-80 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-black"
                style="border-radius: var(--docs-radius-sm);"
              >
                <span>{crumb.title}</span>
              </a>
            )}
          </li>
        ))}
      </ol>
      <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbStructuredData)} />
    </nav>
  )
}

<style>
  .breadcrumbs-animated {
    animation: breadcrumbs-fade-in var(--motion-duration-normal, 250ms) var(--motion-ease-out, cubic-bezier(0.33, 1, 0.68, 1)) backwards;
  }

  @keyframes breadcrumbs-fade-in {
    from {
      opacity: 0;
      transform: translateY(-5px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .breadcrumb-item {
    animation: breadcrumb-item-fade-in var(--motion-duration-fast, 180ms) var(--motion-ease-out, cubic-bezier(0.33, 1, 0.68, 1)) backwards;
  }

  @keyframes breadcrumb-item-fade-in {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
