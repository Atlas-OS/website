---
import { SITE_URL } from '@/constants';
import { getDocsBreadcrumbs } from '@/utils/docs';
import { Icon } from 'astro-icon/components';

interface Props {
  currentSlug: string;
}

const breadcrumbs = await getDocsBreadcrumbs(Astro.props.currentSlug);
const site = Astro.site ?? SITE_URL;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.title,
    item: new URL(crumb.href, site).href,
  })),
};
---

{breadcrumbs.length > 1 && (
  <nav aria-label="Breadcrumb" class="mb-6" data-pagefind-ignore>
    <ol class="flex flex-wrap items-center text-sm text-[var(--docs-text-muted)]">
      {breadcrumbs.map((crumb, index) => (
        <li class="breadcrumb-item flex items-center" data-breadcrumb-path={crumb.href}>
          {index > 0 && <Icon name="tabler:chevron-right" class="mx-1.5 h-4 w-4" aria-hidden="true" />}
          {index === breadcrumbs.length - 1 ? (
            <span
              class="breadcrumb-label inline-block font-medium text-[var(--docs-text-secondary)]"
              aria-current="page"
            >
              {crumb.title}
            </span>
          ) : (
            <a
              href={crumb.href}
              class="breadcrumb-label inline-block rounded-[var(--docs-radius-sm)] py-1 transition-opacity duration-200 hover:opacity-80 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-black"
            >
              {crumb.title}
            </a>
          )}
        </li>
      ))}
    </ol>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
  </nav>
)}

<script>
  import { prefersReducedMotion } from '@/utils/page-lifecycle';

  let previousPaths: string[] | null = null;

  const getItems = () => Array.from(document.querySelectorAll<HTMLElement>('[data-breadcrumb-path]'));

  function animateOnce(element: HTMLElement, className: string) {
    element.classList.add(className);
    element.addEventListener('animationend', () => element.classList.remove(className), { once: true });
  }

  document.addEventListener('astro:before-swap', () => {
    previousPaths = getItems().map((item) => item.dataset.breadcrumbPath ?? '');
  });

  document.addEventListener('astro:page-load', () => {
    const before = previousPaths;
    previousPaths = null;
    if (!before || prefersReducedMotion()) return;

    const items = getItems();
    const current = items.map((item) => item.dataset.breadcrumbPath ?? '');

    // Changing section replays the whole branch; a deeper page only animates the new tail.
    if (before[1] !== current[1]) {
      items.slice(1).forEach((item) => animateOnce(item, 'breadcrumb-branch-entering'));
      return;
    }

    let common = 0;
    while (common < before.length && common < current.length && before[common] === current[common]) common += 1;

    for (const item of items.slice(common)) {
      const label = item.querySelector<HTMLElement>('.breadcrumb-label');
      if (label) animateOnce(label, 'breadcrumb-label-entering');
    }
  });
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .breadcrumb-branch-entering,
    .breadcrumb-label-entering {
      animation: breadcrumb-item-fade-in var(--motion-duration-fast) var(--motion-ease-out) backwards;
    }
  }

  @keyframes breadcrumb-item-fade-in {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
