---
import { SITE_URL } from '@/constants';
import { getDocsTitleBySlug } from '@/utils/docs-content';
import { normalizeSlug } from '@/utils/navigation';
import { Icon } from 'astro-icon/components';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const titleBySlug = await getDocsTitleBySlug();

function toTitleFromSegment(segment: string): string {
  return segment
    .split('-')
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');
}

function buildBreadcrumbs(slug: string): Array<{ title: string; href: string }> {
  const normalized = normalizeSlug(slug);
  if (!normalized.startsWith('/docs/')) {
    return [];
  }

  const withoutPrefix = normalized
    .replace(/^\/docs\/?/, '')
    .replace(/^\/+/, '')
    .replace(/\/+$/, '');

  const segments = withoutPrefix ? withoutPrefix.split('/').filter(Boolean) : [];

  const breadcrumbs: Array<{ title: string; href: string }> = [
    {
      title: titleBySlug.get('/docs/') || 'Home',
      href: '/docs/',
    },
  ];

  let currentPath = '';
  for (const segment of segments) {
    currentPath += `/${segment}`;
    const href = `/docs${currentPath}/`;

    breadcrumbs.push({
      title: titleBySlug.get(href) || toTitleFromSegment(segment),
      href,
    });
  }

  return breadcrumbs;
}

const breadcrumbs = buildBreadcrumbs(currentSlug);
const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.title,
    item: new URL(crumb.href, Astro.site || SITE_URL).href,
  })),
};
---

{
  breadcrumbs.length > 1 && (
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex flex-wrap items-center text-sm" style="color: var(--docs-text-muted);">
        {breadcrumbs.map((crumb, index) => (
          <li class="breadcrumb-item flex items-center" data-breadcrumb-path={crumb.href}>
            {index > 0 && (
              <Icon
                name="tabler:chevron-right"
                class="mx-1.5 h-4 w-4 transition-colors duration-200"
                style="color: var(--docs-text-muted);"
                aria-hidden="true"
              />
            )}
            {index === breadcrumbs.length - 1 ? (
              <span
                class="breadcrumb-label inline-block font-medium"
                style="color: var(--docs-text-secondary);"
                aria-current="page"
              >
                {crumb.title}
              </span>
            ) : (
              <a
                href={crumb.href}
                class="breadcrumb-label inline-block py-1 transition-opacity duration-200 hover:opacity-80 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-black"
                style="border-radius: var(--docs-radius-sm);"
              >
                <span>{crumb.title}</span>
              </a>
            )}
          </li>
        ))}
      </ol>
      <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbStructuredData)} />
    </nav>
  )
}

<script>
  let previousBreadcrumbPaths: string[] | null = null;

  function getBreadcrumbItems(): HTMLElement[] {
    return Array.from(document.querySelectorAll<HTMLElement>('[data-breadcrumb-path]'));
  }

  function captureBreadcrumbPaths() {
    previousBreadcrumbPaths = getBreadcrumbItems().map((item) => item.dataset.breadcrumbPath || '');
  }

  function animateChangedBreadcrumbs() {
    if (!previousBreadcrumbPaths) return;

    const items = getBreadcrumbItems();
    const currentPaths = items.map((item) => item.dataset.breadcrumbPath || '');
    let commonPathLength = 0;

    while (
      commonPathLength < previousBreadcrumbPaths.length &&
      commonPathLength < currentPaths.length &&
      previousBreadcrumbPaths[commonPathLength] === currentPaths[commonPathLength]
    ) {
      commonPathLength += 1;
    }

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const parentChanged = previousBreadcrumbPaths[1] !== currentPaths[1];

      if (parentChanged) {
        for (const item of items.slice(1)) {
          item.classList.add('breadcrumb-branch-entering');
          item.addEventListener('animationend', () => item.classList.remove('breadcrumb-branch-entering'), {
            once: true,
          });
        }
      } else {
        for (const item of items.slice(commonPathLength)) {
          const label = item.querySelector<HTMLElement>('.breadcrumb-label');
          if (!label) continue;

          label.classList.add('breadcrumb-label-entering');
          label.addEventListener('animationend', () => label.classList.remove('breadcrumb-label-entering'), {
            once: true,
          });
        }
      }
    }

    previousBreadcrumbPaths = null;
  }

  document.addEventListener('astro:before-swap', captureBreadcrumbPaths);
  document.addEventListener('astro:page-load', animateChangedBreadcrumbs);
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .breadcrumb-branch-entering,
    .breadcrumb-label-entering {
      animation: breadcrumb-item-fade-in var(--motion-duration-fast, 180ms)
        var(--motion-ease-out, cubic-bezier(0.33, 1, 0.68, 1)) backwards;
    }
  }

  @keyframes breadcrumb-item-fade-in {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
