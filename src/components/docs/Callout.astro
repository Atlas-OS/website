---
import { Icon } from 'astro-icon/components';

interface Props {
  type?: 'info' | 'warning' | 'tip' | 'danger';
  title?: string;
  dismissible?: boolean;
}

const { type = 'info', title, dismissible = false } = Astro.props;

const config = {
  info: {
    icon: 'tabler:info-circle',
    accentColor: 'border-l-primary/50',
    iconColor: 'text-primary',
    defaultTitle: 'Info',
  },
  tip: {
    icon: 'tabler:bulb',
    accentColor: 'border-l-primary/50',
    iconColor: 'text-primary',
    defaultTitle: 'Tip',
  },
  warning: {
    icon: 'tabler:alert-triangle',
    accentColor: 'border-l-yellow-500/50',
    iconColor: 'text-yellow-500',
    defaultTitle: 'Warning',
  },
  danger: {
    icon: 'tabler:alert-circle',
    accentColor: 'border-l-red-500/50',
    iconColor: 'text-red-500',
    defaultTitle: 'Important',
  },
};

const style = config[type];
const displayTitle = title || style.defaultTitle;
---

<div
  class={`callout not-prose astro-component callout-animated border-l-[3px] ${style.accentColor} p-5 my-6 border border-[var(--docs-surface-border)] rounded-r-[var(--docs-radius-lg)]`}
  style="background: var(--docs-surface-bg);"
  data-component="callout"
  data-type={type}
>
  <div class="flex items-start gap-3">
    <div class={`callout-icon-wrapper ${style.iconColor} flex-shrink-0`}>
      <Icon name={style.icon} class="mt-0.5 h-5 w-5" />
    </div>
    <div class="min-w-0 flex-1">
      {displayTitle && <p class={`${style.iconColor} mb-2 text-sm font-semibold`}>{displayTitle}</p>}
      <div class="callout-content text-sm leading-relaxed text-white/90">
        <slot />
      </div>
    </div>
    {
      dismissible && (
        <button
          type="button"
          class="callout-dismiss flex-shrink-0 rounded-[var(--docs-radius-sm)] text-white/40 transition-opacity duration-200 hover:opacity-80 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2"
          aria-label="Dismiss"
        >
          <Icon name="tabler:x" class="h-4 w-4" />
        </button>
      )
    }
  </div>
</div>

<style is:global>
  .callout {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .callout-animated {
    animation: callout-fade-in var(--motion-duration-normal, 250ms) var(--motion-ease-out, cubic-bezier(0.33, 1, 0.68, 1));
  }

  @keyframes callout-fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  .callout-icon-wrapper {
    animation: icon-fade-in 0.6s ease-out;
  }

  @keyframes icon-fade-in {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  .callout-content p {
    margin-top: 0;
    margin-bottom: 0.5rem;
    color: rgb(255 255 255 / 0.9);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .callout-content p:last-child {
    margin-bottom: 0;
  }

  .callout-content strong {
    color: white;
    font-weight: 600;
  }

  .callout-content a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.2s ease-in-out;
  }

  .callout-content a:hover {
    opacity: 0.8;
  }

  .callout-content ul,
  .callout-content ol {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    margin-left: 1.25rem;
    padding-left: 0;
  }

  .callout-content li {
    margin-bottom: 0.25rem;
    color: rgb(255 255 255 / 0.9);
  }

  .callout-content code {
    background-color: var(--docs-surface-bg);
    border: 1px solid var(--docs-surface-border);
    color: var(--color-primary);
    padding: 0.125rem 0.375rem;
    border-radius: var(--docs-radius-sm);
    font-size: 0.875em;
  }
</style>

<script>
  function setupCalloutDismiss() {
    const dismissButtons = document.querySelectorAll('.callout-dismiss');

    dismissButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const callout = button.closest('.callout') as HTMLElement;
        if (callout) {
          callout.style.animation = 'callout-fade-out var(--motion-duration-normal, 250ms) var(--motion-ease-out, cubic-bezier(0.33, 1, 0.68, 1)) forwards';
          setTimeout(() => {
            callout.remove();
          }, 250);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupCalloutDismiss);
  setupCalloutDismiss();
</script>

<style is:global>
  @keyframes callout-fade-out {
    from {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
    to {
      opacity: 0;
      transform: translateY(-8px);
      filter: blur(4px);
    }
  }
</style>
