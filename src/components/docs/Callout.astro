---
import { Icon } from 'astro-icon/components';

interface Props {
  type?: 'info' | 'warning' | 'tip' | 'danger';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const variants = {
  info: { icon: 'tabler:info-circle', accent: 'border-l-primary/50', color: 'text-primary', title: 'Info' },
  tip: { icon: 'tabler:bulb', accent: 'border-l-primary/50', color: 'text-primary', title: 'Tip' },
  warning: {
    icon: 'tabler:alert-triangle',
    accent: 'border-l-yellow-500/50',
    color: 'text-yellow-500',
    title: 'Warning',
  },
  danger: { icon: 'tabler:alert-circle', accent: 'border-l-red-500/50', color: 'text-red-500', title: 'Important' },
} as const;

const variant = variants[type];
const displayTitle = title ?? variant.title;
---

<div
  class:list={[
    'callout not-prose my-6 rounded-r-[var(--docs-radius-lg)] border border-l-[3px] border-[var(--docs-surface-border)] bg-[var(--docs-surface-bg)] p-5',
    variant.accent,
  ]}
  data-component="callout"
  data-type={type}
>
  <div class="flex items-start gap-3">
    <Icon name={variant.icon} class:list={['mt-0.5 h-5 w-5 shrink-0', variant.color]} aria-hidden="true" />
    <div class="min-w-0 flex-1">
      <p class:list={['mb-2 text-sm font-semibold', variant.color]}>{displayTitle}</p>
      <div class="callout-content text-sm leading-relaxed text-white/90">
        <slot />
      </div>
    </div>
  </div>
</div>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .callout {
      animation: callout-fade-in var(--motion-duration-normal) var(--motion-ease-out);
    }
  }

  @keyframes callout-fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  .callout-content p {
    margin: 0 0 0.5rem;
    color: rgb(255 255 255 / 0.9);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .callout-content p:last-child {
    margin-bottom: 0;
  }

  .callout-content strong {
    color: white;
    font-weight: 600;
  }

  .callout-content a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    transition: opacity var(--motion-duration-fast) var(--motion-ease-out);
  }

  .callout-content a:hover {
    opacity: 0.8;
  }

  .callout-content ul,
  .callout-content ol {
    margin: 0.5rem 0;
    padding-left: 1.25rem;
    list-style: none;
  }

  .callout-content ol {
    list-style: decimal outside;
  }

  .callout-content li {
    margin-bottom: 0.25rem;
    color: rgb(255 255 255 / 0.9);
  }

  .callout-content ul li {
    position: relative;
  }

  .callout-content ul li::before {
    content: '';
    position: absolute;
    left: -1.25rem;
    top: 0.65em;
    width: 0.35em;
    height: 0.35em;
    background: var(--color-primary);
    border-radius: 2px;
  }

  .callout-content code {
    background-color: var(--docs-surface-bg);
    border: 1px solid var(--docs-surface-border);
    color: var(--color-primary);
    padding: 0.125rem 0.375rem;
    border-radius: var(--docs-radius-sm);
    font-size: 0.875em;
  }
</style>
