---
import type { DocsPageLink } from '@/utils/docs';
import { Icon } from 'astro-icon/components';

interface Props {
  prev?: DocsPageLink | null;
  next?: DocsPageLink | null;
}

const { prev, next } = Astro.props;

const cardClass =
  'page-nav-card docs-surface group relative flex items-center gap-4 overflow-hidden p-6 transition-[background-color,box-shadow,opacity,scale,transform] duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-black active:scale-[0.96]';
---

{(prev || next) && (
  <nav class="page-nav not-prose mt-14" aria-label="Pagination" data-component="page-nav" data-pagefind-ignore>
    <div class:list={['grid gap-4', prev && next ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-1']}>
      {prev && (
        <a href={prev.href} rel="prev" data-astro-prefetch="hover" class={cardClass}>
          <div class="page-nav-icon relative z-10 flex h-12 w-12 shrink-0 items-center justify-center">
            <Icon
              name="tabler:arrow-left"
              class="h-5 w-5 text-white/70 transition-colors duration-200 group-hover:text-primary"
              aria-hidden="true"
            />
          </div>
          <div class="relative z-10 min-w-0 flex-1">
            <div class="mb-1.5 text-xs font-medium tracking-wider text-white/70 transition-colors duration-200 group-hover:text-primary/80">
              Previous
            </div>
            <p class="mb-1 text-lg font-semibold text-white transition-colors duration-300 group-hover:text-primary">
              {prev.title}
            </p>
            {prev.description && (
              <p class="line-clamp-2 text-sm text-white/70 transition-colors duration-300 group-hover:text-white/80">
                {prev.description}
              </p>
            )}
          </div>
        </a>
      )}

      {next && (
        <a href={next.href} rel="next" data-astro-prefetch="hover" class:list={[cardClass, 'md:col-start-2']}>
          <div class="relative z-10 min-w-0 flex-1 text-end">
            <div class="mb-1.5 text-xs font-medium tracking-wider text-white/70 transition-colors duration-200 group-hover:text-primary/80">
              Next
            </div>
            <p class="mb-1 text-lg font-semibold text-white transition-colors duration-300 group-hover:text-primary">
              {next.title}
            </p>
            {next.description && (
              <p class="line-clamp-2 text-sm text-white/70 transition-colors duration-300 group-hover:text-white/80">
                {next.description}
              </p>
            )}
          </div>
          <div class="page-nav-icon relative z-10 flex h-12 w-12 shrink-0 items-center justify-center">
            <Icon
              name="tabler:arrow-right"
              class="h-5 w-5 text-white/70 transition-colors duration-200 group-hover:text-primary"
              aria-hidden="true"
            />
          </div>
        </a>
      )}
    </div>
  </nav>
)}

<style is:global>
  .page-nav {
    margin-top: 3rem;
    margin-bottom: 2rem;
  }

  .prose + .page-nav {
    margin-top: 4.5rem;
  }

  .page-nav-icon {
    border-radius: var(--docs-radius-md);
    background: rgb(255 255 255 / 0.018);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.04);
    transition:
      background-color var(--motion-duration-slow) var(--motion-ease-out),
      box-shadow var(--motion-duration-slow) var(--motion-ease-out);
  }

  .page-nav-card:hover .page-nav-icon {
    background: rgb(40 148 243 / 0.08);
    box-shadow: 0 0 0 1px rgb(40 148 243 / 0.2);
  }
</style>
