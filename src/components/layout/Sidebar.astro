---
import { DEFAULT_LOCALE } from '@/constants';
import {
  buildNavigationTree,
  isActivePage,
  normalizeSlug,
  prepareSidebarNavigation,
  shouldSkipItem,
  type NavItem,
  type SectionNavItem,
} from '@/utils/navigation';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import '@/styles/sidebar.css';

interface Props {
  currentSlug: string;
  locale?: string | null;
}

const { currentSlug, locale = null } = Astro.props;
const defaultLocale = DEFAULT_LOCALE;

const allDocs = await getCollection('docs');
const sectionNavItems = prepareSidebarNavigation(
  buildNavigationTree(allDocs, {
    scope: 'full',
    locale,
    defaultLocale,
  }) as SectionNavItem[],
  locale,
  defaultLocale,
);

const homeSection = sectionNavItems.find(section => normalizeSlug(section.sectionSlug, defaultLocale) === '/docs/');
const regularSections = sectionNavItems.filter(section => normalizeSlug(section.sectionSlug, defaultLocale) !== '/docs/');

function hasActiveDescendant(item: NavItem): boolean {
  if (!item.children || item.children.length === 0) {
    return false;
  }

  return item.children.some(child => isActivePage(currentSlug, child.slug));
}

---

{
  sectionNavItems.length > 0 && (
    <>
      <div
        id="sidebar-backdrop"
        class="pointer-events-none fixed inset-0 z-30 bg-black/50 opacity-0 backdrop-blur-sm transition-opacity duration-200 lg:hidden"
        aria-hidden="true"
      />

      <aside
        id="sidebar"
        data-pagefind-ignore
        class="fixed left-0 z-40 border-r border-white/[0.06] transition-transform duration-[250ms] lg:translate-x-0"
        style="top: var(--docs-header-height); width: min(var(--docs-sidebar-width), 86vw); height: calc(100vh - var(--docs-header-height)); background-color: oklch(0.1 0.04 265);"
      >
        <div class="flex h-full flex-col">
          <div class="flex items-center justify-between border-b border-white/[0.06] px-4 py-3 lg:hidden">
              <h2 class="text-sm font-semibold text-white">Documentation</h2>
              <button
                id="sidebar-close-button"
                type="button"
                aria-label="Close sidebar"
                class="inline-flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-md border border-white/[0.06] text-sm font-medium text-white transition-opacity duration-200 outline-none hover:opacity-80"
                style="background-color: var(--bg-primary);"
              >
                <Icon name="tabler:x" class="h-5 w-5" aria-hidden="true" />
              </button>
          </div>

          <div id="sidebar-scroll" class="flex-1 overflow-y-auto px-3 py-4">
            <nav class="space-y-5" aria-label="Documentation navigation">
              {
                homeSection && (
                  <a
                    href={homeSection.sectionSlug}
                    class={`sidebar-home-link flex items-center justify-between gap-2 rounded-md px-2 py-1.5 text-sm font-semibold transition-colors duration-200 outline-none ${
                      isActivePage(currentSlug, homeSection.sectionSlug)
                        ? 'bg-primary/10 text-primary'
                        : 'text-white/85 hover:bg-white/5 hover:text-white'
                    }`}
                  >
                    <span class="truncate">{homeSection.sectionTitle}</span>
                    {homeSection.badge && (
                      <span class="rounded-md border border-white/[0.08] px-1.5 py-0.5 text-[10px] font-medium tracking-wide text-white/60">
                        {homeSection.badge}
                      </span>
                    )}
                  </a>
                )
              }

              {regularSections.map(section => {
                const sectionIsActive = isActivePage(currentSlug, section.sectionSlug);

                return (
                  <section class="sidebar-section space-y-2">
                        <a
                          href={section.sectionSlug}
                          class={`sidebar-section-link flex items-center justify-between gap-2 rounded-md px-2 py-1.5 text-sm font-semibold transition-colors duration-200 ${
                            sectionIsActive
                              ? 'bg-primary/10 text-primary'
                              : 'text-white/85 hover:bg-white/5 hover:text-white'
                          }`}
                        >
                      <span class="truncate">{section.sectionTitle}</span>
                      {section.badge && (
                        <span class="rounded-md border border-white/[0.08] px-1.5 py-0.5 text-[10px] font-medium tracking-wide text-white/60">
                          {section.badge}
                        </span>
                      )}
                    </a>

                    {section.items.length > 0 && (
                      <ul class="space-y-0.5 border-l border-white/[0.06] pl-2">
                        {section.items.map(item => {
                          if (shouldSkipItem(item, section.sectionSlug)) {
                            return null;
                          }

                          const isActiveItem = isActivePage(currentSlug, item.slug);
                          const hasChildren = Boolean(item.children?.length);
                          const hasActiveChild = hasActiveDescendant(item);
                          const isInitiallyOpen = hasActiveChild || isActiveItem;

                          return (
                            <li
                              class={`sidebar-item ${hasChildren ? 'sidebar-item-with-children' : ''}`}
                              data-sidebar-group={hasChildren ? '' : undefined}
                              data-sidebar-key={hasChildren ? item.slug : undefined}
                              data-sidebar-active={hasChildren ? String(isInitiallyOpen) : undefined}
                            >
                              <div class="group flex items-center gap-1 rounded-md transition-colors duration-200 hover:bg-white/5">
                                <a
                                  href={item.slug}
                                  class={`sidebar-link flex-1 rounded-md px-2 py-1.5 text-sm transition-colors duration-200 outline-none ${
                                    isActiveItem
                                      ? 'bg-primary/10 text-primary font-medium'
                                      : 'text-white/70 hover:text-white'
                                  }`}
                                >
                                  <span class="flex items-center justify-between gap-2">
                                    <span class="truncate">{item.title}</span>
                                    {item.badge && (
                                      <span class="rounded-md border border-white/[0.06] px-1 py-0.5 text-[10px] tracking-wide text-white/60">
                                        {item.badge}
                                      </span>
                                    )}
                                  </span>
                                </a>

                                {hasChildren && (
                                  <button
                                    type="button"
                                    class="sidebar-toggle inline-flex size-7 shrink-0 cursor-pointer items-center justify-center rounded-md text-white/60 transition-colors duration-200 outline-none hover:bg-white/5 hover:text-white"
                                    aria-label={`Toggle ${item.title} items`}
                                    aria-expanded={isInitiallyOpen}
                                  >
                                    <Icon
                                      name="tabler:chevron-down"
                                      class="sidebar-arrow pointer-events-none h-4 w-4 transition-transform duration-200"
                                    />
                                  </button>
                                )}
                              </div>

                              {hasChildren && (
                                <ul class="sidebar-children mt-1 ml-2 space-y-0.5 border-l border-white/[0.06] pl-2.5">
                                  {item.children?.map(child => {
                                    const isChildActive = isActivePage(currentSlug, child.slug);

                                    return (
                                      <li>
                                        <a
                                          href={child.slug}
                                          class={`sidebar-link block rounded-md px-2 py-1.5 text-sm transition-colors duration-200 outline-none ${
                                            isChildActive
                                              ? 'bg-primary/10 text-primary font-medium'
                                              : 'text-white/60 hover:bg-white/5 hover:text-white'
                                          }`}
                                        >
                                          <span class="flex items-center justify-between gap-2">
                                            <span class="truncate">{child.title}</span>
                                            {child.badge && (
                                              <span class="rounded-md border border-white/[0.06] px-1 py-0.5 text-[10px] tracking-wide text-white/60">
                                                {child.badge}
                                              </span>
                                            )}
                                          </span>
                                        </a>
                                      </li>
                                    );
                                  })}
                                </ul>
                              )}
                            </li>
                          );
                        })}
                      </ul>
                    )}
                  </section>
                );
              })}
            </nav>
          </div>
        </div>
      </aside>
    </>
  )
}

<script>
  import { initSidebar } from '@/utils/ui';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSidebar);
  } else {
    initSidebar();
  }

  document.addEventListener('astro:page-load', initSidebar);
</script>
