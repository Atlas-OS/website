---
/**
 * The camp on the footer's knoll, asleep: it's the end of the page. The hero's two tents and
 * campfire (utils/hero-camp-geometry.ts), placed by utils/footer-horizon.ts, as the hero's camp
 * looks once its fire is put out: the tents dark with their doors shut, a few embers still glowing
 * in the logs, a thin wisp of smoke, and "zzZ" rising from each tent in turn.
 *
 * Rendered inside the footer's horizon SVG, so it is a group, not a box (and has no script of its own:
 * a module script inside an SVG never runs; Footer.astro pauses it). The embers, smoke and zzZ move
 * only while the footer is on screen and motion is allowed; otherwise they rest in place.
 */
import { CAMP } from '@/utils/footer-horizon';
import { glowStops } from '@/utils/glow';
import { FIRE, LOGS, SLEEP, SMOKE, STONES, TENTS } from '@/utils/hero-camp-geometry';

const tents = [
  { tent: TENTS.big, side: '#1C3361', front: '#33528F', lining: '#2B3352', seam: '#1A2D55' },
  { tent: TENTS.small, side: '#3B2F45', front: '#93664A', lining: '#3A3146', seam: '#523629' },
];
const stonesBehind = STONES.filter((stone) => stone.behind);
const stonesFront = STONES.filter((stone) => !stone.behind);
/** The embers' last warmth, small and low in the logs. */
const emberGlow = glowStops(0.32);
const embers: Array<[number, number, number]> = [
  [FIRE.x - 4, FIRE.y - 1.6, 0.9],
  [FIRE.x + 1.5, FIRE.y - 2.4, 1.1],
  [FIRE.x + 5, FIRE.y - 1.2, 0.8],
];
/** zzZ letters a little larger than the hero's, since the camp is drawn at three quarters. */
const LETTER_SCALE = 1.25;
---

<defs>
  <radialGradient id="footer-camp-embers" cx={FIRE.x} cy={FIRE.y - 1} r="16" gradientUnits="userSpaceOnUse">
    {emberGlow.map(({ offset, opacity }) => (
      <stop offset={offset} stop-color="#FF9A4A" stop-opacity={opacity} />
    ))}
  </radialGradient>
</defs>

<g class="footer-camp" data-footer-camp>
  <g transform={CAMP.transform}>
    {tents.map(({ tent, side, front, lining, seam }) => (
      <g>
        <path d={tent.groundsheet} fill="#08101E" />
        <path d={tent.guys} fill="none" stroke="#9FB4D8" stroke-opacity="0.38" stroke-width="0.5" />
        <path d={tent.pegs} fill="none" stroke="#C3CFE6" stroke-opacity="0.55" stroke-width="0.6" />
        <path d={tent.side} fill={side} />
        <path d={tent.front} fill={front} />
        <path d={tent.doorway} fill="#131D38" />
        <path d={tent.flap} fill={lining} />
        <path d={tent.front} fill="#0A1430" fill-opacity="0.45" />
        <path d={tent.seams} fill="none" stroke={seam} stroke-opacity="0.85" stroke-width="0.7" />
        <path d={tent.ridge} fill="none" stroke="#9DBDF2" stroke-opacity="0.45" stroke-width="0.6" />
      </g>
    ))}

    <ellipse cx={FIRE.x} cy={FIRE.y - 1} rx="16" ry="16" fill="url(#footer-camp-embers)"></ellipse>
    {stonesBehind.map((stone) => (
      <ellipse cx={stone.x} cy={stone.y} rx={stone.rx} ry={stone.ry} fill="#283149" />
    ))}
    {LOGS.map(({ from, to }) => (
      <path d={`M${from[0]} ${from[1]}L${to[0]} ${to[1]}`} stroke="#2E211C" stroke-width="3.6" stroke-linecap="round" />
    ))}
    {embers.map(([cx, cy, r], index) => (
      <circle class="footer-ember" style={`--i: ${index}`} cx={cx} cy={cy} r={r} fill="#FF8A3D" />
    ))}
    {stonesFront.map((stone) => (
      <ellipse cx={stone.x} cy={stone.y} rx={stone.rx} ry={stone.ry} fill="#222A40" />
    ))}

    <path
      class="footer-wisp"
      d={SMOKE}
      fill="none"
      stroke="#AEB9CF"
      stroke-opacity="0.3"
      stroke-width="1"
      stroke-linecap="round"
    ></path>

    {SLEEP.origins.map((origin, t) =>
      SLEEP.letters.map((letter, i) => (
        <text
          class="footer-z"
          x={origin.at[0]}
          y={origin.at[1]}
          font-size={letter.size * LETTER_SCALE}
          style={`--sx: ${letter.at[0] * LETTER_SCALE}px; --sy: ${letter.at[1] * LETTER_SCALE}px; --delay: ${i * SLEEP.stagger + t * SLEEP.tentOffset}s; --cycle: ${SLEEP.cycle}s`}
        >
          {letter.char}
        </text>
      ))
    )}
  </g>
</g>

<style>
  .footer-z {
    fill: oklch(0.921 0.038 259.3 / 0.75);
    font-weight: 600;
    transform-box: fill-box;
    transform-origin: 0 100%;
    /* At rest (and under reduced motion) each letter sits at its place in the rising line. */
    translate: var(--sx) var(--sy);
  }
  .footer-ember {
    opacity: 0.85;
  }
  .footer-wisp {
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Each letter rises from the ridge and fades, one after another, tent after tent. */
    .footer-z {
      opacity: 0;
      translate: none;
      animation: footer-z var(--cycle) ease-out var(--delay) infinite backwards;
    }
    .footer-ember {
      animation: footer-ember 3.2s ease-in-out calc(var(--i) * -1.1s) infinite;
    }
    .footer-wisp {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: footer-wisp 6.5s ease-out infinite;
    }
    .footer-camp[data-paused] :is(.footer-z, .footer-ember, .footer-wisp) {
      animation-play-state: paused;
    }
  }

  @keyframes footer-z {
    0% {
      opacity: 0;
      transform: translate(0, 0) scale(0.6);
    }
    20% {
      opacity: 1;
    }
    70% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      transform: translate(17px, -36px) scale(1.05);
    }
  }
  @keyframes footer-ember {
    0%,
    100% {
      opacity: 0.85;
    }
    50% {
      opacity: 0.35;
    }
  }
  @keyframes footer-wisp {
    0% {
      opacity: 0;
      transform: translateY(8%) scaleX(0.7);
    }
    35% {
      opacity: 0.7;
    }
    100% {
      opacity: 0;
      transform: translateY(-18%) scaleX(1.2);
    }
  }
</style>
