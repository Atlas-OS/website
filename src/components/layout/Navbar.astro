---
import AtlasLogomarkInk from '@/assets/atlas-logomark-ink.svg';
import AtlasLogomark from '@/assets/atlas-logomark.svg';
import NavLink from '@/components/ui/NavLink.astro';
import IconButton from '@/components/ui/IconButton.astro';
import SearchButton from '@/components/ui/SearchButton.astro';
import SocialIconLink from '@/components/ui/SocialIconLink.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import { Icon } from 'astro-icon/components';
import '@/styles/navbar.css';

interface Props {
  currentPath?: string;
  isDocsPage?: boolean;
}

const { currentPath = '/', isDocsPage } = Astro.props;

const isOnDocsPage = isDocsPage ?? currentPath.startsWith('/docs');

function isActive(href: string, currentPath: string): boolean {
  const normalizedHref = href.replace(/\/$/, '') || '/';
  const normalizedPath = currentPath.replace(/\/$/, '') || '/';

  if (normalizedHref === '/') {
    return normalizedPath === '/';
  }
  if (normalizedHref === '/docs/' || normalizedHref === '/docs') {
    return normalizedPath === '/docs/' || normalizedPath === '/docs';
  }
  return normalizedPath.startsWith(normalizedHref);
}

const mainNavItems = [
  { label: 'Documentation', href: '/docs/', isExternal: false },
  { label: 'Installation', href: '/docs/install/', isExternal: false },
  { label: 'FAQ', href: '/docs/faq/', isExternal: false },
  { label: 'Support us', href: 'https://ko-fi.com/atlasos', isExternal: true },
];

const docsSubNavItems = mainNavItems.filter((item) => item.href === '/docs/install/' || item.href === '/docs/faq/');
const hasActiveDocsSubItem = docsSubNavItems.some((item) => isActive(item.href, currentPath));
const isDocumentationActive = isOnDocsPage && !hasActiveDocsSubItem;
---

<header
  id="main-header"
  data-pagefind-ignore
  data-docs-page={String(isOnDocsPage)}
  class:list={['site-header inset-bs-0 z-50 w-full', isOnDocsPage && 'sticky']}
>
  <div class="mx-auto flex h-(--site-header-height) items-center justify-between px-(--space-page-edge)">
    <div class="flex min-w-0 flex-1 items-center gap-6">
      <a
        href="/"
        data-astro-prefetch="hover"
        aria-label="AtlasOS Home"
        class="group flex shrink-0 items-center transition-opacity hover:opacity-80"
      >
        <div class="relative">
          <img
            src={AtlasLogomark.src}
            alt="AtlasOS"
            width={100}
            height={32}
            class="site-logo site-logo--night relative z-10 block h-5 w-auto"
            loading="eager"
            decoding="sync"
          />
          <img
            src={AtlasLogomarkInk.src}
            alt="AtlasOS"
            width={100}
            height={32}
            class="site-logo site-logo--day relative z-10 h-5 w-auto"
            loading="eager"
            decoding="sync"
          />
        </div>
      </a>

      <nav class="hidden items-center gap-1 lg:flex">
        <NavLink href="/docs/" isActive={isDocumentationActive}>
          {' '}
          Documentation{' '}
        </NavLink>

        {mainNavItems.slice(1).map((item) => (
          <NavLink href={item.href} isActive={isActive(item.href, currentPath)} external={item.isExternal}>
            {item.label}
          </NavLink>
        ))}
      </nav>
    </div>

    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
      {isOnDocsPage && (
        <>
          <SearchButton />
          <SearchButton mobile={true} class="nav-icon--search" />
        </>
      )}

      <div class="nav-social-links hidden items-center gap-1 sm:flex">
        <SocialIconLink href="https://github.com/Atlas-OS/Atlas" icon="tabler:brand-github" label="GitHub" />
        <SocialIconLink href="https://discord.com/invite/atlasos-795710270000332800" icon="tabler:brand-discord" label="Discord" />
        <SocialIconLink href="https://x.com/atlasos" icon="tabler:brand-x" label="X (Twitter)" />
      </div>
      <span class="nav-divider hidden sm:block" aria-hidden="true"></span>
      <ThemeToggle />

      {isOnDocsPage ? (
        <IconButton
          id="sidebar-toggle-button"
          icon="tabler:menu-2"
          label="Toggle sidebar"
          controls="sidebar"
          expanded={false}
          class="lg:hidden"
        />
      ) : (
        <IconButton
          id="mobile-menu-button"
          icon="tabler:menu-2"
          label="Toggle mobile menu"
          controls="mobile-menu"
          expanded={false}
          class="relative md:hidden"
        />
      )}
    </div>
  </div>

  {!isOnDocsPage && (
    <div id="mobile-menu" class="mobile-menu md:hidden" hidden inert>
      <div id="mobile-menu-content" class="mobile-menu-content">
        <nav class="mobile-menu__links" aria-label="Main">
          {mainNavItems.map((item) => {
            const itemIsActive =
              item.href === '/docs/' ? isDocumentationActive : !item.isExternal && isActive(item.href, currentPath);

            return (
              <a
                href={item.href}
                data-astro-prefetch={!item.isExternal && item.href.startsWith('/') ? 'hover' : undefined}
                target={item.isExternal ? '_blank' : undefined}
                rel={item.isExternal ? 'noopener noreferrer' : undefined}
                aria-current={itemIsActive ? 'page' : undefined}
                class="mobile-menu__link"
              >
                <span>{item.label}</span>
                <Icon
                  name={item.isExternal ? 'tabler:arrow-up-right' : 'tabler:chevron-right'}
                  class="mobile-menu__chevron"
                  aria-hidden="true"
                />
              </a>
            );
          })}
        </nav>
        <div class="mobile-menu__footer">
          <span class="mobile-menu__note">Find us on</span>
          <div class="flex items-center gap-1">
            <SocialIconLink href="https://github.com/Atlas-OS/Atlas" icon="tabler:brand-github" label="GitHub" />
            <SocialIconLink href="https://discord.com/invite/atlasos-795710270000332800" icon="tabler:brand-discord" label="Discord" />
            <SocialIconLink href="https://x.com/atlasos" icon="tabler:brand-x" label="X (Twitter)" />
          </div>
        </div>
      </div>
    </div>
  )}
</header>

<script>
  import { initNavbar } from '@/utils/navbar';
  import { onPageLoad } from '@/utils/page-lifecycle';

  onPageLoad(initNavbar);
</script>
