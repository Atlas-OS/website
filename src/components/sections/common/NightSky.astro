---
/**
 * A faint scatter of stars that carries the hero's night into a section. Deterministic (seeded),
 * so every build renders the same sky. Stars keep out of a central lane where text usually sits
 * (`lane`, as a fraction of the width; 0 disables it) and fade out at the top and bottom, so the
 * field never shows an edge against the page or the section connectors.
 *
 * Place it inside a `position: relative` section; it sits behind the content and takes no clicks.
 * In a content grid (styles/summit.css) it spans the page up to the grid's breakout width.
 */
interface Props {
  seed: number;
  /** Stars per 1000 × 400 of field. */
  density?: number;
  /** Height of the field, as a CSS length. */
  height?: string;
  /** Central fraction of the width kept clear of stars. */
  lane?: number;
  /** Offset of the field from the top of its section, as a CSS length. */
  top?: string;
  class?: string;
}

const { seed, density = 14, height = '26rem', lane = 0.5, top = '-6rem', class: className } = Astro.props;

const WIDTH = 1280;
const HEIGHT = 420;

function mulberry32(start: number): () => number {
  let state = start >>> 0;
  return () => {
    state = (state + 0x6d2b79f5) >>> 0;
    let t = state;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const random = mulberry32(seed);
const count = Math.round((density * (WIDTH * HEIGHT)) / (1000 * 400));
const laneLeft = (WIDTH * (1 - lane)) / 2;
const laneRight = WIDTH - laneLeft;
const stars: Array<{ x: number; y: number; r: number; o: number }> = [];
for (let attempt = 0; stars.length < count && attempt < count * 8; attempt++) {
  const x = random() * WIDTH;
  const y = random() * HEIGHT;
  if (lane > 0 && x > laneLeft && x < laneRight) continue;
  const bright = random() > 0.9;
  stars.push({
    x: Math.round(x * 10) / 10,
    y: Math.round(y * 10) / 10,
    r: bright ? 1.1 : 0.8,
    o: Math.round((bright ? 0.75 : 0.35 + random() * 0.3) * 100) / 100,
  });
}
---

<svg
  class:list={['night-sky', className]}
  style={`--night-sky-height: ${height}; --night-sky-top: ${top}`}
  viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  {stars.map(({ x, y, r, o }) => (
    <circle cx={x} cy={y} r={r} fill="#DDEBFF" fill-opacity={o} />
  ))}
</svg>

<style>
  .night-sky {
    grid-column: full-width;
    position: absolute;
    inset-block-start: var(--night-sky-top);
    inset-inline: 0;
    z-index: -1;
    width: min(100%, var(--breakout, 100%));
    height: var(--night-sky-height);
    margin-inline: auto;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, transparent, black 25%, black 70%, transparent);
  }
</style>
