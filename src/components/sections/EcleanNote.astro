---
/**
 * A quiet aside after the campfire: a small note pinned up by the fire, telling you about eclean.
 * One moonlit slip with a pin through its top edge; it brightens a touch on hover and stays out of
 * the way otherwise. Moonlit, not warm: the fire's amber stays in Join community.
 */
import EcleanMark from '@/assets/eclean-mark.svg';
import { Image } from 'astro:assets';
---

<section class="eclean-note content-grid relative mbs-32 mbe-24 text-center">
  <a href="https://eclean.gg/atlasos/" target="_blank" rel="noopener noreferrer" class="note" data-animate>
    <span class="note-pin" aria-hidden="true"></span>
    <Image src={EcleanMark} alt="" width={16} height={16} class="note-mark" draggable={false} />
    <span>
      Did you know? We also build <span class="note-name">eclean</span>, everyday Windows maintenance
    </span>
  </a>
</section>

<style>
  /* The note: a small slip of the night's own surface, its top edge catching the moon. Centred, as wide as its words. */
  .note {
    position: relative;
    display: inline-flex;
    max-width: 100%;
    justify-self: center;
    align-items: center;
    gap: 0.625rem;
    padding-block: 0.7rem;
    padding-inline: 0.9rem 1.1rem;
    border: 1px solid var(--summit-rim-faint);
    border-radius: var(--summit-radius-sm);
    /* `in srgb` keeps the blend from the ranges' navy to the abyss as it was drawn. */
    background: linear-gradient(
      in srgb to bottom,
      oklch(0.331 0.089 263.7 / 0.3),
      color-mix(in oklch, var(--summit-abyss) 50%, transparent)
    );
    box-shadow:
      inset 0 1px 0 oklch(0.935 0.032 255.6 / 0.08),
      6px 14px 30px -12px color-mix(in oklch, var(--summit-shadow) 60%, transparent);
    color: var(--summit-text-faint);
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: start;
    transition:
      color 200ms var(--motion-ease-out),
      border-color 200ms var(--motion-ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .note:hover {
      border-color: var(--summit-rim);
      color: var(--summit-text-muted);
      opacity: 1;
    }
  }
  .note:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  /* The pin through the note's top edge: a moonlit head with its shadow falling down and right. */
  .note-pin {
    position: absolute;
    inset-block-start: -3px;
    inset-inline-start: 50%;
    width: 7px;
    aspect-ratio: 1;
    border-radius: 50%;
    translate: -50% 0;
    background: radial-gradient(circle at 35% 30% in srgb, white, var(--summit-moon) 40%, oklch(0.721 0.061 260.4));
    box-shadow: 1.5px 2px 2px color-mix(in oklch, var(--summit-shadow) 60%, transparent);
  }

  .note-mark {
    width: 1rem;
    height: 1rem;
    flex: none;
    border-radius: 3px;
    user-select: none;
  }

  .note-name {
    color: var(--summit-text);
    font-weight: 600;
  }
</style>
