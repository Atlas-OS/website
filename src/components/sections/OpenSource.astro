---
/**
 * Open source, "Stargazers": the project's GitHub stars as stars in the sky. A patch of night in
 * which the stars trace the Atlas mark as a constellation, with the live stargazer count set
 * beneath it like a star chart's caption. Geometry in utils/open-source-constellation.ts.
 *
 * As the chart scrolls into view its lines draw in, one pen tracing the mark from the summit and
 * back, and the summit star glints as the outline closes. The field twinkles slowly, paused off
 * screen. Without JavaScript or with reduced motion the chart renders complete and still.
 */
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import GPLLogo from '@/assets/gpl3-logo.svg';
import SectionHeading from '@/components/sections/common/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import { CHART, DRAW, FIELD, FIELD_GROUPS, FIELD_INSET, LINES, STARS, SUMMIT } from '@/utils/open-source-constellation';

const links = {
  github: 'https://github.com/Atlas-OS/Atlas',
  license: 'https://github.com/Atlas-OS/Atlas/blob/main/LICENSE',
  contributing: '/docs/contributing/',
};

const chartView = `0 0 ${CHART.width} ${CHART.height}`;
const fieldView = `${FIELD.x} ${FIELD.y} ${FIELD.width} ${FIELD.height}`;
const fieldStyle = `inset-inline-start: ${FIELD_INSET.left}%; inset-block-start: ${FIELD_INSET.top}%; width: ${FIELD_INSET.width}%; height: ${FIELD_INSET.height}%`;
/** The field's mask is centred on the constellation, not on the field. */
const fieldCentre = {
  x: Math.round(((CHART.width / 2 - FIELD.x) / FIELD.width) * 1000) / 10,
  y: Math.round(((CHART.height / 2 - FIELD.y) / FIELD.height) * 1000) / 10,
};
const fieldMask = `--field-x: ${fieldCentre.x}%; --field-y: ${fieldCentre.y}%`;
---

<section class="stargazers relative mx-auto my-32 max-w-7xl px-4" data-open-source>
  <div class="stargazers-intro">
    <SectionHeading near="An open-source, GPL-3.0 project" />
    <p class="summit-lede" data-animate>
      We are an open-source, community-driven project, licensed under GPL-3.0. We would greatly appreciate it if you
      check it out and, if interested, consider contributing to our vision.
    </p>
  </div>

  <div class="stargazers-sky" style={`--draw-total: ${DRAW.total}ms`} data-animate>
    <div class="sky-chart">
      <svg class="sky-field" style={`${fieldStyle}; ${fieldMask}`} viewBox={fieldView} aria-hidden="true">
        {FIELD_GROUPS.map((group, index) => (
          <g class:list={['sky-twinkle', `sky-twinkle--${index}`]}>
            <path d={group.warm} fill="#EEF5FF" />
            <path d={group.cool} fill="#A9CBFF" />
          </g>
        ))}
      </svg>

      <svg class="sky-constellation" viewBox={chartView} aria-hidden="true">
        <defs>
          <radialGradient id="sky-summit-halo" cx={SUMMIT.x} cy={SUMMIT.y} r="26" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#CFE2FF" stop-opacity="0.55"></stop>
            <stop offset="0.4" stop-color="#7FAEF5" stop-opacity="0.16"></stop>
            <stop offset="1" stop-color="#3A6FD0" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        {LINES.map((line, index) => (
          <path
            class="sky-line"
            d={line.d}
            pathLength="1"
            style={`--draw-delay: ${DRAW.lines[index]?.delay ?? 0}ms; --draw-duration: ${DRAW.lines[index]?.duration ?? 0}ms`}
          />
        ))}
        <circle class="sky-halo" cx={SUMMIT.x} cy={SUMMIT.y} r="26" fill="url(#sky-summit-halo)"></circle>
        {STARS.map(({ x, y, r }) => (
          <circle cx={x} cy={y} r={r} fill="#EEF5FF" />
        ))}
        <path class="sky-glint" d={SUMMIT.glint} fill="#F4F8FF"></path>
      </svg>
    </div>

    <p class="sky-count">
      <span id="star-amount-tag" class="sky-count__number" data-pending>
        --
      </span>
      <span class="sky-count__label">stargazers on GitHub</span>
    </p>
  </div>

  <div class="stargazers-actions" data-animate>
    <div class="stargazers-links">
      <Button href={links.contributing} variant="secondary" size="lg" icon="tabler:git-pull-request">
        Read the contribution guide
      </Button>
      <a href={links.github} target="_blank" rel="noopener noreferrer" class="summit-link stargazers-repo">
        <Icon name="tabler:brand-github" class="h-4 w-4" aria-hidden="true" />
        View the repository on GitHub
      </a>
    </div>
    <a href={links.license} target="_blank" rel="noopener noreferrer" class="stargazers-license">
      <Image
        src={GPLLogo}
        alt="Read the GPL-3.0 license"
        class="h-10 w-auto select-none"
        loading="lazy"
        draggable={false}
      />
    </a>
  </div>
</section>

<style>
  .stargazers {
    display: grid;
    grid-template-areas: 'intro' 'sky' 'actions';
    gap: 3rem;
  }
  .stargazers-intro {
    grid-area: intro;
    display: grid;
    gap: 1.5rem;
  }
  .stargazers-sky {
    grid-area: sky;
  }
  .stargazers-actions {
    grid-area: actions;
  }

  /* The sky takes the wide column on the left, under the moon; the copy reads beside it. */
  @media (min-width: 1024px) {
    .stargazers {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas: 'sky intro' 'sky actions';
      grid-template-rows: auto 1fr;
      column-gap: 4.5rem;
      row-gap: 2.5rem;
      align-items: center;
    }
    .stargazers-intro {
      align-self: end;
    }
    .stargazers-actions {
      align-self: start;
    }
  }

  /* ---- The chart ------------------------------------------------------------------------------ */

  .stargazers-sky {
    position: relative;
    width: min(100%, 36rem);
    justify-self: center;
  }
  .sky-chart {
    position: relative;
    aspect-ratio: 560 / 380;
  }
  /* A soft patch of deeper night behind the constellation: a glow, never a box. */
  .sky-chart::before {
    --patch: oklch(0.383 0.108 262.5);
    content: '';
    position: absolute;
    inset-block: -20% -34%;
    inset-inline: -22%;
    z-index: -1;
    background: radial-gradient(
      ellipse 50% 50% at 50% 46%,
      color-mix(in oklch, var(--patch) 24%, transparent),
      color-mix(in oklch, var(--patch) 13%, transparent) 30%,
      color-mix(in oklch, var(--patch) 5%, transparent) 58%,
      color-mix(in oklch, var(--patch) 1.5%, transparent) 80%,
      transparent
    );
    pointer-events: none;
  }
  .sky-field,
  .sky-constellation {
    position: absolute;
    overflow: visible;
    pointer-events: none;
  }
  .sky-field {
    z-index: -1;
    mask-image: radial-gradient(
      ellipse 50% 50% at var(--field-x) var(--field-y),
      black 30%,
      color-mix(in oklch, black 45%, transparent) 62%,
      transparent 100%
    );
  }
  .sky-constellation {
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .sky-twinkle--1 {
    opacity: 0.8;
  }
  .sky-twinkle--2 {
    opacity: 0.6;
  }

  .sky-line {
    fill: none;
    stroke: var(--summit-moonlight);
    stroke-opacity: 0.36;
    stroke-width: 1;
    stroke-linecap: round;
  }
  .sky-glint,
  .sky-halo {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* The count is the chart's caption: the size of the sky, in moonlight. */
  .sky-count {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    margin-block-start: -0.5rem;
    text-align: center;
  }
  .sky-count__number {
    padding-block-end: 0.06em;
    font-family: var(--font-display);
    font-size: clamp(3rem, 2.2rem + 3vw, 4.5rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.03em;
    background: linear-gradient(in srgb to bottom, var(--summit-lit) 35%, var(--summit-lit-end));
    background-clip: text;
    color: transparent;
  }
  /* Until the count arrives (and if it can't), its `--` reads as faint, unlit dashes. */
  .sky-count__number[data-pending] {
    background: none;
    color: color-mix(in oklch, var(--summit-moonlight) 40%, transparent);
    letter-spacing: 0.12em;
  }
  .sky-count__label {
    color: var(--summit-text-muted);
    font-size: 1rem;
  }

  /* ---- Actions -------------------------------------------------------------------------------- */

  .stargazers-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  .stargazers-repo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
  }
  .stargazers-license {
    display: inline-flex;
    margin-block-start: 2.25rem;
    border-radius: 0.375rem;
    opacity: 0.72;
    transition: opacity 160ms var(--motion-ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .stargazers-license:hover {
      opacity: 1;
    }
  }
  .stargazers-repo:focus-visible,
  .stargazers-license:focus-visible {
    outline: 2px solid var(--summit-moon);
    outline-offset: 4px;
  }

  /* ---- Motion --------------------------------------------------------------------------------- */

  @media (prefers-reduced-motion: no-preference) {
    /*
     * The draw-in: hidden only once JavaScript has committed to revealing the chart, then traced
     * when the scroll reveal marks it in view. The summit glints as the outline closes on it.
     */
    :global(html[data-motion]) .sky-line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      transition: stroke-dashoffset var(--draw-duration) linear calc(var(--draw-delay) + 420ms);
    }
    :global(html[data-motion]) .sky-glint {
      opacity: 0;
      scale: 0.4;
      transition:
        opacity 700ms var(--motion-ease-out) calc(var(--draw-total) + 380ms),
        scale 900ms cubic-bezier(0.22, 1, 0.36, 1) calc(var(--draw-total) + 380ms);
    }
    :global(html[data-motion]) .stargazers-sky.animate-in .sky-line {
      stroke-dashoffset: 0;
    }
    :global(html[data-motion]) .stargazers-sky.animate-in .sky-glint {
      opacity: 1;
      scale: 1;
    }

    /* Slow ambient loops: the field twinkles out of step and the summit breathes. */
    .sky-twinkle--1 {
      animation: sky-twinkle 6.8s ease-in-out -2.6s infinite alternate;
    }
    .sky-twinkle--2 {
      animation: sky-twinkle 9.6s ease-in-out -5.4s infinite alternate;
    }
    .sky-halo {
      animation: sky-breathe 7s ease-in-out infinite alternate;
    }
    .stargazers[data-paused] :is(.sky-twinkle, .sky-halo) {
      animation-play-state: paused;
    }
  }

  @keyframes sky-twinkle {
    to {
      opacity: 0.28;
    }
  }

  @keyframes sky-breathe {
    from {
      opacity: 0.7;
      transform: scale(0.88);
    }
    to {
      opacity: 1;
      transform: scale(1.06);
    }
  }
</style>

<script>
  import { ATLAS_API_URL } from '@/constants';
  import { pauseWhenOffscreen } from '@/utils/in-view';
  import { isLocalhost, onPageLoad } from '@/utils/page-lifecycle';

  type StarsCountResponse = { count?: unknown };

  /** The live stargazer count. It stays `--` on localhost and whenever the API can't be reached. */
  async function updateStarCount(signal: AbortSignal): Promise<void> {
    const element = document.getElementById('star-amount-tag');
    if (!element || isLocalhost()) return;

    try {
      const response = await fetch(`${ATLAS_API_URL}stars`, { signal });
      if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
      const data = (await response.json()) as StarsCountResponse | null;
      if (typeof data?.count !== 'number') throw new Error('Invalid star count data received');
      element.textContent = data.count.toLocaleString();
      element.removeAttribute('data-pending');
    } catch {
      if (signal.aborted) return;
      element.textContent = '--';
      element.setAttribute('data-pending', '');
    }
  }

  onPageLoad((signal) => {
    void updateStarCount(signal);
    pauseWhenOffscreen('[data-open-source]', signal);
  });
</script>
