---
import { Icon } from 'astro-icon/components';
import { Picture, Image } from 'astro:assets';
import GitHub from '@/assets/github-overview.webp';
import GitHubStar from '@/assets/github-star.svg';
import GPLLogo from '@/assets/gpl3-logo.svg';

const links = {
  github: 'https://github.com/Atlas-OS/Atlas',
};
---

<section
  class="relative z-10 mx-auto mt-32 mb-32 flex max-w-7xl flex-col items-end px-4 lg:flex-row lg:justify-between"
>
  <div class="github-wrapper relative hidden h-[330px] w-[587px] lg:block" data-animate>
    <Picture
      src={GitHub}
      alt="GitHub repository"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      layout="constrained"
      width={587}
      height={330}
      widths={[587, 1174]}
      sizes="587px"
      quality={72}
      class="media-outline h-auto w-full rounded-md shadow-[0_24px_70px_rgba(0,0,0,0.3)] select-none"
      loading="lazy"
      draggable={false}
    />
    <div
      id="gh-stars-wrap"
      class="absolute right-[-60px] bottom-[-7px] w-[300px] cursor-pointer rounded-md bg-secondary/80 text-gray-400 shadow-[var(--shadow-surface)] backdrop-blur-md transition-[border-radius,box-shadow] duration-200"
    >
      <button
        id="toggle-star-list-btn"
        aria-controls="gh-star-list"
        aria-expanded="false"
        class="w-full border-none bg-transparent p-0 text-left transition-opacity duration-200 outline-none hover:opacity-80 focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:outline-none"
        type="button"
      >
        <div class="flex w-full cursor-pointer justify-between">
          <div class="flex items-center px-4 py-2">
            <div class="mr-4 h-[19px] w-[19px]">
              <Image
                src={GitHubStar}
                alt="GitHub star"
                class="h-full w-full select-none"
                loading="lazy"
                draggable={false}
              />
            </div>
            <p class="text-white">Starred</p>
            <span
              id="star-amount-badge"
              class="ml-8 min-w-[50px] rounded-full bg-secondary/80 px-3 py-2 text-center text-sm tabular-nums">--</span
            >
          </div>
          <div class="flex items-center">
            <div class="ml-2 h-full w-px bg-white/10"></div>
            <div class="flex h-full items-center justify-center px-4 py-2">
              <Icon name="tabler:chevron-down" class="h-5 w-5 transition-transform duration-200" />
            </div>
          </div>
        </div>
      </button>
      <div
        id="gh-star-list"
        class="gh-star-dropdown absolute top-full left-0 z-[999] -ml-[1px] w-[calc(100%+2px)] rounded-b-md border border-t-0 border-white/[0.06]"
      >
        <div class="gh-star-dropdown-inner min-h-0 overflow-hidden">
          <div id="gh-star-list-items" class="flex flex-col gap-4 bg-secondary/80 px-5 py-5 backdrop-blur-md"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-lg text-right" data-animate data-animate-delay="2">
    <h2 class="mb-6 ml-auto max-w-md text-4xl font-semibold tracking-tight text-white md:text-5xl">
      An open-source, <span class="text-primary">GPL-3.0</span> project
    </h2>
    <p class="max-w-lg leading-relaxed text-white/80">
      We are an open-source, community-driven project, licensed under GPL-3.0. We would greatly appreciate it if you
      check it out and, if interested, consider contributing to our vision.
    </p>
    <div class="mt-10 flex items-center justify-end gap-8">
      <div class="flex items-center gap-2">
        <div class="h-[19px] w-[19px]">
          <Image
            src={GitHubStar}
            alt="GitHub star"
            class="h-full w-full select-none"
            loading="lazy"
            draggable={false}
          />
        </div>
        <p class="text-white">
          <span id="star-amount-tag" class="mr-1 font-semibold text-yellow-400 tabular-nums">--</span><span
            class="text-white/70"
          >
            stargazers on
            <a
              href={links.github}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-primary hover:underline">GitHub</a
            >
          </span>
        </p>
      </div>
      <Image src={GPLLogo} alt="GPL logo" class="h-10 w-auto select-none" loading="lazy" draggable={false} />
    </div>
  </div>
</section>

<script>
  import { ATLAS_API_URL } from '@/constants';

  type StarsCountResponse = { count: number };
  type RecentStar = { username: string; avatar: string };

  class GitHubStarsManager {
    private starListItems: HTMLElement | null;
    private starCountEl: HTMLElement | null;
    private starBadgeEl: HTMLElement | null;

    constructor() {
      this.starListItems = document.getElementById('gh-star-list-items');
      this.starCountEl = document.getElementById('star-amount-tag');
      this.starBadgeEl = document.getElementById('star-amount-badge');

      this.initDropdown();
      this.updateStarInfo();
    }

    private initDropdown(): void {
      const toggleBtn = document.getElementById('toggle-star-list-btn');
      const starList = document.getElementById('gh-star-list');
      const wrapper = document.getElementById('gh-stars-wrap');
      if (!toggleBtn || !starList || !wrapper) return;

      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = starList.classList.toggle('show');
        wrapper.classList.toggle('toggled', isOpen);
        toggleBtn.classList.toggle('toggled', isOpen);
        const icon = toggleBtn.querySelector('svg');
        if (icon) icon.classList.toggle('rotate-180', isOpen);
        toggleBtn.setAttribute('aria-expanded', isOpen.toString());
      });

      document.addEventListener('click', (event: MouseEvent) => {
        const target = event.target as Node;
        if (!wrapper.contains(target)) {
          starList.classList.remove('show');
          wrapper.classList.remove('toggled');
          toggleBtn.classList.remove('toggled');
          const icon = toggleBtn.querySelector('svg');
          if (icon) icon.classList.remove('rotate-180');
          toggleBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    private async fetchData<T>(url: string): Promise<T> {
      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
      return res.json() as Promise<T>;
    }

    private createStarElement(star: { username: string; avatar: string }): HTMLElement {
      const el = document.createElement('div');
      el.className = 'flex items-center gap-2';
      const img = document.createElement('img');
      img.src = star.avatar;
      img.alt = `${star.username} avatar`;
      img.loading = 'lazy';
      img.className = 'media-outline w-10 h-10 rounded-full object-cover';
      const p = document.createElement('p');
      p.textContent = star.username;
      p.className = 'text-white';
      el.append(img, p);
      return el;
    }

    private async updateStarInfo(): Promise<void> {
      try {
        const starsResponse = (await this.fetchData(`${ATLAS_API_URL}stars`)) as StarsCountResponse;
        if (!starsResponse || typeof starsResponse.count !== 'number') {
          throw new Error('Invalid star count data received');
        }
        const count = starsResponse.count;

        if (this.starCountEl) {
          this.starCountEl.textContent = count.toLocaleString();
        }
        if (this.starBadgeEl) {
          this.starBadgeEl.textContent = `${(count / 1000).toFixed(1)}k`;
        }

        const recentStars = (await this.fetchData(`${ATLAS_API_URL}recent-stars`)) as RecentStar[];
        if (!Array.isArray(recentStars)) {
          throw new Error('Invalid recent stars data received');
        }

        const items = recentStars.slice(0, 4).map((stargazer) => this.createStarElement(stargazer));

        if (this.starListItems) {
          this.starListItems.replaceChildren(...items);
        }
      } catch {
        if (this.starCountEl) this.starCountEl.textContent = '--';
        if (this.starBadgeEl) this.starBadgeEl.textContent = '--';
        if (this.starListItems) {
          const message = document.createElement('p');
          message.className = 'text-center text-white/70';
          message.textContent = 'Could not load stargazers.';
          this.starListItems.replaceChildren(message);
        }
      }
    }
  }

  function init(): void {
    new GitHubStarsManager();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  .gh-star-dropdown {
    display: grid;
    grid-template-rows: 0fr;
    transform-origin: top center;
    transition: grid-template-rows var(--motion-duration-normal, 250ms)
      var(--motion-ease-out, cubic-bezier(0.33, 1, 0.68, 1));
  }

  .gh-star-dropdown-inner {
    opacity: 0;
    transform: translateY(-6px);
    filter: blur(2px);
    transition:
      opacity var(--motion-duration-normal, 250ms) var(--motion-ease-out, cubic-bezier(0.33, 1, 0.68, 1)),
      transform var(--motion-duration-normal, 250ms) var(--motion-ease-out, cubic-bezier(0.33, 1, 0.68, 1)),
      filter var(--motion-duration-normal, 250ms) var(--motion-ease-out, cubic-bezier(0.33, 1, 0.68, 1));
  }

  .gh-star-dropdown.show {
    grid-template-rows: 1fr;
  }

  .gh-star-dropdown.show .gh-star-dropdown-inner {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  #gh-stars-wrap.toggled {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    box-shadow: var(--shadow-surface-hover);
    transition: border-radius var(--motion-duration-normal, 250ms)
      var(--motion-ease-out, cubic-bezier(0.33, 1, 0.68, 1));
  }
</style>
