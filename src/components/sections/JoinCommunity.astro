---
import SectionTitle from '@/components/sections/common/SectionTitle.astro';
import Button from '@/components/ui/Button.astro';
---

<section class="relative mx-auto mt-32 mb-32 max-w-7xl px-4 text-center">
  <div data-animate>
    <SectionTitle>Join our community</SectionTitle>
  </div>
  <h2 class="mb-6 text-4xl font-semibold tracking-tight text-white md:text-5xl" data-animate>
    Be part of the <span class="text-primary">Atlas</span> community
  </h2>
  <p class="mx-auto mb-12 max-w-2xl text-white/70" data-animate>
    Join our thriving community of over 50,000 members and millions of AtlasOS users. <br /> Connect, share, and stay
    updated.
  </p>
  <div class="flex flex-col items-center justify-center gap-5 sm:flex-row" data-animate>
    <Button href="https://discord.com/invite/atlasos" variant="primary" size="lg" icon="tabler:brand-discord" external>
      Join Discord
    </Button>
    <Button href="https://x.com/atlasos" variant="secondary" size="lg" icon="tabler:brand-x" external>
      Follow us
    </Button>
  </div>
  <div class="community-glow pointer-events-none absolute -inset-y-16 inset-x-0 -z-10" aria-hidden="true"></div>
</section>

<style>
  .community-glow {
    /* Keep the entire fade inside the layer so none of its edges clip the glow. */
    background: radial-gradient(ellipse 48% 48% at 50% 50%, var(--home-ambient-glow), transparent 100%);
  }
</style>
