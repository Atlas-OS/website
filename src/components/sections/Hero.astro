---
import { Icon } from 'astro-icon/components';
import { Picture, Image } from 'astro:assets';
import AtlasWallpaper from '@/assets/atlas-wallpaper.webp';
import AtlasManagerHome from '@/assets/atlas-manager-home.png';
import ItsFOSSLogomark from '@/assets/itsfoss-logomark.svg';
import PcGuideLogomark from '@/assets/pcguide-logomark.svg';
import TechSpotLogomark from '@/assets/techspot-logomark.svg';
import WePCLogomark from '@/assets/wepc-logomark.svg';
import Button from '@/components/ui/Button.astro';
import DownloadModal from '@/components/ui/DownloadModal.astro';
import { ATLAS_RELEASE_LABEL } from '@/constants';

const links = {
  faq: '/docs/faq/general/',
  install: '/docs/install/',
};
---

<section class="relative overflow-visible px-4 pt-14 md:pt-22" data-home-hero>
  <div class="hero-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="hero-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="stars pointer-events-none absolute inset-0 z-[-5] translate-y-[-30%] overflow-hidden">
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
  </div>

  <div class="relative mx-auto max-w-7xl overflow-visible">
    <div class="mx-auto max-w-4xl pb-12 text-center">
      <div
        class="isolation-isolate relative z-0 mb-4 inline-flex w-max items-center justify-center overflow-hidden rounded-full px-4 py-1.5 text-sm leading-5 font-medium shadow-inner shadow-primary/20 backdrop-blur-[6px]"
        data-animate
      >
        <Icon name="tabler:users" class="mr-2 h-4 w-4 text-primary" />
        <span class="text-sm text-white">
          Over{' '}
          <span id="hero-download-count" class="font-semibold text-primary tabular-nums">
            Loading...
          </span>{' '}
          people using AtlasOS
        </span>
      </div>
      <h1
        data-animate
        class="mb-6 bg-linear-to-b from-white to-blue-200 bg-clip-text text-4xl font-semibold tracking-tight text-transparent md:text-7xl"
      >
        Optimized Windows. <br /> Designed for enthusiasts.
      </h1>
      <p data-animate class="mx-auto mb-10 max-w-2xl leading-relaxed text-white/70">
        AtlasOS is creating a "kinder" Windows experience. Reducing bloatware and optimizing performance for
        enthusiasts, gamers, and privacy-conscious individuals.
      </p>
      <p class="mb-4 text-sm text-white/70" data-animate>
        The latest version is{' '}
        <span id="atlas-release-label" class="font-semibold text-white">
          {ATLAS_RELEASE_LABEL}
        </span>
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4" data-animate>
        <Button
          variant="primary"
          size="lg"
          icon="tabler:chevron-right"
          iconPosition="after"
          id="get-started-btn"
          data-download-modal-open
        >
          Get started
        </Button>
        <Button
          href="https://github.com/Atlas-OS/Atlas"
          variant="secondary"
          size="lg"
          icon="tabler:brand-github"
          external
        >
          Star on GitHub
        </Button>
      </div>
    </div>
  </div>

  <div class="manager-showcase relative mx-auto mb-16 max-w-7xl px-0 md:px-4">
    <div class="manager-intro" data-animate>
      <div>
        <p class="manager-eyebrow">Built for Atlas</p>
        <h2>Meet Atlas Manager.</h2>
      </div>
      <a href="/docs/install/playbook/" class="manager-guide">
        A guided install, from start to finish <Icon name="tabler:arrow-up-right" class="h-4 w-4 shrink-0" />
      </a>
    </div>
    <div class="manager-stage">
      <div
        class="wallpaper-container absolute inset-0 z-0 rounded-2xl"
        data-animate
        style="--motion-reveal-blur: 0px; --motion-reveal-distance: 16px; --motion-reveal-scale-start: 1;"
      >
        <div class="relative h-full overflow-hidden rounded-2xl">
          <Picture
            src={AtlasWallpaper}
            alt=""
            width={1920}
            height={1080}
            formats={['avif', 'webp']}
            layout="full-width"
            class="relative z-10 block h-full w-full object-cover select-none"
            draggable={false}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
      <a
        class="manager-preview"
        href="/docs/install/playbook/"
        aria-label="Explore installation with Atlas Manager"
        data-animate
      >
        <Image
          src={AtlasManagerHome}
          alt="Atlas Manager home showing Atlas 0.6, guided installation steps, and the option to create an Atlas ISO."
          width={902}
          height={681}
          widths={[450, 700, 902]}
          sizes="(max-width: 767px) 92vw, (max-width: 1100px) 76vw, 800px"
          format="webp"
          loading="eager"
          class="block h-auto w-full"
        />
      </a>
    </div>
  </div>

  <div
    class="mx-auto flex max-w-4xl flex-wrap items-center justify-center gap-x-8 gap-y-12 opacity-60 lg:gap-x-24"
    data-animate
  >
    <a
      href="https://www.techspot.com/news/97095-check-out-AtlasOS-redesigned-windows-10-version-gamers.html"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-10 items-center transition-[opacity,scale] duration-200 hover:opacity-80 active:scale-[0.96]"
    >
      <Image
        src={TechSpotLogomark}
        alt="TechSpot"
        width={158}
        height={48}
        layout="constrained"
        draggable={false}
        class="max-h-8 w-auto select-none"
        loading="eager"
        decoding="async"
      />
    </a>
    <a
      href="https://www.pcguide.com/software/AtlasOS/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-10 items-center transition-[opacity,scale] duration-200 hover:opacity-80 active:scale-[0.96]"
    >
      <Image
        src={PcGuideLogomark}
        alt="PC Guide"
        width={158}
        height={48}
        layout="constrained"
        draggable={false}
        class="max-h-8 w-auto select-none"
        loading="lazy"
        decoding="async"
      />
    </a>
    <a
      href="https://www.wepc.com/tips/is-atlas-os-worth-it/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-10 items-center transition-[opacity,scale] duration-200 hover:opacity-80 active:scale-[0.96]"
    >
      <Image
        src={WePCLogomark}
        alt="WePC"
        width={158}
        height={48}
        layout="constrained"
        draggable={false}
        class="max-h-8 w-auto select-none"
        loading="lazy"
        decoding="async"
      />
    </a>
    <a
      href="https://news.itsfoss.com/atlas-os/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-10 items-center transition-[opacity,scale] duration-200 hover:opacity-80 active:scale-[0.96]"
    >
      <Image
        src={ItsFOSSLogomark}
        alt="It's FOSS"
        width={158}
        height={48}
        layout="constrained"
        draggable={false}
        class="max-h-8 w-auto select-none"
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>
</section>

<DownloadModal links={links} />

<style>
  [data-home-hero] {
    --motion-reveal-duration: 700ms;
    --motion-reveal-step: 110ms;
    --motion-reveal-distance: 24px;
    --motion-reveal-blur: 6px;
    --motion-reveal-scale-start: 0.98;
  }

  .star {
    animation: star-fade 6s ease-in-out infinite;
  }

  .star:nth-child(1) {
    width: 2px;
    height: 2px;
    top: 5%;
    left: 20%;
    animation-delay: 0s;
  }
  .star:nth-child(2) {
    width: 3px;
    height: 3px;
    top: 15%;
    left: 70%;
    animation-delay: 1s;
  }
  .star:nth-child(3) {
    width: 1.5px;
    height: 1.5px;
    top: 30%;
    left: 40%;
    animation-delay: 2s;
  }
  .star:nth-child(4) {
    width: 2.5px;
    height: 2.5px;
    top: 60%;
    left: 10%;
    animation-delay: 3s;
  }
  .star:nth-child(5) {
    width: 1.8px;
    height: 1.8px;
    top: 75%;
    left: 85%;
    animation-delay: 4s;
  }
  .star:nth-child(6) {
    width: 2px;
    height: 2px;
    top: 50%;
    left: 55%;
    animation-delay: 5s;
  }
  .star:nth-child(7) {
    width: 1.2px;
    height: 1.2px;
    top: 25%;
    left: 90%;
    animation-delay: 2.5s;
  }
  .star:nth-child(8) {
    width: 2.2px;
    height: 2.2px;
    top: 80%;
    left: 30%;
    animation-delay: 1.5s;
  }
  .star:nth-child(9) {
    width: 1.7px;
    height: 1.7px;
    top: 40%;
    left: 60%;
    animation-delay: 3.5s;
  }
  .star:nth-child(10) {
    width: 2.8px;
    height: 2.8px;
    top: 85%;
    left: 50%;
    animation-delay: 0.5s;
  }
  .star:nth-child(11) {
    width: 1.5px;
    height: 1.5px;
    top: 10%;
    left: 5%;
    animation-delay: 0.2s;
  }
  .star:nth-child(12) {
    width: 2.5px;
    height: 2.5px;
    top: 20%;
    left: 80%;
    animation-delay: 1.8s;
  }
  .star:nth-child(13) {
    width: 1px;
    height: 1px;
    top: 35%;
    left: 25%;
    animation-delay: 2.7s;
  }
  .star:nth-child(14) {
    width: 3px;
    height: 3px;
    top: 65%;
    left: 15%;
    animation-delay: 3.3s;
  }
  .star:nth-child(15) {
    width: 2px;
    height: 2px;
    top: 70%;
    left: 75%;
    animation-delay: 4.1s;
  }
  .star:nth-child(16) {
    width: 1.8px;
    height: 1.8px;
    top: 55%;
    left: 45%;
    animation-delay: 5.5s;
  }
  .star:nth-child(17) {
    width: 1.4px;
    height: 1.4px;
    top: 22%;
    left: 95%;
    animation-delay: 2.1s;
  }
  .star:nth-child(18) {
    width: 2.6px;
    height: 2.6px;
    top: 82%;
    left: 35%;
    animation-delay: 1.1s;
  }
  .star:nth-child(19) {
    width: 1.9px;
    height: 1.9px;
    top: 45%;
    left: 65%;
    animation-delay: 3.9s;
  }
  .star:nth-child(20) {
    width: 2.3px;
    height: 2.3px;
    top: 88%;
    left: 52%;
    animation-delay: 0.8s;
  }

  @keyframes star-fade {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
  }

  .hero-glow {
    background: radial-gradient(ellipse 65% 45% at 50% 42%, var(--home-ambient-glow), transparent 100%);
  }

  .hero-grid {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.018) 1px, transparent 1px),
      linear-gradient(to right, rgb(255 255 255 / 0.018) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 55% 35% at 50% 25%, rgb(0 0 0 / 0.45), transparent 100%);
  }

  .wallpaper-container {
    /* A quiet backdrop: soften the sides and fade the lower edge into the page. */
    border: 1px solid rgb(255 255 255 / 0.07);
    mask-image: radial-gradient(ellipse 80% 95% at 50% 0%, black 35%, rgb(0 0 0 / 0.7) 62%, transparent 100%);
  }

  .manager-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.25rem 1.5rem;
  }
  .manager-eyebrow {
    margin-bottom: 0.375rem;
    color: var(--color-primary, #48a7ff);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .manager-intro h2 {
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .manager-guide {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgb(255 255 255 / 0.65);
    font-size: 0.875rem;
  }
  .manager-guide:hover {
    color: white;
  }
  .manager-stage {
    position: relative;
    padding: 3rem 2rem 1rem;
    isolation: isolate;
  }
  .manager-stage .wallpaper-container {
    opacity: 0.7;
  }
  .manager-preview {
    position: relative;
    z-index: 30;
    display: block;
    width: min(76%, 800px);
    margin: 0 auto;
    overflow: hidden;
    border-radius: 0.65rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    box-shadow:
      0 32px 80px rgb(0 0 0 / 0.5),
      0 0 60px rgb(48 126 210 / 0.1);
  }
  .manager-preview:focus-visible,
  .manager-guide:focus-visible {
    outline: 2px solid #48a7ff;
    outline-offset: 6px;
  }
  @media (max-width: 767px) {
    .manager-intro {
      align-items: start;
      flex-direction: column;
      padding: 0 0.25rem 1rem;
      gap: 0.75rem;
    }
    .manager-guide {
      font-size: 0.8125rem;
    }
    .manager-stage {
      padding: 1rem 0.375rem 0.5rem;
    }
    .manager-preview {
      width: 100%;
      border-radius: 0.375rem;
    }
  }
</style>

<script>
  import { ATLAS_API_URL, ATLAS_GITHUB_LATEST_RELEASE_API_URL } from '@/constants';
  import { isLocalhost, onPageLoad } from '@/utils/page-lifecycle';

  const FALLBACK_DOWNLOAD_COUNT = '2,000,000';

  async function updateReleaseLabel(signal: AbortSignal): Promise<void> {
    const element = document.getElementById('atlas-release-label');
    if (!element) return;

    try {
      const response = await fetch(ATLAS_GITHUB_LATEST_RELEASE_API_URL, { signal });
      if (!response.ok) return;
      const release = (await response.json()) as { tag_name?: string; name?: string };
      const version = release.name || release.tag_name;
      if (version) element.textContent = version.startsWith('Atlas') ? version : `Atlas v${version}`;
    } catch {
      // Keep the static fallback rendered from constants.
    }
  }

  async function updateDownloadCount(signal: AbortSignal): Promise<void> {
    const element = document.getElementById('hero-download-count');
    if (!element) return;

    if (isLocalhost()) {
      element.textContent = FALLBACK_DOWNLOAD_COUNT;
      return;
    }

    try {
      const response = await fetch(ATLAS_API_URL, { signal });
      if (!response.ok) throw new Error(`API request failed with status ${response.status}`);
      const data = (await response.json()) as Array<{ version: string; count: number }>;
      const count = data.find((item) => item.version === 'atlas')?.count;
      element.textContent = count == null ? 'N/A' : count.toLocaleString('en-US');
    } catch {
      if (!signal.aborted) element.textContent = FALLBACK_DOWNLOAD_COUNT;
    }
  }

  onPageLoad((signal) => {
    void updateReleaseLabel(signal);
    void updateDownloadCount(signal);
  });
</script>
