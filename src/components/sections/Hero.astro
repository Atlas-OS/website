  .wallpaper-container > .overflow-hidden::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 30%;
    background: linear-gradient(to top, var(--bg-primary), transparent);
    pointer-events: none;
    z-index: 30;
  }
</style>

<script>
  import { ATLAS_API_URL, ATLAS_GITHUB_LATEST_RELEASE_API_URL } from '@/constants';

  async function updateHeroReleaseLabel(): Promise<void> {
    const releaseElement = document.getElementById('atlas-release-label');
    if (!releaseElement) {
      return;
    }

    try {
      const response = await fetch(ATLAS_GITHUB_LATEST_RELEASE_API_URL);
      if (!response.ok) {
        throw new Error(`Release API request failed with status ${response.status}`);
      }
      const release = (await response.json()) as { tag_name?: string; name?: string };
      const version = release.name || release.tag_name;
      if (version) {
        releaseElement.textContent = version.startsWith('Atlas') ? version : `Atlas v${version}`;
      }
    } catch {
      // Keep the static fallback rendered from constants.
    }
  }

  async function updateHeroDownloadCount(): Promise<void> {
    const countElement = document.getElementById('hero-download-count');
    if (!countElement) {
      return;
    }

    if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
      countElement.textContent = '2,000,000';
      return;
    }

    try {
      const response = await fetch(ATLAS_API_URL);
      if (!response.ok) {
        throw new Error(`API request failed with status ${response.status}`);
      }
      const data = (await response.json()) as Array<{ version: string; count: number }>;
      const atlasDownload = data.find((item: { version: string; count: number }) => item.version === 'atlas');
      const count = atlasDownload?.count;

      if (count !== undefined && count !== null) {
        countElement.textContent = Number(count).toLocaleString();
      } else {
        countElement.textContent = 'N/A';
      }
    } catch {
      countElement.textContent = '2,000,000';
    }
  }

  function setupGetStartedButton(): void {
    const getStartedBtn = document.getElementById('get-started-btn');
    const downloadModal = document.getElementById('download-modal') as HTMLDialogElement;

    if (getStartedBtn && downloadModal && !getStartedBtn.hasAttribute('data-download-bound')) {
      getStartedBtn.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('showModal'));
      });
      getStartedBtn.setAttribute('data-download-bound', 'true');
    }
  }

  function createWallpaperRunnerPath(width: number, height: number, cornerRadius: number, inset: number): string {
    const left = inset;
    const top = inset;
    const right = Math.max(left + 1, width - inset);
    const bottom = Math.max(top + 1, height - inset);
    const safeCornerRadius = Math.max(2, Math.min(cornerRadius, (right - left) / 2, bottom - top - 2));

    return [
      `M ${left} ${bottom}`,
      `L ${left} ${top + safeCornerRadius}`,
      `Q ${left} ${top} ${left + safeCornerRadius} ${top}`,
      `L ${right - safeCornerRadius} ${top}`,
      `Q ${right} ${top} ${right} ${top + safeCornerRadius}`,
      `L ${right} ${bottom}`,
    ].join(' ');
  }

  function setupWallpaperAnimation(): void {
    const container = document.querySelector('[data-home-hero] .wallpaper-container') as
      | (HTMLElement & {
          __refreshWallpaperAnimation?: () => void;
          __wallpaperAnimationRaf?: number;
          __wallpaperAnimations?: Animation[];
          __wallpaperResizeObserver?: ResizeObserver;
        })
      | null;
    const animationLayer = container?.querySelector<HTMLElement>('.wallpaper-animation');
    const animationSvg = animationLayer?.querySelector<SVGSVGElement>('.wallpaper-animation-svg');
    const track = animationLayer?.querySelector<SVGPathElement>('.wallpaper-animation-track');
    const runners = animationLayer?.querySelectorAll<SVGPathElement>('.wallpaper-animation-line');

    if (!container || !animationLayer || !animationSvg || !runners || runners.length === 0) {
      return;
    }

    const runAnimation = () => {
      const width = Math.round(animationSvg.clientWidth);
      const height = Math.round(animationSvg.clientHeight);

      if (width <= 0 || height <= 0) {
        return;
      }

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const runnerLength = Math.round(Math.max(130, Math.min(width * 0.19, height * 0.72, 260)));
      const layerStyles = window.getComputedStyle(animationLayer);
      const sampleRunner = runners[0]!;
      const runnerStyles = window.getComputedStyle(sampleRunner);
      const strokeWidth = Math.max(1, parseFloat(runnerStyles.strokeWidth) || 1.5);
      const strokeInset = Math.max(0.5, strokeWidth / 2);
      const paddingLeft = parseFloat(layerStyles.paddingLeft) || 0;
      const paddingRight = parseFloat(layerStyles.paddingRight) || 0;
      const rawTopLeftRadius = parseFloat(layerStyles.borderTopLeftRadius) || 8;
      const rawTopRightRadius = parseFloat(layerStyles.borderTopRightRadius) || 8;
      const baseCornerRadius = Math.max(
        2,
        Math.min(rawTopLeftRadius, rawTopRightRadius) - Math.max(paddingLeft, paddingRight) - strokeInset
      );
      const enhancedCornerRadius = baseCornerRadius * 1.45;
      const pathData = createWallpaperRunnerPath(width, height, enhancedCornerRadius, strokeInset);

      animationSvg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      if (track) {
        track.setAttribute('d', pathData);
      }
      runners.forEach((runner) => {
        runner.setAttribute('d', pathData);
      });

      const pathLength = runners[0]?.getTotalLength() || 0;
      if (pathLength <= 0) {
        return;
      }

      const gapLength = Math.max(pathLength - runnerLength, 1);

      container.__wallpaperAnimations?.forEach((animation) => animation.cancel());
      container.__wallpaperAnimations = [];

      if (reducedMotion) {
        runners.forEach((runner, index) => {
          runner.style.strokeDasharray = `${runnerLength} ${gapLength}`;
          runner.style.strokeDashoffset = String(-(pathLength * (index / runners.length)));
        });
        return;
      }

      const animations: Animation[] = [];
      runners.forEach((runner, index) => {
        const startOffset = -(pathLength * (index / runners.length));
        runner.style.strokeDasharray = `${runnerLength} ${gapLength}`;
        runner.style.strokeDashoffset = `${startOffset}`;

        const animation = runner.animate(
          [{ strokeDashoffset: `${startOffset}` }, { strokeDashoffset: `${startOffset - pathLength}` }],
          {
            duration: 12000,
            easing: 'linear',
            iterations: Infinity,
            fill: 'both',
          }
        );
        animations.push(animation);
      });

      container.__wallpaperAnimations = animations;
    };

    const scheduleAnimation = () => {
      if (container.__wallpaperAnimationRaf) {
        cancelAnimationFrame(container.__wallpaperAnimationRaf);
      }

      container.__wallpaperAnimationRaf = requestAnimationFrame(() => {
        container.__wallpaperAnimationRaf = undefined;
        runAnimation();
      });
    };

    if (!container.__refreshWallpaperAnimation) {
      container.__refreshWallpaperAnimation = scheduleAnimation;
      container.__wallpaperResizeObserver = new ResizeObserver(scheduleAnimation);
      container.__wallpaperResizeObserver.observe(animationLayer);
    }

    container.__refreshWallpaperAnimation();
  }

  function initHero(): void {
    updateHeroReleaseLabel();
    updateHeroDownloadCount();
    setupGetStartedButton();
    setupWallpaperAnimation();
  }

  document.addEventListener('astro:page-load', initHero);
</script>
