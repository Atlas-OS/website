---
import { Icon } from 'astro-icon/components';
import { Picture, Image } from 'astro:assets';
import AtlasWallpaper from '@/assets/atlas-wallpaper.webp';
import ItsFOSSLogomark from '@/assets/itsfoss-logomark.svg';
import PcGuideLogomark from '@/assets/pcguide-logomark.svg';
import TechSpotLogomark from '@/assets/techspot-logomark.svg';
import WePCLogomark from '@/assets/wepc-logomark.svg';
import Button from '@/components/ui/Button.astro';
import DownloadModal from '@/components/ui/DownloadModal.astro';
import { ATLAS_RELEASE_LABEL } from '@/constants';

const links = {
  faq: '/docs/faq/general/',
  install: '/docs/install/',
};
---

<section class="relative overflow-visible px-4 pt-14 md:pt-22" data-home-hero>
  <div class="absolute inset-0 -z-10 w-full" style="height: 100%;">
    <div
      class="absolute h-full w-full bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(to_right,rgba(255,255,255,0.02)_1px,transparent_1px)] mask-[linear-gradient(to_bottom,rgba(0,0,0,0.7),transparent_70%)] bg-size-[24px_24px]"
    >
    </div>
  </div>

  <div class="stars pointer-events-none absolute inset-0 z-[-5] translate-y-[-30%] overflow-hidden">
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
    <span class="star absolute rounded-full bg-white/80 opacity-0"></span>
  </div>

  <div class="relative mx-auto max-w-7xl overflow-visible">
    <div class="mx-auto max-w-4xl pb-12 text-center">
      <div
        class="isolation-isolate relative z-0 mb-4 inline-flex w-max items-center justify-center overflow-hidden rounded-full px-4 py-1.5 text-sm leading-5 font-medium shadow-inner shadow-primary/20 backdrop-blur-[6px]"
        data-animate
        data-animate-delay="2"
      >
        <Icon name="tabler:users" class="mr-2 h-4 w-4 text-primary" />
        <span class="text-sm text-white"
          >Over <span id="hero-download-count" class="font-semibold text-primary tabular-nums">Loading...</span> people using
          AtlasOS</span
        >
      </div>
      <h1
        class="mb-6 bg-linear-to-b from-white to-blue-200 bg-clip-text text-4xl font-semibold tracking-tight text-transparent md:text-7xl"
      >
        Optimized Windows. <br /> Designed for enthusiasts.
      </h1>
      <p class="mx-auto mb-10 max-w-2xl leading-relaxed text-white/70">
        AtlasOS is creating a "kinder" Windows experience. Reducing bloatware and optimizing performance for
        enthusiasts, gamers, and privacy-conscious individuals.
      </p>
      <p class="mb-4 text-sm text-white/70" data-animate data-animate-delay="7">
        The latest version is <span id="atlas-release-label" class="font-semibold text-white"
          >{ATLAS_RELEASE_LABEL}</span
        >
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4" data-animate data-animate-delay="8">
        <Button variant="primary" size="lg" icon="tabler:chevron-right" iconPosition="after" id="get-started-btn">
          Get started
        </Button>
        <Button
          href="https://github.com/Atlas-OS/Atlas"
          variant="secondary"
          size="lg"
          icon="tabler:brand-github"
          external
        >
          Star on GitHub
        </Button>
      </div>
    </div>
  </div>

  <div class="relative mx-auto mb-16 max-w-7xl px-4">
    <div
      class="pointer-events-none absolute inset-x-0 -top-1/3 -z-10 -mx-40 hidden h-[500px] animate-pulse rounded-full bg-primary/10 blur-3xl md:block"
    >
    </div>

    <div class="wallpaper-container relative z-10 hidden rounded-t-lg md:block">
      <div class="relative overflow-hidden rounded-t-lg">
        <Picture
          src={AtlasWallpaper}
          alt="AtlasOS Wallpaper"
          width={1920}
          height={1080}
          formats={['avif', 'webp']}
          layout="full-width"
          class="media-outline relative z-10 block h-auto w-full rounded-t-lg shadow-[0_28px_90px_rgba(0,0,0,0.38)] select-none"
          draggable={false}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <div class="wallpaper-animation pointer-events-none absolute inset-0 z-20 overflow-hidden rounded-t-lg">
        <svg
          class="wallpaper-animation-svg"
          viewBox="0 0 1 1"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <linearGradient id="hero-wallpaper-runner-gradient" x1="0" y1="100%" x2="0" y2="0">
              <stop offset="0%" stop-color="rgba(72, 167, 255, 0)"></stop>
              <stop offset="25%" stop-color="rgba(20, 80, 200, 0.55)"></stop>
              <stop offset="68%" stop-color="rgba(150, 210, 255, 0.9)"></stop>
              <stop offset="100%" stop-color="rgb(72, 167, 255)"></stop>
            </linearGradient>
          </defs>
          <path class="wallpaper-animation-track"></path>
          <path class="wallpaper-animation-line"></path>
          <path class="wallpaper-animation-line"></path>
        </svg>
      </div>
    </div>
  </div>

  <div
    class="absolute top-40 left-0 -z-20 hidden h-96 w-96 rounded-full bg-primary/20 opacity-30 blur-[120px] md:block"
  >
  </div>
  <div
    class="absolute top-60 right-0 -z-20 hidden h-96 w-96 rounded-full bg-primary/10 opacity-30 blur-[120px] md:block"
  >
  </div>

  <div
    class="mx-auto flex max-w-4xl flex-wrap items-center justify-center gap-x-8 gap-y-12 opacity-60 lg:gap-x-24"
    data-animate
    data-animate-delay="10"
  >
    <a
      href="https://www.techspot.com/news/97095-check-out-AtlasOS-redesigned-windows-10-version-gamers.html"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-10 items-center transition-[opacity,scale] duration-200 hover:opacity-80 active:scale-[0.96]"
    >
      <Image
        src={TechSpotLogomark}
        alt="TechSpot"
        width={158}
        height={48}
        layout="constrained"
        draggable={false}
        class="max-h-8 w-auto select-none"
        loading="eager"
        decoding="async"
      />
    </a>
    <a
      href="https://www.pcguide.com/software/AtlasOS/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-10 items-center transition-[opacity,scale] duration-200 hover:opacity-80 active:scale-[0.96]"
    >
      <Image
        src={PcGuideLogomark}
        alt="PC Guide"
        width={158}
        height={48}
        layout="constrained"
        draggable={false}
        class="max-h-8 w-auto select-none"
        loading="lazy"
        decoding="async"
      />
    </a>
    <a
      href="https://www.wepc.com/tips/is-atlas-os-worth-it/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-10 items-center transition-[opacity,scale] duration-200 hover:opacity-80 active:scale-[0.96]"
    >
      <Image
        src={WePCLogomark}
        alt="WePC"
        width={158}
        height={48}
        layout="constrained"
        draggable={false}
        class="max-h-8 w-auto select-none"
        loading="lazy"
        decoding="async"
      />
    </a>
    <a
      href="https://news.itsfoss.com/atlas-os/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-10 items-center transition-[opacity,scale] duration-200 hover:opacity-80 active:scale-[0.96]"
    >
      <Image
        src={ItsFOSSLogomark}
        alt="It's FOSS"
        width={158}
        height={48}
        layout="constrained"
        draggable={false}
        class="max-h-8 w-auto select-none"
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>
</section>

<DownloadModal links={links} />

<style>
  [data-home-hero] {
    --motion-reveal-duration: 1000ms;
    --motion-reveal-step: 200ms;
    --motion-reveal-distance: 34px;
    --motion-reveal-blur: 8px;
    --motion-reveal-scale-start: 0.98;
  }

  .wallpaper-animation {
    padding: 2px 2px 0;
  }

  .wallpaper-animation-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .wallpaper-animation-track {
    fill: none;
    stroke: rgba(8, 15, 35, 0.55);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .wallpaper-animation-line {
    fill: none;
    stroke: url(#hero-wallpaper-runner-gradient);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    will-change: stroke-dashoffset;
  }

  .star {
    animation: star-fade 6s ease-in-out infinite;
  }

