---
import { Image } from 'astro:assets';
import managerDark from '@/assets/atlas-manager-home-dark.png';
import managerLight from '@/assets/atlas-manager-home-light.png';
import ItsFOSSLogomark from '@/assets/itsfoss-logomark.svg';
import PcGuideLogomark from '@/assets/pcguide-logomark.svg';
import TechSpotLogomark from '@/assets/techspot-logomark.svg';
import WePCLogomark from '@/assets/wepc-logomark.svg';
import HeroBackdrop from '@/components/sections/hero/HeroBackdrop.astro';
import SummitStage from '@/components/sections/hero/SummitStage.astro';
import Button from '@/components/ui/Button.astro';
import { ATLAS_MANAGER_DOWNLOAD_URL } from '@/constants';
import { latestReleaseLabel } from '@/utils/latest-release';

// Fetched when the site is built; the script below refreshes it in the browser.
const releaseLabel = await latestReleaseLabel();
---

<section class="relative overflow-visible" data-home-hero>
  <HeroBackdrop>
    <div class="hero-copy mx-auto max-w-4xl px-4 pbe-12 text-center" data-summit-avoid>
      <!-- The count as an open line, led by the Atlas flag that flies on the summit below. -->
      <p class="hero-stat" data-animate>
        <svg class="hero-stat__flag" viewBox="0 0 14 16" aria-hidden="true">
          <rect x="1" y="0.5" width="1.5" height="15" rx="0.75" class="hero-stat__pole"></rect>
          <path d="M2.5 1H13L10.6 4.4L13 7.8H2.5Z" fill="#2B9BFF"></path>
          <path d="M2.5 1H13L12.3 2H2.5Z" fill="#8CCBFF"></path>
        </svg>
        <span>
          Over{' '}
          <span id="hero-download-count" class="hero-stat__count">
            2,000,000
          </span>{' '}
          AtlasOS downloads
        </span>
      </p>
      <h1
        data-animate
        class="hero-title mbe-6 bg-linear-to-b from-fg to-blue-200 bg-clip-text font-semibold tracking-tight text-transparent"
      >
        Optimized Windows. <br /> Designed for enthusiasts.
      </h1>
      <p data-animate class="mx-auto mbe-10 max-w-2xl leading-relaxed text-pretty text-fg/70">
        AtlasOS is a free, open-source Windows 11 modification. It cuts background activity, telemetry and ads, and
        keeps your apps and games working.
      </p>
      <p id="atlas-release" class="mbe-4 text-sm text-fg/70" data-animate>
        {releaseLabel ? (
          <>
            The latest version is <span class="font-semibold text-fg">{releaseLabel}</span>
          </>
        ) : (
          'Download the latest version'
        )}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4" data-animate>
        <Button
          href={ATLAS_MANAGER_DOWNLOAD_URL}
          variant="primary"
          size="lg"
          icon="tabler:download"
          iconPosition="after"
          id="manager-download-btn"
        >
          Download Atlas Manager
        </Button>
        <Button
          href="https://github.com/Atlas-OS/Atlas"
          variant="secondary"
          size="lg"
          icon="tabler:brand-github"
          external
        >
          Star on GitHub
        </Button>
      </div>
      <p class="mbs-4 text-sm text-fg/60" data-animate>
        For a clean install, choose Create an Atlas ISO in Atlas Manager.{' '}
        <a href="/docs/install/" class="text-[var(--color-link)] underline-offset-2 hover:text-fg hover:underline">
          Read the installation guide
        </a>
      </p>
    </div>

    <div class="manager-showcase relative mx-auto max-w-7xl px-4 md:px-8">
      <div class="manager-stage">
        <div class="manager-window">
          <SummitStage />
          <!-- Atlas Manager is new: a pennant in the summit flag's cloth, hung over the window's top edge. -->
          <p class="manager-pennant">
            <span class="manager-pennant__cloth" aria-hidden="true">
              <svg viewBox="0 0 44 52">
                <path d="M0 2Q0 0 2 0H42Q44 0 44 2V52L22 43L0 52Z" fill="#2B9BFF"></path>
                <path d="M0 6H2V51.2L0 52Z" fill="#8CCBFF"></path>
                <path d="M0 2Q0 0 2 0H42Q44 0 44 2V6.4H0Z" fill="#1A6FD0"></path>
              </svg>
              <span class="manager-pennant__label">New</span>
            </span>
            <span class="sr-only">New: Atlas Manager, a guided install from start to finish.</span>
          </p>
          <a class="manager-preview" href="/docs/install/manager/" aria-label="Read the Atlas Manager guide">
            {[managerDark, managerLight].map((src) => (
              <Image
                src={src}
                widths={[450, 700, 966]}
                sizes="(max-width: 767px) 92vw, (max-width: 1100px) 76vw, 800px"
                format="avif"
                loading="lazy"
                fetchpriority="high"
                data-preview-theme={src === managerLight ? 'light' : 'dark'}
                alt="Atlas Manager Home with options to create an Atlas ISO or install Atlas on this PC."
                class="block h-auto w-full"
              />
            ))}
          </a>
        </div>
      </div>
    </div>
  </HeroBackdrop>
  <section class="press" aria-labelledby="press-heading" data-animate>
    <h2 id="press-heading" class="press-heading">
      Featured in
    </h2>
    <div class="press-logos">
      <a
        href="https://www.techspot.com/news/97095-check-out-AtlasOS-redesigned-windows-10-version-gamers.html"
        target="_blank"
        rel="noopener noreferrer"
        class="press-logo"
      >
        <Image
          src={TechSpotLogomark}
          alt="TechSpot"
          width={158}
          height={48}
          layout="constrained"
          draggable={false}
          class="max-h-8 w-auto select-none"
          loading="eager"
          decoding="async"
        />
      </a>
      <a href="https://www.pcguide.com/software/AtlasOS/" target="_blank" rel="noopener noreferrer" class="press-logo">
        <Image
          src={PcGuideLogomark}
          alt="PC Guide"
          width={158}
          height={48}
          layout="constrained"
          draggable={false}
          class="max-h-8 w-auto select-none"
          loading="lazy"
          decoding="async"
        />
      </a>
      <a
        href="https://www.wepc.com/tips/is-atlas-os-worth-it/"
        target="_blank"
        rel="noopener noreferrer"
        class="press-logo"
      >
        <Image
          src={WePCLogomark}
          alt="WePC"
          width={158}
          height={48}
          layout="constrained"
          draggable={false}
          class="max-h-8 w-auto select-none"
          loading="lazy"
          decoding="async"
        />
      </a>
      <a href="https://news.itsfoss.com/atlas-os/" target="_blank" rel="noopener noreferrer" class="press-logo">
        <Image
          src={ItsFOSSLogomark}
          alt="It's FOSS"
          width={158}
          height={48}
          layout="constrained"
          draggable={false}
          class="max-h-8 w-auto select-none"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </section>
</section>

<style>
  /*
   * The count: an open line, no capsule. The flag is the summit's own, in Atlas blue on a pole of
   * ink; the number stands out in full ink and tabular figures, so the live count doesn't jitter.
   */
  .hero-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-block-end: 1.25rem;
    color: var(--summit-text-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .hero-stat__flag {
    width: 0.9rem;
    height: 1.05rem;
    flex: none;
    overflow: visible;
  }
  .hero-stat__pole {
    fill: color-mix(in oklch, var(--color-fg) 55%, transparent);
  }
  .hero-stat__count {
    color: var(--summit-text);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  [data-home-hero] {
    /* The Atlas Manager window's width: the summit stage is measured in it, and the press row below rises into its fade. */
    --window-w: min((min(100vw, 80rem) - 8rem) * 0.76, 800px);
    --motion-reveal-duration: 700ms;
    --motion-reveal-step: 110ms;
    --motion-reveal-distance: 24px;
    --motion-reveal-blur: 6px;
    --motion-reveal-scale-start: 0.98;
    /* The headline and the sky above it grow with the screen. */
    --hero-title-size: clamp(2.25rem, 1.4141rem + 3.429vw, 4.5rem);
    --hero-title-leading: clamp(2.5rem, 1.757rem + 3.048vw, 4.5rem);
    --hero-copy-top: clamp(3.5rem, 2.757rem + 3.048vw, 5.5rem);
  }

  /* The copy sits in the sky above the stage. */
  .hero-copy {
    position: relative;
    z-index: 1;
    padding-block-start: var(--hero-copy-top);
  }
  .hero-title {
    font-size: var(--hero-title-size);
    line-height: var(--hero-title-leading);
  }

  /*
   * The stage: the window stands in the Atlas range (SummitStage). The bottom padding leaves room
   * for the fog under the window and the long fade into the page: 35% of the window's width.
   * `--window-w` comes from HeroBackdrop.
   */
  .manager-stage {
    position: relative;
    padding-block: clamp(2rem, 5.3svh, 3rem) calc(var(--window-w) * 0.35);
    padding-inline: 2rem;
    isolation: isolate;
  }
  .manager-window {
    position: relative;
    width: min(76%, 800px);
    margin-block: 0;
    margin-inline: auto;
    container-type: inline-size;
  }
  /* The window's shadow, at rest and lifted (styles/daylight.css softens both by day). */
  .manager-preview {
    --window-glow: oklch(0.644 0.166 257.7);
    --window-shadow:
      0 24px 60px color-mix(in oklch, var(--summit-shadow) 55%, transparent),
      0 0 90px color-mix(in oklch, var(--window-glow) 14%, transparent);
    --window-shadow-lifted:
      0 30px 70px color-mix(in oklch, var(--summit-shadow) 62%, transparent),
      0 0 90px color-mix(in oklch, var(--window-glow) 14%, transparent);
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    overflow: clip;
    border-radius: 0.65rem;
    box-shadow: var(--window-shadow);
    transition: box-shadow 400ms var(--motion-ease-out);
  }
  /* Pointing at the window only lets its shadow fall a little deeper. The window itself stays put. */
  @media (hover: hover) and (pointer: fine) {
    .manager-preview:hover {
      opacity: 1;
      box-shadow: var(--window-shadow-lifted);
    }
  }
  .manager-preview:focus-visible {
    opacity: 1;
    box-shadow: var(--window-shadow-lifted);
    outline: 2px solid var(--summit-blue);
    outline-offset: 6px;
  }
  :global(html:not([data-theme='light'])) [data-preview-theme='light'],
  :global(html[data-theme='light']) [data-preview-theme='dark'] {
    display: none;
  }

  /*
   * The pennant: the summit flag's cloth (Atlas blue, moonlit along its left edge) hung over the
   * window's top edge in the empty stretch of its title bar, clear of the window's buttons. The
   * darker strip above the edge is the cloth folding over from behind. It's sized in the window's
   * width (cqw), so it sits in the same spot at every size, and lets clicks through to the window.
   */
  .manager-pennant {
    --pennant-w: clamp(2.25rem, 5.6cqw, 2.75rem);
    position: absolute;
    z-index: 2;
    /* The fold (the top 6.4 of the shape's 52) sits above the window's edge. */
    inset-block-start: calc(var(--pennant-w) * -6.4 / 44);
    inset-inline-end: 30cqw;
    margin: 0;
    pointer-events: none;
    filter: drop-shadow(0 5px 8px color-mix(in oklch, var(--summit-shadow) 45%, transparent));
  }
  /*
   * The cloth is drawn as a shape rather than clipped out of a box: a clip is painted as a separate
   * mask that Chrome doesn't redraw while the cloth scales, so its edges would go blocky in the drop.
   */
  .manager-pennant__cloth {
    position: relative;
    display: block;
    width: var(--pennant-w);
    aspect-ratio: 44 / 52;
    transform-origin: 50% 0;
  }
  .manager-pennant__cloth svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .manager-pennant__label {
    position: absolute;
    inset-block-start: 29.5%;
    inset-inline: 0;
    color: white;
    font-size: clamp(0.6875rem, 1.5cqw, 0.75rem);
    font-weight: 600;
    line-height: 1;
    text-align: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* It drops into place once the stage has arrived, before the summit flag unfurls. */
    :global(html[data-motion]) .manager-pennant__cloth {
      animation: pennant-drop 700ms cubic-bezier(0.23, 1, 0.32, 1) 1500ms backwards paused;
    }
    :global(html[data-motion] [data-summit-play]) .manager-pennant__cloth {
      animation-play-state: running;
    }
  }
  @keyframes pennant-drop {
    from {
      opacity: 0;
      transform: scaleY(0.2);
    }
    40% {
      opacity: 1;
    }
  }

  /* Short desktop screens: tighten the spacing so the top of the window shows. */
  @media (min-width: 768px) and (max-height: 820px) {
    .hero-copy {
      padding-block: 3rem 1.5rem;
    }
    .manager-stage {
      padding-block-start: 1.5rem;
    }
  }

  /*
   * Press coverage rises into the stage's fade, just below the fog, instead of waiting until the
   * fade has finished: the stage reserves 35% of the window's width below it, and the fog has cleared by about 18%.
   */
  .press {
    position: relative;
    z-index: 1;
    margin-block-start: calc(var(--window-w) * -0.17);
    padding-block: 0;
    padding-inline: 1rem;
    text-align: center;
  }
  .press-heading {
    margin-block-end: 1.25rem;
    color: var(--summit-haze);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .press-logos {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: 3.5rem;
  }
  /*
   * The publications' marks in moonlight rather than their own greys: pale silhouettes, brightest at
   * the top where the moon catches them, like the headings' light.
   */
  .press-logo :global(img) {
    filter: brightness(0) invert(1);
    opacity: 0.42;
    mask-image: linear-gradient(to bottom, black 25%, color-mix(in oklch, black 60%, transparent));
    transition: opacity 200ms var(--motion-ease-out);
  }
  .press-logo {
    position: relative;
    display: inline-flex;
    min-height: 2.5rem;
    flex-shrink: 0;
    align-items: center;
    transition: opacity 200ms var(--motion-ease-out);
  }
  /* The marks are 2rem tall in 2.5rem boxes; the target round each is at least 44px tall. */
  .press-logo::after {
    content: '';
    position: absolute;
    inset: min(0px, (100% - 44px) / 2);
  }
  @media (hover: hover) and (pointer: fine) {
    .press-logo:hover {
      opacity: 1;
    }
    .press-logo:hover :global(img) {
      opacity: 0.8;
    }
  }
  .press-logo:active {
    scale: 0.96;
  }
  @media (prefers-reduced-motion: no-preference) {
    .press-logo {
      transition:
        opacity 200ms var(--motion-ease-out),
        scale 200ms var(--motion-ease-out);
    }
  }
  .press-logo:focus-visible {
    outline: 2px solid var(--summit-blue);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .press-logos {
      gap: 2.25rem;
    }
  }

  @media (max-width: 767px) {
    [data-home-hero] {
      --window-w: calc(100vw - 2.75rem);
    }
    .press-logos {
      display: grid;
      grid-template-columns: repeat(2, auto);
      justify-content: center;
      justify-items: center;
      gap: 1.25rem 2.5rem;
    }
    .manager-stage {
      padding-block: 2rem calc(var(--window-w) * 0.35);
      padding-inline: 0.375rem;
    }
    .manager-window {
      width: 100%;
    }
    .manager-preview {
      border-radius: 0.375rem;
    }
  }
</style>

<script>
  import { ATLAS_API_URL, ATLAS_GITHUB_LATEST_RELEASE_API_URL } from '@/constants';
  import { releaseLabel, type GitHubRelease } from '@/utils/latest-release';
  import { isLocalhost, onPageLoad } from '@/utils/page-lifecycle';

  const FALLBACK_DOWNLOAD_COUNT = '2,000,000';

  async function updateLatestRelease(signal: AbortSignal): Promise<void> {
    try {
      const response = await fetch(ATLAS_GITHUB_LATEST_RELEASE_API_URL, { signal });
      if (!response.ok) return;
      const release = (await response.json()) as GitHubRelease;

      const paragraph = document.getElementById('atlas-release');
      const text = releaseLabel(release);
      if (paragraph && text) {
        const label = document.createElement('span');
        label.className = 'font-semibold text-fg';
        label.textContent = text;
        paragraph.replaceChildren('The latest version is ', label);
      }
    } catch {
      // Keep the release label rendered at build time.
    }
  }

  function countDownloads(signal: AbortSignal): void {
    const button = document.getElementById('manager-download-btn');
    if (!(button instanceof HTMLAnchorElement) || isLocalhost()) return;

    button.addEventListener(
      'click',
      () => {
        fetch(`${ATLAS_API_URL}atlas/increment`, { method: 'POST', keepalive: true }).catch((error: unknown) => {
          console.warn('Failed to increment Atlas download count.', error);
        });
      },
      { signal }
    );
  }

  async function updateDownloadCount(signal: AbortSignal): Promise<void> {
    const element = document.getElementById('hero-download-count');
    if (!element) return;

    if (isLocalhost()) {
      element.textContent = FALLBACK_DOWNLOAD_COUNT;
      return;
    }

    try {
      const response = await fetch(ATLAS_API_URL, { signal });
      if (!response.ok) throw new Error(`API request failed with status ${response.status}`);
      const data = (await response.json()) as Array<{ version: string; count: number }>;
      const count = data.find((item) => item.version === 'atlas')?.count;
      element.textContent = count == null ? 'N/A' : count.toLocaleString('en-US');
    } catch {
      if (!signal.aborted) element.textContent = FALLBACK_DOWNLOAD_COUNT;
    }
  }

  onPageLoad((signal) => {
    void updateLatestRelease(signal);
    void updateDownloadCount(signal);
    countDownloads(signal);
  });
</script>
