---
import { DEFAULT_META_DESCRIPTION, SITE_NAME, SITE_URL, SOCIAL_LINKS } from '@/constants';

interface Props {
  title: string;
  description?: string;
  metaDescription?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  /** Emit a SoftwareApplication entity; only meaningful on the homepage. */
  softwareApp?: boolean;
}

const { title, description, metaDescription, image, canonicalURL, type = 'website', softwareApp = false } = Astro.props;

const site = Astro.site ?? new URL(SITE_URL);
const siteBase = site.href.replace(/\/$/, '');
const fullTitle = title.includes('|') ? title : `${title} | ${SITE_NAME}`;
const pageURL = canonicalURL ?? new URL(Astro.url.pathname, site).href;
const ogImage = image ?? `${siteBase}/defaultimg.png`;
const finalDescription = metaDescription ?? description ?? DEFAULT_META_DESCRIPTION;

// One JSON-LD graph per page; entities reference each other by `@id` instead of being repeated.
const organizationId = `${siteBase}/#organization`;
const websiteId = `${siteBase}/#website`;

const graph: Array<Record<string, unknown>> = [
  {
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE_NAME,
    url: siteBase,
    logo: { '@type': 'ImageObject', url: `${siteBase}/favicon.svg` },
    sameAs: Object.values(SOCIAL_LINKS),
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    name: SITE_NAME,
    url: siteBase,
    publisher: { '@id': organizationId },
  },
  {
    '@type': type === 'article' ? 'TechArticle' : 'WebPage',
    '@id': pageURL,
    url: pageURL,
    name: title,
    headline: title,
    description: finalDescription,
    image: ogImage,
    isPartOf: { '@id': websiteId },
    publisher: { '@id': organizationId },
  },
];

if (softwareApp) {
  graph.push({
    '@type': 'SoftwareApplication',
    name: SITE_NAME,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Windows',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': organizationId },
    url: siteBase,
    description: finalDescription,
  });
}

const structuredData = { '@context': 'https://schema.org', '@graph': graph };
---

<title>{fullTitle}</title>
<meta name="description" content={finalDescription} />
<link rel="canonical" href={pageURL} />

<meta property="og:type" content={type} />
<meta property="og:url" content={pageURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={finalDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={finalDescription} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@atlasos" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={finalDescription} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
