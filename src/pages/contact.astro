---
import { CONTACT_EMAIL } from '@/constants';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
---

<DefaultLayout
  title="Contact | AtlasOS"
  description="Get in touch with the AtlasOS team via email, Discord, or GitHub Discussions."
>
  <section class="content-grid content-grid--reading mbs-16">
    <h1 class="mbe-6 text-(length:--text-page-title) leading-(--leading-page-title) font-semibold tracking-tight text-fg">
      Contact AtlasOS
    </h1>
    <p class="mbe-4 leading-relaxed text-fg/75">
      Need help, want to contribute, or have partnership questions? Reach out through one of the channels below.
    </p>
    <ul class="space-y-3 text-fg/80">
      <li>
        Email:{' '}
        <a class="text-primary hover:underline" href={`mailto:${CONTACT_EMAIL}`}>
          {CONTACT_EMAIL}
        </a>
      </li>
      <li>
        Discord:{' '}
        <a
          class="text-primary hover:underline"
          href="https://discord.com/invite/atlasos"
          target="_blank"
          rel="noopener noreferrer"
        >
          Join the AtlasOS server
        </a>
      </li>
      <li>
        GitHub Discussions:{' '}
        <a
          class="text-primary hover:underline"
          href="https://github.com/orgs/Atlas-OS/discussions"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ask the community
        </a>
      </li>
    </ul>
  </section>
</DefaultLayout>
