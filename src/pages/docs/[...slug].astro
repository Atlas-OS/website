---
import { SITE_URL } from '@/constants';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { getSlugFromEntry } from '@/utils/navigation';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs', entry => !entry.data.draft);

  const paths = docs
    .map(entry => {
      const slug = getSlugFromEntry(entry);

      if (slug === '/docs/' || slug === '/docs') {
        return null;
      }

      const paramsSlug = slug
        .replace(/^\/docs\/?/, '')
        .replace(/^\/+/, '')
        .replace(/\/+$/, '');

      return {
        params: { slug: paramsSlug },
        props: { entry },
      };
    })
    .filter((path): path is NonNullable<typeof path> => path !== null);

  return paths;
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const slug = getSlugFromEntry(entry);

// Calculate OG image URL - matches the og-image.png.ts endpoint path
const site = Astro.site || SITE_URL;
const slugWithSlash = slug.endsWith('/') ? slug : `${slug}/`;
const ogImageUrl = new URL(`${slugWithSlash}og-image.png`, site).href;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  metaDescription={entry.data.metaDescription}
  currentSlug={slug}
  headings={headings}
  ogImage={ogImageUrl}
  type="article"
>
  <Content />
</DocsLayout>
