---
import { SITE_URL } from '@/constants';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { getDocsRouteParam, getPublishedDocs, type DocsEntry } from '@/utils/docs-content';
import { getSlugFromEntry } from '@/utils/navigation';
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';

export const getStaticPaths = (async () => {
  const docs = await getPublishedDocs();

  return docs.flatMap((entry) => {
    const paramsSlug = getDocsRouteParam(entry);
    if (!paramsSlug) return [];

    return {
      params: { slug: paramsSlug },
      props: { entry },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  entry: DocsEntry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const slug = getSlugFromEntry(entry);

// Calculate OG image URL - matches the og-image.png.ts endpoint path
const site = Astro.site || SITE_URL;
const slugWithSlash = slug.endsWith('/') ? slug : `${slug}/`;
const ogImageUrl = new URL(`${slugWithSlash}og-image.png`, site).href;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  metaDescription={entry.data.metaDescription}
  currentSlug={slug}
  headings={headings}
  ogImage={ogImageUrl}
  type="article"
>
  <Content />
</DocsLayout>
