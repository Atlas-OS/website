---
import { DEFAULT_OG_IMAGE } from '@/constants';
import { getPublishedDocsBySlug } from '@/utils/docs-content';
import { render } from 'astro:content';
import DocsLayout from '@/layouts/DocsLayout.astro';

const entry = (await getPublishedDocsBySlug()).get('/docs/');

if (!entry) {
  throw new Error('Home page not found. Expected a docs entry that resolves to /docs/.');
}

const { Content, headings } = await render(entry);

const ogImageUrl = DEFAULT_OG_IMAGE;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  currentSlug="/docs/"
  headings={headings}
  ogImage={ogImageUrl}
>
  <Content />
</DocsLayout>
