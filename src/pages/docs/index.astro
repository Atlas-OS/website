---
import { DEFAULT_OG_IMAGE } from '@/constants';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { DOCS_ROOT, getDocsIndex } from '@/utils/docs';
import { render } from 'astro:content';

const entry = (await getDocsIndex()).get(DOCS_ROOT);
if (!entry) {
  throw new Error('Docs home page not found. Expected src/content/docs/index.mdx.');
}

const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  metaDescription={entry.data.metaDescription}
  currentSlug={DOCS_ROOT}
  headings={headings}
  ogImage={DEFAULT_OG_IMAGE}
  landing
  showPageNav={false}
>
  <Content />
</DocsLayout>
