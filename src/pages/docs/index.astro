---
import { SITE_URL } from '@/constants';
import { getCollection, render } from 'astro:content';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { getSlugFromEntry } from '@/utils/navigation';

const allDocs = await getCollection('docs', doc => !doc.data.draft);
const entry = allDocs.find(doc => getSlugFromEntry(doc) === '/docs/');

if (!entry) {
  throw new Error('Home page not found. Expected a docs entry that resolves to /docs/.');
}

const { Content, headings } = await render(entry);

const site = Astro.site || SITE_URL;
const ogImageUrl = new URL('/docs/og-image.png', site).href;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  currentSlug="/docs/"
  headings={headings}
  ogImage={ogImageUrl}
>
  <Content />
</DocsLayout>
