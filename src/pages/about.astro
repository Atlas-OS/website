---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
---

<DefaultLayout
  title="About | AtlasOS"
  description="Learn about AtlasOS, a community-driven project focused on improving Windows performance, privacy, and usability."
>
  <section class="content-grid content-grid--reading mbs-16">
    <h1 class="mbe-6 text-(length:--text-page-title) leading-(--leading-page-title) font-semibold tracking-tight text-fg">
      About AtlasOS
    </h1>
    <p class="mbe-4 leading-relaxed text-fg/75">
      AtlasOS is a community-driven project focused on improving Windows performance, privacy, and usability without
      removing core functionality.
    </p>
    <p class="mbe-4 leading-relaxed text-fg/75">
      The project is open source, transparent, and maintained by contributors who test and document every major change.
    </p>
    <p class="leading-relaxed text-fg/75">
      Learn more in our{' '}
      <a class="text-primary hover:underline" href="/docs/">
        documentation
      </a>{' '}
      or contribute on
      <a
        class="text-primary hover:underline"
        href="https://github.com/Atlas-OS/Atlas"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      .
    </p>
  </section>
</DefaultLayout>
