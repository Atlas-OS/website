---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
---

<DefaultLayout>
  <section class="mx-auto mt-16 max-w-4xl px-4">
    <h1 class="mb-6 text-4xl font-semibold tracking-tight text-white md:text-5xl">About AtlasOS</h1>
    <p class="mb-4 leading-relaxed text-white/75">
      AtlasOS is a community-driven project focused on improving Windows performance, privacy, and usability without
      removing core functionality.
    </p>
    <p class="mb-4 leading-relaxed text-white/75">
      The project is open source, transparent, and maintained by contributors who test and document every major change.
    </p>
    <p class="leading-relaxed text-white/75">
      Learn more in our <a class="text-primary hover:underline" href="/docs/">documentation</a> or contribute on
      <a class="text-primary hover:underline" href="https://github.com/Atlas-OS/Atlas" target="_blank" rel="noopener noreferrer">GitHub</a>.
    </p>
  </section>
</DefaultLayout>
