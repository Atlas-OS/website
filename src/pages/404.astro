---
import Footer from '@/components/layout/Footer.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Button from '@/components/ui/Button.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const currentPath = '/404/';
---

<BaseLayout currentPath={currentPath}>
  <Fragment slot="head">
    <title>Page Not Found | AtlasOS</title>
    <meta name="description" content="The page you're looking for doesn't exist." />
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <Fragment slot="body">
    <div class="flex min-h-dvh flex-col">
      <header>
        <a href="#main-content" class="sr-only focus:not-sr-only">
          Skip to main content
        </a>
        <Navbar currentPath={currentPath} isDocsPage={false} />
      </header>
      <main
        id="main-content"
        class="error-main relative flex flex-1 items-center justify-center px-6 py-20 text-center"
      >
        <div class="relative mx-auto w-full max-w-xl">
          <p class="mb-5 text-sm font-semibold tracking-[0.16em] text-primary">ERROR 404</p>
          <h1 class="mb-5 text-4xl font-semibold tracking-tight text-white md:text-5xl">Page not found.</h1>
          <p class="mx-auto mb-8 max-w-md leading-relaxed text-white/70">
            This page may have moved, or the link may be incorrect. Head home or explore the docs to find your way.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-4">
            <Button variant="primary" size="lg" href="/" icon="tabler:home" iconPosition="before">
              Back to home
            </Button>
            <Button variant="secondary" size="lg" href="/docs/" icon="tabler:book" iconPosition="before">
              Documentation
            </Button>
          </div>
        </div>
      </main>
      <div class="error-footer w-full">
        <Footer />
      </div>
    </div>
  </Fragment>
</BaseLayout>

<style>
  .error-main {
    min-height: 32rem;
    background: radial-gradient(ellipse 40% 50% at 50% 45%, rgb(25 144 254 / 0.045), transparent);
  }

  .error-footer :global(> section) {
    width: 100%;
    margin-top: 0;
  }

  @media (max-width: 640px) {
    .error-main {
      min-height: 28rem;
    }
  }
</style>
