---
import SectionSeparator from '@/components/sections/common/SectionSeparator.astro';
import Benchmarks from '@/components/sections/Benchmarks.astro';
import FAQ from '@/components/sections/FAQ.astro';
import Features from '@/components/sections/Features.astro';
import Hero from '@/components/sections/Hero.astro';
import JoinCommunity from '@/components/sections/JoinCommunity.astro';
import LinusTechTips from '@/components/sections/LinusTechTips.astro';
import OpenSource from '@/components/sections/OpenSource.astro';
import ProTestimonials from '@/components/sections/ProTestimonials.astro';
import Reviews from '@/components/sections/Reviews.astro';
import WhyAtlas from '@/components/sections/WhyAtlas.astro';
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const sections = [
  Hero,
  Features,
  WhyAtlas,
  Benchmarks,
  ProTestimonials,
  Reviews,
  LinusTechTips,
  OpenSource,
  FAQ,
  JoinCommunity,
];
---

<DefaultLayout>
  <div class="homepage-motion">
    {
      sections.map((Section, index) => (
        <>
          <Section />
          {index < sections.length - 1 && (
            <div data-animate>
              <SectionSeparator />
            </div>
          )}
        </>
      ))
    }
  </div>
</DefaultLayout>

<style>
  .homepage-motion {
    --motion-reveal-duration: 520ms;
    --motion-reveal-step: 140ms;
    --motion-reveal-distance: 28px;
    --motion-reveal-blur: 6px;
    --motion-reveal-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --motion-reveal-scale-start: 0.985;
  }
</style>

<script>
  import { initScrollAnimations } from '@/utils/scroll-animations';

  document.addEventListener('astro:page-load', initScrollAnimations);
</script>
