---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
---

<DefaultLayout>
  <section class="mx-auto mt-16 max-w-4xl px-4">
    <h1 class="mb-6 text-4xl font-semibold tracking-tight text-white md:text-5xl">Privacy Policy</h1>
    <p class="mb-4 leading-relaxed text-white/75">
      AtlasOS values user privacy. We keep data collection minimal and prioritize transparent, community-reviewable
      tooling.
    </p>
    <p class="mb-4 leading-relaxed text-white/75">
      This website may process limited operational data for analytics and service reliability. We do not sell personal
      data.
    </p>
    <p class="leading-relaxed text-white/75">
      For privacy questions, contact
      <a class="text-primary hover:underline" href="mailto:contact@atlasos.net">contact@atlasos.net</a>.
    </p>
  </section>
</DefaultLayout>
