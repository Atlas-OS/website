---
import SEO from '@/components/core/SEO.astro';
import Footer from '@/components/layout/Footer.astro';
import Navbar from '@/components/layout/Navbar.astro';
import { DEFAULT_OG_IMAGE, SITE_URL } from '@/constants';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AtlasOS | Optimized Windows for enthusiasts',
  description = 'AtlasOS is an optimized Windows experience for enthusiasts and gamers, with stronger performance, better privacy, and cleaner defaults.',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<BaseLayout currentPath={currentPath}>
  <Fragment slot="head">
    <SEO
      title={title}
      description={description}
      image={DEFAULT_OG_IMAGE}
      canonicalURL={new URL(currentPath, Astro.site ?? SITE_URL).href}
      type="website"
      softwareApp={currentPath === '/'}
    />
    <meta name="author" content="AtlasOS Community" />
    <meta name="format-detection" content="telephone=no" />
  </Fragment>

  <Fragment slot="body">
    <header>
      <a href="#main-content" class="sr-only focus:not-sr-only">
        Skip to main content
      </a>
      <Navbar currentPath={currentPath} isDocsPage={false} />
    </header>
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </Fragment>
</BaseLayout>
