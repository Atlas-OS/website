---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

interface Props {
  currentPath?: string;
}

const kapaLogoUrl = 'https://avatars.githubusercontent.com/u/78708182?s=128';
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <ClientRouter />
    <Font cssVariable="--font-sans-source" preload />
    <Font cssVariable="--font-display-source" preload />
    <Font cssVariable="--font-mono-source" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ready');
      }
    </script>

    <!-- Resource Hints - Preconnect for critical third-party domains -->
    <link rel="preconnect" href="https://pla.atlasos.net" crossorigin />
    <link rel="preconnect" href="https://api.atlasos.net" crossorigin />
    <link rel="preconnect" href="https://widget.kapa.ai" crossorigin />
    <link rel="dns-prefetch" href="https://pla.atlasos.net" />
    <link rel="dns-prefetch" href="https://api.atlasos.net" />
    <link rel="dns-prefetch" href="https://widget.kapa.ai" />

    <script
      is:inline
      async
      src="https://widget.kapa.ai/kapa-widget.bundle.js"
      data-website-id="d6dd374d-575e-4d3a-9462-00878d18f937"
      data-project-name="AtlasOS"
      data-modal-title="AtlasOS AI"
      data-project-color="#2894F3"
      data-project-logo={kapaLogoUrl}
      data-modal-image={kapaLogoUrl}
      data-button-image={kapaLogoUrl}
      data-modal-example-questions-col-span="12"
    ></script>

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="AtlasOS" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- SEO Slot - DefaultLayout and DocsLayout provides the SEO component here -->
    <slot name="head" />

  </head>
  <body class="overflow-x-hidden">
    <slot name="body" />
    <slot />
    <!-- Partytown -->
    <script is:inline type="text/partytown" src="https://pla.atlasos.net/js/script.js" data-domain="atlasos.net"
    ></script>
  </body>
</html>

<style>
  html {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
