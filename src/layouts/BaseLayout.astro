---
import ManagerPreview from '@/components/sections/hero/ManagerPreview.astro';
import KapaWidget from '@/components/ui/KapaWidget.astro';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';

interface Props {
  currentPath?: string;
}

const isHomePage = Astro.props.currentPath === '/';
const isDocsPage = Astro.props.currentPath?.startsWith('/docs/') ?? false;
---

<!doctype html>
<html lang="en-US" transition:name="root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--
      The theme, before anything paints: the visitor's choice (utils/theme.ts), else their system
      setting, else night. The ClientRouter replaces <html>'s attributes on navigation, so carry it over.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        root.dataset.theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        if (window.__atlasThemeCarried) return;
        window.__atlasThemeCarried = true;
        document.addEventListener('astro:before-swap', (event) => {
          event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme;
        });
      })();
    </script>
    {isHomePage && <ManagerPreview preload />}
    <ClientRouter fallback="swap" />
    <Font cssVariable="--font-sans-source" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-display-source" preload={[{ weight: 600, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-mono-source" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#1990fe" />

    <!-- Reveal animations only hide content once JavaScript has committed to running them. -->
    <script is:inline data-astro-rerun>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.dataset.motion = '';
    </script>
    <!-- Only warm the API connection on the route that needs it during initial rendering. -->
    {isHomePage && <link rel="preconnect" href="https://api.atlasos.net" crossorigin />}
    <!--
      Plausible runs once per visit: the ClientRouter skips scripts it has already executed, and
      Plausible's own history hook records each client-side navigation as a pageview.
    -->
    <script is:inline defer data-domain="atlasos.net" src="https://pla.atlasos.net/js/script.js"></script>

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="AtlasOS" />
    <link rel="manifest" href="/site.webmanifest" />

    <slot name="head" />
  </head>
  <body class:list={['overflow-x-clip', { 'docs-page': isDocsPage }]}>
    <slot name="body" />
    <slot />
    <KapaWidget />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }

  html {
    height: 100%;
  }

  body {
    min-height: 100%;
  }
</style>

<style is:global>
  :root {
    /*
     * The gap between the screen's edge and what's pinned to it (the navbar's contents, the Ask AI
     * button): 16px on a phone (390px) growing to 24px on a desktop (1440px).
     */
    --space-page-edge: clamp(1rem, 0.8142rem + 0.762vw, 1.5rem);
  }
</style>
