---
import SEO from '@/components/core/SEO.astro';
import Breadcrumbs from '@/components/docs/Breadcrumbs.astro';
import PageActions from '@/components/docs/PageActions.astro';
import PageNav from '@/components/docs/PageNav.astro';
import TableOfContents from '@/components/docs/TableOfContents.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Sidebar from '@/components/layout/Sidebar.astro';
import Spotlight from '@/components/ui/Spotlight.astro';
import { SITE_URL } from '@/constants';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDocsIndex, getDocsPagination, normalizeDocsPath } from '@/utils/docs';
import { docsMarkdownUrl } from '@/utils/docs-markdown';
import type { MarkdownHeading } from 'astro';
import '@/styles/prose.css';

interface Props {
  title: string;
  description?: string;
  metaDescription?: string;
  currentSlug: string;
  headings?: MarkdownHeading[];
  ogImage?: string;
  type?: 'website' | 'article';
  showPageNav?: boolean;
  landing?: boolean;
}

const {
  title,
  description,
  metaDescription,
  currentSlug,
  headings = [],
  ogImage,
  type,
  showPageNav = true,
  landing = false,
} = Astro.props;

const currentPath = normalizeDocsPath(currentSlug);
const site = Astro.site ?? SITE_URL;
const entry = (await getDocsIndex()).get(currentPath);
const editUrl = entry?.filePath
  ? `https://github.com/Atlas-OS/website/edit/main/${entry.filePath.replace(/\\/g, '/')}`
  : null;
const markdownUrl = entry ? docsMarkdownUrl(entry, site) : null;
const { prev, next } = showPageNav ? await getDocsPagination(currentPath) : { prev: null, next: null };
---

<BaseLayout currentPath={currentPath}>
  <Fragment slot="head">
    <SEO
      title={title}
      description={description}
      metaDescription={metaDescription}
      image={ogImage}
      canonicalURL={new URL(currentPath, Astro.site ?? SITE_URL).href}
      type={type}
    />
  </Fragment>

  <Fragment slot="body">
    <a href="#main-content" class="skip-link" data-pagefind-ignore>
      Skip to main content
    </a>
    <Navbar currentPath={currentPath} isDocsPage={true} />
    <div class:list={['docs-shell relative z-10', { 'docs-shell--landing': landing }]}>
      <Sidebar currentSlug={currentPath} />
      <main class="docs-main docs-main--with-sidebar scroll-pt-24" id="main-content" tabindex="-1">
        <div class="docs-main-inner">
          <article class="docs-article" data-pagefind-body>
            <Breadcrumbs currentSlug={currentPath} />
            <header class="docs-header">
              <h1 class="docs-title">{title}</h1>
            </header>
            {!landing && <TableOfContents headings={headings} variant="inline" />}
            <div class="docs-content prose max-w-none md:prose-lg">
              <slot />
            </div>
            {editUrl && markdownUrl && <PageActions editUrl={editUrl} markdownUrl={markdownUrl} />}
            {showPageNav && <PageNav prev={prev} next={next} />}
          </article>
          {!landing && <TableOfContents headings={headings} variant="sidebar" />}
        </div>
      </main>
    </div>
    <Spotlight />
  </Fragment>
</BaseLayout>

<script>
  import { enhanceProseCodeBlocks } from '@/utils/clipboard';
  import { onPageLoad } from '@/utils/page-lifecycle';
  import { initScrollAnimations } from '@/utils/scroll-animations';

  onPageLoad((signal) => {
    initScrollAnimations(signal);
    enhanceProseCodeBlocks(document, signal);
  });
</script>

<style>
  .docs-shell {
    --docs-header-height: 3.5rem;
    --docs-sidebar-width: 18rem;
    --docs-toc-width: 16rem;
    --docs-article-width: 44rem;
    min-height: calc(100vh - var(--docs-header-height));
  }

  .docs-main {
    min-height: calc(100vh - var(--docs-header-height));
    overflow-x: clip;
    overflow-anchor: none;
    scroll-behavior: smooth;
    padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 2.5vw, 2rem) clamp(2rem, 4vw, 3rem);
  }

  /*
   * Article and table of contents travel together as one centred unit, so they never drift
   * apart on wide screens. The TOC column is always reserved from the xl breakpoint so the
   * article does not shift between pages with and without headings.
   */
  .docs-main-inner {
    display: grid;
    grid-template-columns: minmax(0, var(--docs-article-width));
    justify-content: center;
    column-gap: clamp(2.5rem, 4vw, 4rem);
  }

  .docs-article {
    min-width: 0;
    padding-inline: clamp(0.125rem, 1vw, 0.5rem);
  }

  .docs-header {
    margin-bottom: 1.5rem;
  }

  .docs-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 1vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: white;
    text-wrap: balance;
  }

  .docs-content {
    margin: -2px -4px -6px;
    padding: 2px 4px 6px;
  }

  @media (min-width: 1024px) {
    .docs-main--with-sidebar {
      padding-left: calc(var(--docs-sidebar-width) + 1.5rem);
    }
  }

  @media (min-width: 1280px) {
    .docs-main-inner {
      grid-template-columns: minmax(0, var(--docs-article-width)) var(--docs-toc-width);
    }
  }

  @media (max-width: 639px) {
    .docs-main {
      padding-inline: 1rem;
      padding-top: 1.25rem;
    }

    .docs-article {
      padding-inline: 0;
    }
  }

  .docs-shell--landing .docs-main-inner {
    grid-template-columns: minmax(0, 56rem);
  }

  .docs-shell--landing .docs-header {
    margin-bottom: 1rem;
  }
</style>
