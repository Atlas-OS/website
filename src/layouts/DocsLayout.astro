---
import SEO from '@/components/core/SEO.astro';
import Breadcrumbs from '@/components/docs/Breadcrumbs.astro';
import PageActions from '@/components/docs/PageActions.astro';
import PageNav from '@/components/docs/PageNav.astro';
import TableOfContents from '@/components/docs/TableOfContents.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Sidebar from '@/components/layout/Sidebar.astro';
import Spotlight from '@/components/ui/Spotlight.astro';
import { SITE_URL } from '@/constants';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDocsIndex, getDocsPagination, normalizeDocsPath } from '@/utils/docs';
import { docsMarkdownUrl } from '@/utils/docs-markdown';
import type { MarkdownHeading } from 'astro';
import '@/styles/prose.css';

interface Props {
  title: string;
  description?: string;
  metaDescription?: string;
  currentSlug: string;
  headings?: MarkdownHeading[];
  ogImage?: string;
  type?: 'website' | 'article';
  showPageNav?: boolean;
}

const {
  title,
  description,
  metaDescription,
  currentSlug,
  headings = [],
  ogImage,
  type,
  showPageNav = true,
} = Astro.props;

const currentPath = normalizeDocsPath(currentSlug);
const site = Astro.site ?? SITE_URL;
const entry = (await getDocsIndex()).get(currentPath);
const editUrl = entry?.filePath
  ? `https://github.com/Atlas-OS/website/edit/main/${entry.filePath.replace(/\\/g, '/')}`
  : null;
const markdownUrl = entry ? docsMarkdownUrl(entry, site) : null;
const hasTableOfContents = headings.some((heading) => heading.depth === 2 || heading.depth === 3);
const { prev, next } = showPageNav ? await getDocsPagination(currentPath) : { prev: null, next: null };
---

<BaseLayout currentPath={currentPath}>
  <Fragment slot="head">
    <SEO
      title={title}
      description={description}
      metaDescription={metaDescription}
      image={ogImage}
      canonicalURL={new URL(currentPath, Astro.site ?? SITE_URL).href}
      type={type}
    />
  </Fragment>

  <Fragment slot="body">
    <a href="#main-content" class="skip-link" data-pagefind-ignore>
      Skip to main content
    </a>
    <div class="fixed inset-0 -z-10 h-full w-full" aria-hidden="true">
      <div class="absolute h-full w-full bg-[linear-gradient(rgba(255,255,255,0.012)_1px,transparent_1px),linear-gradient(to_right,rgba(255,255,255,0.012)_1px,transparent_1px)] mask-[linear-gradient(to_bottom,rgba(0,0,0,0.6),transparent_70%)] bg-size-[24px_24px]"></div>
    </div>
    <Navbar currentPath={currentPath} isDocsPage={true} />
    <div class="docs-shell relative z-10">
      <Sidebar currentSlug={currentPath} />
      <main
        class:list={['docs-main scroll-pt-24 docs-main--with-sidebar', hasTableOfContents && 'docs-main--with-toc']}
        id="main-content"
        tabindex="-1"
      >
        <div class="docs-main-inner">
          <article class="docs-article" data-pagefind-body>
            <Breadcrumbs currentSlug={currentPath} />
            <header class="docs-header">
              <h1 class="docs-title">{title}</h1>
            </header>
            <TableOfContents headings={headings} variant="inline" />
            <div class="docs-content prose max-w-none md:prose-lg">
              <slot />
            </div>
            {editUrl && markdownUrl && <PageActions editUrl={editUrl} markdownUrl={markdownUrl} />}
            {showPageNav && <PageNav prev={prev} next={next} />}
          </article>
        </div>
      </main>
      <TableOfContents headings={headings} variant="sidebar" />
    </div>
    <Spotlight />
  </Fragment>
</BaseLayout>

<script>
  import { enhanceProseCodeBlocks } from '@/utils/clipboard';
  import { onPageLoad } from '@/utils/page-lifecycle';
  import { initScrollAnimations } from '@/utils/scroll-animations';

  onPageLoad((signal) => {
    initScrollAnimations(signal);
    enhanceProseCodeBlocks(document, signal);
  });
</script>

<style>
  .docs-shell {
    --docs-header-height: 3.5rem;
    --docs-sidebar-width: 18rem;
    --docs-toc-width: 18rem;
    --docs-toc-inset: clamp(1.5rem, calc((100vw - 96rem) / 2), 7rem);
    min-height: calc(100vh - var(--docs-header-height));
  }

  .docs-main {
    min-height: calc(100vh - var(--docs-header-height));
    overflow-x: clip;
    overflow-anchor: none;
    scroll-behavior: smooth;
    padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 2.5vw, 2rem) clamp(2rem, 4vw, 3rem);
  }

  .docs-main-inner {
    margin: 0 auto;
    width: min(100%, 76rem);
  }

  /* Caps body copy near 75 characters per line at the 16px reading size. */
  .docs-article {
    max-width: 44rem;
    padding-inline: clamp(0.125rem, 1vw, 0.5rem);
  }

  .docs-header {
    margin-bottom: 1.5rem;
  }

  .docs-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 1.5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: white;
    text-wrap: balance;
  }

  .docs-content {
    margin: -2px -4px -6px;
    padding: 2px 4px 6px;
  }

  @media (min-width: 1024px) {
    .docs-main--with-sidebar {
      padding-left: calc(var(--docs-sidebar-width) + 1.5rem);
    }
  }

  @media (min-width: 1280px) {
    .docs-main--with-toc {
      padding-right: calc(var(--docs-toc-width) + var(--docs-toc-inset) + 1.5rem);
    }
  }

  @media (max-width: 639px) {
    .docs-main {
      padding-inline: 1rem;
      padding-top: 1.25rem;
    }

    .docs-article {
      padding-inline: 0;
    }
  }
</style>
