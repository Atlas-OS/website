---
import { SITE_URL } from '@/constants';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Sidebar from '@/components/layout/Sidebar.astro';
import TableOfContents from '@/components/docs/TableOfContents.astro';
import Breadcrumbs from '@/components/docs/Breadcrumbs.astro';
import PageNav from '@/components/docs/PageNav.astro';
import SEO from '@/components/core/SEO.astro';
import Spotlight from '@/components/ui/Spotlight.astro';
import { getCollection } from 'astro:content';
import { getPrevNextPages } from '@/utils/navigation';
import '@/styles/prose.css';

interface Props {
  title: string;
  description?: string;
  metaDescription?: string;
  currentSlug: string;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  image?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  showPageNav?: boolean;
}

const {
  title,
  description,
  metaDescription,
  currentSlug,
  headings = [],
  image,
  ogImage,
  type,
  showPageNav = true,
} = Astro.props;

const hasTableOfContents = headings.length > 0;

const allDocs = await getCollection('docs');
const { prev, next } = getPrevNextPages(allDocs, currentSlug);
---

<BaseLayout currentPath={currentSlug}>
  <Fragment slot="head">
    <meta name="apple-mobile-web-app-title" content="AtlasOS Docs" />
    <SEO
      title={title}
      description={description}
      metaDescription={metaDescription}
      image={ogImage || image}
      canonicalURL={new URL(currentSlug, Astro.site || SITE_URL).href}
      type={type}
      currentSlug={currentSlug}
    />
  </Fragment>

  <Fragment slot="body">
    <a href="#main-content" class="skip-link" data-pagefind-ignore>Skip to main content</a>
    <div class="fixed inset-0 -z-10 h-full w-full" aria-hidden="true">
      <div
        class="absolute h-full w-full bg-[linear-gradient(rgba(255,255,255,0.012)_1px,transparent_1px),linear-gradient(to_right,rgba(255,255,255,0.012)_1px,transparent_1px)] mask-[linear-gradient(to_bottom,rgba(0,0,0,0.6),transparent_70%)] bg-size-[24px_24px]"
      />
    </div>
    <Navbar currentPath={currentSlug} isDocsPage={true} />
    <div
      class="docs-shell relative z-10"
      style="--docs-header-height: 3.5rem; --docs-sidebar-width: 18rem; --docs-toc-width: 18rem;"
    >
      <Sidebar currentSlug={currentSlug} />
      <main
        class={`docs-main scroll-pt-24 docs-main--with-sidebar ${hasTableOfContents ? 'docs-main--with-toc' : ''}`}
        id="main-content"
        tabindex="-1"
        style="overflow-anchor: none; scroll-behavior: smooth;"
      >
        <div class="docs-main-inner">
          <article class="docs-article">
            <Breadcrumbs currentSlug={currentSlug} />
            <div class="prose md:prose-lg max-w-none" data-pagefind-body>
              <slot />
            </div>
            {showPageNav && <PageNav prev={prev || undefined} next={next || undefined} />}
          </article>
        </div>
      </main>
      <TableOfContents headings={headings} />
    </div>
    <script>
      import { initCopyCodeButtons } from '@/utils/copy-code';
import { initScrollAnimations } from '@/utils/scroll-animations';

      function init() {
        initScrollAnimations();
        initCopyCodeButtons();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }

      document.addEventListener('astro:page-load', init);
    </script>
    <Spotlight />
  </Fragment>
</BaseLayout>

<style>
  .docs-shell {
    min-height: calc(100vh - var(--docs-header-height));
  }

  .docs-main {
    min-height: calc(100vh - var(--docs-header-height));
    overflow-x: clip;
    padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 2.5vw, 2rem) clamp(2rem, 4vw, 3rem);
  }


  .docs-main-inner {
    margin: 0 auto;
    width: min(100%, 76rem);
  }

  .docs-article {
    max-width: 56rem;
    padding-inline: clamp(0.125rem, 1vw, 0.5rem);
  }

  @media (min-width: 1024px) {
    .docs-main--with-sidebar {
      padding-left: calc(var(--docs-sidebar-width) + 1.5rem);
    }
  }

  @media (min-width: 1280px) {
    .docs-main--with-toc {
      padding-right: calc(var(--docs-toc-width) + 1.5rem);
    }
  }

  @media (max-width: 639px) {
    .docs-main {
      padding-inline: 1rem;
      padding-top: 1.25rem;
    }

    .docs-article {
      padding-inline: 0;
    }
  }
</style>
