{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atlasos-website",
  "main": "src/worker.ts",
  "compatibility_date": "2026-02-18",
  "compatibility_flags": ["nodejs_compat_v2"],
  "browser": {
    "binding": "BROWSER"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
