# Content-hashed build output: every deploy ships new filenames, so cache it forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# pagefind.js, its worker and wasm keep their filenames across Pagefind upgrades, so revalidate them.
/pagefind/*
  Cache-Control: public, max-age=0, must-revalidate

# Matching rules join Cache-Control values, so the hashed index chunks detach the header first.
/pagefind/fragment/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/pagefind/index/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/llms.txt
  Cache-Control: public, max-age=3600

/docs/*.md
  Cache-Control: public, max-age=3600

/docs/manifest.json
  Cache-Control: public, max-age=3600

# public/assets filenames are not hashed: replacing a screenshot must reach returning visitors.
/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline' https://www.youtube.com https://widget.kapa.ai https://pla.atlasos.net https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://api.atlasos.net https://api.github.com https://pla.atlasos.net https://cdn.jsdelivr.net https://download.ameliorated.io https://www.microsoft.com https://widget.kapa.ai https://*.kapa.ai https://proxy.kapa.ai https://kapa-widget-proxy-la7dkmplpq-uc.a.run.app https://metrics.kapa.ai https://www.google.com https://www.gstatic.com; font-src 'self' data: https://fonts.gstatic.com; worker-src 'self' blob:; frame-src 'self' https://www.youtube-nocookie.com https://www.google.com https://recaptcha.google.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
