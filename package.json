{
  "name": "website",
  "version": "1.0.0",
  "description": "AtlasOS website, created with love by the community.",
  "type": "module",
  "author": "AtlasOS",
  "license": "MIT",
  "contributors": ["AtlasOS Community <contact@atlasos.net>"],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.22.3"
  },
  "homepage": "https://atlasos.net/",
  "repository": {
    "type": "git",
    "url": "https://github.com/atlas-os/website.git"
  },
  "bugs": {
    "url": "https://github.com/atlas-os/website/issues"
  },
  "keywords": ["astro", "atlasos", "gaming", "optimized", "performance", "windows"],
  "browserslist": ["defaults", "not IE 11", "not dead"],
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "bun run types && astro check && tsc -p tsconfig.worker.json",
    "deploy": "bun run build && wrangler deploy",
    "deploy:ci": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "postinstall": "wrangler types",
    "preview": "astro preview",
    "types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/sitemap": "^3.7.4",
    "@cloudflare/puppeteer": "^1.4.0",
    "@iconify-json/tabler": "^1.2.38",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "astro-icon": "^1.2.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.2",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.1.2",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "lightningcss": "^1.33.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-astro-organize-imports": "^0.4.13",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "^4.133.0"
  }
}
