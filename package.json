{
  "name": "website",
  "version": "1.0.0",
  "description": "AtlasOS website, created with love by the community.",
  "type": "module",
  "author": "AtlasOS",
  "license": "MIT",
  "contributors": ["AtlasOS Community <contact@atlasos.net>"],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.12.0"
  },
  "homepage": "https://atlasos.net/",
  "repository": {
    "type": "git",
    "url": "https://github.com/atlas-os/website.git"
  },
  "bugs": {
    "url": "https://github.com/atlas-os/website/issues"
  },
  "keywords": ["astro", "atlasos", "gaming", "optimized", "performance", "windows"],
  "browserslist": ["defaults", "not IE 11", "not dead"],
  "scripts": {
    "astro": "astro",
    "build": "astro build && jampack ./dist && node ./scripts/postbuild-compress.mjs",
    "build:raw": "astro build",
    "check": "astro check",
    "compress:postbuild": "node ./scripts/postbuild-compress.mjs",
    "deploy": "bun run build && wrangler deploy",
    "deploy:ci": "wrangler deploy",
    "dev": "astro dev",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "astro preview",
    "search:index": "pagefind --site dist --output-subdir pagefind"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.0-beta.8",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/sitemap": "^3.7.0",
    "@iconify-json/tabler": "^1.2.26",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^6.0.0-beta.13",
    "astro-compressor": "^1.2.0",
    "astro-icon": "^1.1.5",
    "satori": "^0.19.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7-beta.1",
    "@divriots/jampack": "0.34.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "^1.3.9",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "astro-eslint-parser": "^1.3.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.6.0",
    "pagefind": "^1.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-astro-organize-imports": "^0.4.11",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript-eslint": "^8.56.0",
    "wrangler": "^4.66.0"
  }
}
