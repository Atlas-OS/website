{
  "name": "website",
  "version": "1.0.0",
  "description": "AtlasOS website, created with love by the community.",
  "type": "module",
  "author": "AtlasOS",
  "license": "CC-BY-NC-ND-4.0",
  "contributors": ["AtlasOS Community <contact@atlasos.net>"],
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.23.4"
  },
  "homepage": "https://atlasos.net/",
  "repository": {
    "type": "git",
    "url": "https://github.com/atlas-os/website.git"
  },
  "bugs": {
    "url": "https://github.com/atlas-os/website/issues"
  },
  "keywords": ["astro", "atlasos", "gaming", "optimized", "performance", "windows"],
  "browserslist": ["defaults", "not IE 11", "not dead"],
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "bun run types && astro check && tsc -p tsconfig.worker.json && tsc -p test/worker/tsconfig.json",
    "deploy": "bun run build && wrangler deploy",
    "deploy:ci": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "astro sync && eslint .",
    "postinstall": "wrangler types",
    "preview": "astro preview",
    "test": "vitest run",
    "test:preview": "playwright test --config=test/browser/playwright.config.ts",
    "test:watch": "vitest",
    "types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "@cloudflare/puppeteer": "^2.0.1",
    "@iconify-json/tabler": "^1.2.46",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "astro-icon": "^1.2.0",
    "hast-util-from-html": "^2.1.0",
    "hast-util-to-mdast": "^10.1.4",
    "mdast-util-gfm-table": "^2.0.1",
    "mdast-util-to-markdown": "^2.2.4",
    "negotiator": "^1.1.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.5",
    "@types/hast": "^3.0.5",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.6.6",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "pagefind": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-astro-organize-imports": "^0.4.14",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
